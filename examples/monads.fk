// A monad as a spec: a type that takes a type, a way to wrap a value, and a way to chain a step
// that might stop. Options says its M is Option, so its M<Int> is an Option<Int>.

spec Monad {
  type M<A>
  pure<A>(x: A): M<A>
  bind<A, B>(m: M<A>, f: (A) -> M<B>): M<B>
}

module Options : Monad {
  type M<A> = Option<A>
  pure(x) = Some(x)
  bind(m, f) = when (m) {
    Some(x) -> f(x)
    None -> None
  }
}

// M can be a type that takes two, with one fixed: M<Int> is Result<Int, String>.
module Results : Monad {
  type M<A> = Result<A, String>
  pure(x) = Ok(x)
  bind(m, f) = when (m) {
    Ok(x) -> f(x)
    Error(e) -> Error(e)
  }
}

// Written once, for every monad. A module's name before a block runs the block in it: each
// `x by m` takes the value out of m, or stops the block the way M's bind stops, and the block's
// last line goes back in with M's pure.
module MonadOps(M: Monad) {
  map<A, B>(m: M.M<A>, f: (A) -> B): M.M<B> = M {
    x by m
    f(x)
  }

  pair<A, B>(ma: M.M<A>, mb: M.M<B>): M.M<(A, B)> = M {
    a by ma
    b by mb
    (a, b)
  }

  sequence<A>(ms: List<M.M<A>>): M.M<List<A>> = when (ms) {
    [] -> M.pure([])
    [m, *rest] -> M {
      x by m
      xs by sequence(rest)
      [x, *xs]
    }
  }
}

module OptionOps = MonadOps(Options)
module ResultOps = MonadOps(Results)

half(n: Int): Option<Int> = if (n % 2 == 0) Some(n / 2) else None

positive(n: Int): Result<Int, String> = if (n > 0) Ok(n) else Error("$n isn't positive")

check(ok: Boolean, why: String): Result<Unit, String> = if (ok) Ok(Unit) else Error(why)

// Stops at the first None; otherwise the last line comes back as Some.
quarter(n: Int): Option<Int> = Options {
  h by half(n)
  q by half(h)
  q
}

// Plain lines mix with `by` lines, and `_ by` checks without naming anything.
divide(a: Int, b: Int): Result<Int, String> = Results {
  x by positive(a)
  y by positive(b)
  _ by check(x % y == 0, "$y doesn't divide $x")
  total = x / y
  total * 10
}

// A pattern can take apart what comes out.
sumPair(p: Option<(Int, Int)>): Option<Int> = Options {
  (a, b) by p
  a + b
}

main() = {
  assertEquals(Some(3), quarter(12))
  assertEquals(None, quarter(6))
  assertEquals(Some(3), Options.bind(Some(12)) { Options.bind(half(it), half) })
  assertEquals(Ok(20), divide(8, 4))
  assertEquals(Error("3 doesn't divide 8"), divide(8, 3))
  assertEquals(Error("-1 isn't positive"), divide(-1, 4))
  assertEquals(Some(3), sumPair(Some((1, 2))))
  assertEquals(Some((1, 2)), OptionOps.pair(half(2), half(4)))
  assertEquals(None, OptionOps.map(half(3)) { it + 1 })
  assertEquals(Some([1, 2]), OptionOps.sequence([half(2), half(4)]))
  assertEquals(None, OptionOps.sequence([half(2), half(3)]))
  assertEquals(Ok([1, 2]), ResultOps.sequence([positive(1), positive(2)]))
  assertEquals(Error("-1 isn't positive"), ResultOps.sequence([positive(1), positive(-1)]))
}
