// 4.1 Record and variant disambiguation
// fckt knows the type of every record and variant, so it never guesses from the "last defined
// type". The two examples that are errors in OCaml work here.

type FirstRecord(x: Int, y: Int, z: Int)
type MiddleRecord(x: Int, z: Int)
type LastRecord(x: Int)

type FirstVariant { A, B, C }
type LastVariant { A }

lookAtXThenZ(r: FirstRecord) = {
  x = r.x
  x + r.z
}

permute(x: FirstVariant): FirstVariant = when (x) {
  A -> B
  B -> A
  C -> C
}

type Wrapped { First(FirstRecord) }

f(w: Wrapped) = when (w) {
  First(r) -> (r, r.x)
}

projectAndRotate(r: FirstRecord) = FirstRecord(x = -r.y, y = r.x, z = 0)

lookAtXz(r: MiddleRecord) = r.x

// An error in OCaml, which decides r is a LastRecord when it sees r.x.
lookAtXThenY(r: FirstRecord) = {
  x = r.x
  x + r.y
}

// Also an error in OCaml, which decides x is a LastVariant when it sees A.
isAOrB(x: FirstVariant) = when (x) {
  A, B -> true
  C -> false
}

main() = {
  r = FirstRecord(1, 2, 3)
  assertEquals(4, lookAtXThenZ(r))
  assertEquals(B, permute(A))
  assertEquals((r, 1), f(First(r)))
  assertEquals(FirstRecord(-2, 1, 0), projectAndRotate(r))
  assertEquals(4, lookAtXz(MiddleRecord(4, 5)))
  assertEquals(3, lookAtXThenY(r))
  assert(isAOrB(B))
  last: LastVariant = A
  assertEquals(A, last)
}
