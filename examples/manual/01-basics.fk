// 1 Basics
// The OCaml toplevel prints each phrase's value; a fckt program prints them from main.

pi = 4.0 * atan(1.0)

// OCaml infers float from *. ; fckt's * works on both, so the parameter says which.
square(x: Float) = x * x

fib(n: Int): Int = if (n < 2) n else fib(n - 1) + fib(n - 2)

main() = {
  println("${1 + 2 * 3}")
  println("$pi")
  println("${square(sin(pi)) + square(cos(pi))}")
  // OCaml rejects 1.0 * 2. fckt promotes the Int, as Kotlin does.
  println("${1.0 * 2}")
  println("${fib(10)}")
}
