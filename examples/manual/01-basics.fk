// 1 Basics
// The OCaml toplevel prints each phrase's value. Here, main asserts what it would print.

pi = 4.0 * atan(1.0)

// OCaml infers float from *. ; fckt's * works on both, so the parameter says which.
square(x: Float) = x * x

fib(n: Int): Int = if (n < 2) n else fib(n - 1) + fib(n - 2)

main() = {
  assertEquals(7, 1 + 2 * 3)
  assertEquals(3.141592653589793, pi)
  assertEquals(1.0, square(sin(pi)) + square(cos(pi)))
  // OCaml rejects 1.0 * 2. fckt promotes the Int, as Kotlin does.
  assertEquals(2.0, 1.0 * 2)
  assertEquals(55, fib(10))
}
