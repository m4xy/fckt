// 2 Data types

l = ["is", "a", "tale", "told", "etc."]

// List patterns: [] is the empty list, [head, *tail] is a first element and the rest.
sort<T>(lst: List<T>): List<T> = when (lst) {
  [] -> []
  [head, *tail] -> insert(head, sort(tail))
}

insert<T>(elt: T, lst: List<T>): List<T> = when (lst) {
  [] -> [elt]
  [head, *tail] -> if (elt <= head) [elt, *lst] else [head, *insert(elt, tail)]
}

main() = {
  // Booleans
  assertEquals(false, (1 < 2) == false)
  one = if (true) 1 else 2
  assertEquals(1, one)

  // Characters
  assertEquals("a", 'a'.toString())
  assertEquals(10, '\n'.code)

  // Strings. Kotlin's raw strings stand in for OCaml's quoted strings.
  assertEquals("Hello world", "Hello" + " " + "world")
  assertEquals("This is a quoted string, here, neither \\ nor \" are special characters",
    """This is a quoted string, here, neither \ nor " are special characters""")
  assert("""\\""" == "\\\\")
  assert("""the end of this|}quoted string is here""" == "the end of this|}quoted string is here")

  // Lists. [x, *l] is OCaml's x :: l.
  assertEquals(["Life", "is", "a", "tale", "told", "etc."], ["Life", *l])
  assertEquals(["a", "etc.", "is", "tale", "told"], sort(l))
  assertEquals([2, 3, 5, 6], sort([6, 2, 5, 3]))
  assertEquals([2.718, 3.14], sort([3.14, 2.718]))
}
