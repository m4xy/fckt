
// 7 Lazy expressions
// lazy(~e) computes e the first time .value is read, and remembers it, like Kotlin's lazy.

lazyTwo = lazy(~(1 + 1))

lazyL = lazy(~([1, 2] + [3, 4]))

// fckt has no lazy patterns, so the guard is read with .value.
maybeEval<T>(lazyGuard: Lazy<Boolean>, lazyExpr: Lazy<T>) =
  if (!lazyGuard.value) "matches if (Lazy.force lazy_guard = false); lazy_expr not forced"
  else {
    lazyExpr.value
    "matches if (Lazy.force lazy_guard = true); lazy_expr forced"
  }

main() = {
  // Nothing is computed until .value is read, and then only once.
  assert(!lazyTwo.isInitialized())
  assertEquals(2, lazyTwo.value)
  assert(lazyTwo.isInitialized())
  assertEquals([1, 2, 3, 4], lazyL.value)

  notForced = lazy(~1)
  assertEquals("matches if (Lazy.force lazy_guard = false); lazy_expr not forced", maybeEval(lazy(~false), notForced))
  assert(!notForced.isInitialized())

  forced = lazy(~1)
  assertEquals("matches if (Lazy.force lazy_guard = true); lazy_expr forced", maybeEval(lazy(~true), forced))
  assert(forced.isInitialized())
}
