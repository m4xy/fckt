// Values that change. A record's field can be `var`, and so can a local; assigning one is
// @Mutating, which a function must declare, as it would @Console. But changing a value that was
// made inside a function and never left it is something no one else can see, so it doesn't count:
// a function can use vars inside and still be pure.

type Account(owner: String, var balance: Int)

// Changes the account it's given, which the caller can see.
@Mutating deposit(account: Account, amount: Int) = {
  account.balance += amount
}

// Pure: the account is made here and never leaves.
total(amounts: List<Int>): Int = {
  account = Account("total", 0)
  amounts.forEach(amount -> deposit(account, amount))
  account.balance
}

// Pure: a local var, changed only here.
count(xs: List<Int>): Int = {
  var n = 0
  xs.forEach(x -> { n += 1 })
  n
}

// Changes an account it gives back: the change goes with it, so this is @Mutating too.
@Mutating opened(owner: String, first: Int): Account = {
  account = Account(owner, 0)
  deposit(account, first)
  account
}

// Pure, but what it makes changes something each time it's called: the function says so.
counter(): @Mutating () -> Int = {
  var n = 0
  ~{
    n += 1
    n
  }
}

// A case's fields can be var too. Which case a value is must be checked first, so the field is there.
type Tree { Leaf, Node(var left: Tree, value: Int, var right: Tree) }

@Mutating insert(tree: Tree, x: Int): Tree = when (tree) {
  is Leaf -> Node(Leaf, x, Leaf)
  is Node -> {
    if (x < tree.value) {
      tree.left = insert(tree.left, x)
    } else {
      tree.right = insert(tree.right, x)
    }
    tree
  }
}

toList(tree: Tree): List<Int> = when (tree) {
  Leaf -> []
  Node(left, value, right) -> [*toList(left), value, *toList(right)]
}

// The tree is made and changed here, and never leaves: pure.
sorted(xs: List<Int>): List<Int> = {
  var tree = Leaf
  xs.forEach(x -> { tree = insert(tree, x) })
  toList(tree)
}

main() = {
  assertEquals([1, 2, 3, 5, 8], sorted([5, 3, 8, 1, 2]))
  account = opened("Ada", 50)
  deposit(account, 25)
  account.balance = account.balance - 5
  assertEquals(70, account.balance)
  assertEquals(6, total([1, 2, 3]))
  assertEquals(3, count([4, 5, 6]))
  next = counter()
  next()
  assertEquals(2, next())
}
