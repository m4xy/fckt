import fckt.effects.Yielding
import fckt.io.Console
import fckt.io.Terminal

// Handled effects: an effect with operations. Declaring one makes its operations callable by
// name, and calling one does the effect, as calling println does @Console. Whatever handles the
// effect around the call answers it: a module that follows the effect's spec, or a handler made
// from a function for each operation. Handling an effect takes it away, so a test that answers
// Console itself is pure. main handles what it does with each effect's default, @HandledBy.

@Console greet() = {
  name = readLine()
  println("hello $name")
}

// Pure: Console is answered here, and what was printed is a local var.
greeted(name: String): List<String> = {
  var printed = []
  Console(print = s -> Unit, println = line -> { printed = printed + [line] }, readLine = ~name) {
    greet()
  }
  printed
}

// An effect of our own, with a default for main.
@HandledBy(FixedClock) effect Clock {
  now(): Int
}

module FixedClock : Clock {
  now() = 1700000000
}

@Clock stamped(message: String) = "[${now()}] $message"

// A generic effect: what countdown yields, Ints, is in its annotation.
effect Yielding<A> {
  yield(value: A): Unit
}

@Yielding<Int> countdown(n: Int): Unit = if (n == 0) Unit else {
  yield(n)
  countdown(n - 1)
}

// Pure: everything countdown yields is collected here.
collected(): List<Int> = {
  var seen = []
  Yielding(yield = n -> { seen = seen + [n] }) {
    countdown(3)
  }
  seen
}

// A handler that does the effect itself reaches the handler around it: here, prefixing each line.
@Console shouted() = Console(print = print, println = line -> println("> $line"), readLine = readLine) {
  greet()
}

// Prints nothing.
module Silent : Console {
  print(s: String) = Unit
  println(s: String) = Unit
  readLine() = ""
}

// A copy of an effect: the same operations, as a separate effect, handled on its own. Two stores
// can then be answered by two handlers, and each operation is called through the one it's on.
effect Store {
  load(key: String): String
}

effect Orders = Store
effect Users = Store

@Orders @Users summary(id: String): String = "${Users.load(id)} ordered ${Orders.load(id)}"

summaryFrom(id: String): String = Orders(load = key -> "a book") {
  Users(load = key -> "Ada") { summary(id) }
}

main(args: List<String>) = {
  assertEquals("Ada ordered a book", summaryFrom("1"))
  assertEquals(["hello Ada"], greeted("Ada"))
  assertEquals("[1700000000] ready", stamped("ready"))
  assertEquals("[5] ready", Clock(now = ~5) { stamped("ready") })
  assertEquals([3, 2, 1], collected())
  // A module that follows Console is a handler too, chosen like any value.
  console = if (args.contains("--quiet")) Silent else Terminal
  console { println("from the terminal") }
}
