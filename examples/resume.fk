import fckt.collections.Streams.*
import fckt.effects.Generators.*
import fckt.effects.Yielding
import fckt.values.Lazies.*
import fckt.values.Mutable

// Handlers that choose whether to resume. A function answering an operation may take one more
// parameter, resume: the rest of the handled block, waiting at the call. Calling it carries on
// with the operation's result, and gives what the block gives; the handler can call it now,
// later, or never. It can be called at most once. The standard library's Fail, Yielding and
// sequence are made this way.

// Never resumed: fail gives Nothing, so no handler can resume it, and it fits anywhere, as a branch.
@Fail entry(line: String): (String, String) = when (line.split("=")) {
  [key, value] -> (key, value)
  else -> fail("no '=' in '$line'")
}

// The first fail anywhere below ends the block, with no Results passed up by hand.
parse(lines: List<String>): Result<List<(String, String)>, String> =
  Fail(fail = (reason, resume) -> Error(reason)) { Ok(lines.map(entry)) }

// The same, as the standard library has it.
parseAll(lines: List<String>): Result<List<(String, String)>, String> = attempt { lines.map(entry) }

// Resumed later: sequence's handler keeps the rest of the block in the stream, for when it's read.
// Never ends, but only what's taken is computed.
@Yielding<Int> naturals(from: Int): Unit = {
  yield(from)
  naturals(from + 1)
}

// Resumed in turn: pause parks the rest of a task at the back of a queue, and the next one runs.
effect Async {
  pause(): Unit
}

// Tasks that may do anything: what they do is the effect parameter E, as a type parameter is a type.
type Queue<@E>(var tasks: List<@E () -> Unit>)

// Does @Mutating, and whatever the tasks do.
@Mutating runQueue<@E>(queue: Queue<@E>): Unit = when (queue.tasks) {
  [] -> Unit
  [task, *rest] -> {
    queue.tasks = rest
    task()
    runQueue(queue)
  }
}

// The queue is local, so this does only what the tasks do, besides pausing.
roundRobin<@E>(tasks: List<@Async @E () -> Unit>): Unit = {
  queue = Queue([])
  queue.tasks = tasks.map { task -> ~Async(pause = resume -> { queue.tasks = queue.tasks + [~resume(Unit)] }) { task() } }
  runQueue(queue)
}

@Async @Console worker(name: String): Unit = {
  println("$name: started")
  pause()
  println("$name: finished")
}

@Async @Mutating step(log: Mutable<List<String>>, name: String): Unit = {
  log.value = log.value + ["$name 1"]
  pause()
  log.value = log.value + ["$name 2"]
}

// The same scheduler, for tasks that don't print: this is pure.
interleaved(): List<String> = {
  log = Mutable([])
  roundRobin([~step(log, "a"), ~step(log, "b")])
  log.value
}

@Console main() = {
  assertEquals(Ok([("a", "1"), ("b", "2")]), parse(["a=1", "b=2"]))
  assertEquals(Error("no '=' in 'oops'"), parse(["a=1", "oops", "c"]))
  assertEquals(parse(["a=1", "oops"]), parseAll(["a=1", "oops"]))
  assertEquals([0, 1, 2, 3, 4], sequence { naturals(0) }.take(5))
  assertEquals(["a 1", "b 1", "a 2", "b 2"], interleaved())
  roundRobin([~worker("a"), ~worker("b")])
}
