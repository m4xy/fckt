// fckt --language-server: the Language Server Protocol, on standard input and output, for any
// editor that speaks it. Each file opened, changed or saved has its project checked, with what's
// open as it is in the editor, and what's wrong said of each of its files; and a file is laid out
// as fckt --format lays it out. A project is the folder with build.fk above the file, its folders
// and libraries as kiln last wrote them, in .kiln/paths; or, without kiln's, the file's folder.
module LanguageServer {
  // What's open, by URI; the URIs said to have something wrong, and what was checked, by the
  // project they're in; and the files changed since their projects were last checked.
  private type Session(
    var open: Map<String, String>,
    var said: Map<String, List<String>>,
    var programs: Map<String, List<CheckedProgram>>,
    var stopping: Boolean,
    var changed: List<String>,
    var reuses: Map<String, Reuse>,
    var facts: Map<String, Map<String, List<Fact>>>,
    var prepared: Map<String, (String, Prepared)>,
    var unparsed: Map<String, List<Diagnostic>>,
    // Each file's text as it was last checked, which what was noted of it is where it is in.
    var checkedTexts: Map<String, String>,
  )

  // A project: the folders of its own packages, and the libraries' interfaces.
  private type Project(root: Path, folders: List<Path>, libraries: List<Path>)

  @FileSystem @Channel @Process serve(): Unit = served(
    Session(
      emptyMap(),
      emptyMap(),
      emptyMap(),
      false,
      [],
      emptyMap(),
      emptyMap(),
      emptyMap(),
      emptyMap(),
      emptyMap(),
    ),
  )

  @FileSystem @Channel @Process private served(session: Session): Unit = when (received()) {
    None -> exit(if (session.stopping) 0 else 1)
    Some(message) -> {
      handled(session, message)
      // As someone types, a change comes with each key: their projects are checked once nothing's
      // come for a moment, once each, as the files are then.
      if (session.changed.isNotEmpty() && !waiting(0.15)) {
        changed = session.changed
        session.changed = []
        changed.fold(
          emptyMap(),
        ) { byRoot, u -> byRoot.put(projectOf(pathOf(u)).root.value, u) }.values
          .forEach { checked(session, it) }
      }
      else Unit
      served(session)
    }
  }

  // Whether something's come to read within seconds.
  private external waiting(seconds: Float): Boolean =
    "(fun s -> try let (r, _, _) = Unix.select [Unix.stdin] [] [] s in r <> [] with Unix.Unix_error _ -> false) seconds"

  @FileSystem @Channel @Process private handled(session: Session, message: Json): Unit = {
    id = message.field("id")
    params = message.field("params").getOrElse(JsonNull)
    uri = params.field("textDocument").flatMap { it.field("uri") }.flatMap { it.text }
    when (message.field("method").flatMap { it.text }.getOrElse("")) {
      "initialize" -> answer(id, JsonObject([
        ("capabilities", JsonObject([
          ("textDocumentSync", number(1)),
          ("documentFormattingProvider", JsonBoolean(true)),
          ("hoverProvider", JsonBoolean(true)),
          ("definitionProvider", JsonBoolean(true)),
          ("documentSymbolProvider", JsonBoolean(true)),
          ("referencesProvider", JsonBoolean(true)),
          ("documentHighlightProvider", JsonBoolean(true)),
          ("implementationProvider", JsonBoolean(true)),
          ("workspaceSymbolProvider", JsonBoolean(true)),
          ("signatureHelpProvider", JsonObject([
            ("triggerCharacters", JsonArray([JsonString("("), JsonString(",")])),
          ])),
          ("renameProvider", JsonBoolean(true)),
          ("inlayHintProvider", JsonBoolean(true)),
          ("codeActionProvider", JsonBoolean(true)),
          ("semanticTokensProvider", JsonObject([
            ("legend", JsonObject([
              ("tokenTypes", JsonArray(tokenTypes.map { JsonString(it) })),
              ("tokenModifiers", JsonArray([JsonString("declaration")])),
            ])),
            ("full", JsonBoolean(true)),
          ])),
          ("completionProvider", JsonObject([("triggerCharacters", JsonArray([JsonString(".")]))])),
        ])),
        ("serverInfo", JsonObject([("name", JsonString("fckt"))])),
      ]))
      "shutdown" -> {
        session.stopping = true
        answer(id, JsonNull)
      }
      "exit" -> exit(if (session.stopping) 0 else 1)
      "textDocument/didOpen" -> uri.forEach { u ->
        text = params.field("textDocument").flatMap { it.field("text") }.flatMap { it.text }
        session.open = session.open.put(u, text.getOrElse(""))
        session.changed = session.changed + [u]
      }
      "textDocument/didChange" -> uri.forEach { u ->
        changes = params.field("contentChanges").map { it.items }.getOrElse([])
        changes.lastOrNone().flatMap { it.field("text") }.flatMap { it.text }.forEach { text ->
          session.open = session.open.put(u, text)
        }
        session.changed = session.changed + [u]
      }
      "textDocument/didSave" -> uri.forEach { u -> session.changed = session.changed + [u] }
      "textDocument/didClose" -> uri.forEach { u -> session.open = session.open.remove(u) }
      "textDocument/formatting" -> answer(id, JsonArray(uri.flatMap { u ->
        session.open.get(u).flatMap { text ->
          laid = Layout.formatted(text)
          if (laid == text) None else Some(whole(text, laid))
        }
      }.toList()))
      "textDocument/hover" -> answer(id, uri.flatMap { u ->
        localAt(session, u, params).map { l ->
          said = "```fckt\n${l.name}: ${Solutions.solving { TypeText.shown(l.t) }}\n```"
          JsonObject(
            [
              ("contents", JsonObject([("kind", JsonString("markdown")), ("value", JsonString(said))])),
            ],
          )
        }.orElse { hover(session, u, params) }
      }.getOrElse(JsonNull))
      "textDocument/definition" -> answer(id, JsonArray(uri.flatMap { u ->
        localAt(session, u, params).map { l ->
          location(l.file, l.bound.line - 1, l.bound.column - 1, l.name.length)
        }.orElse { symbolAt(session, u, params).flatMap { locationOf(it) } }
      }.toList()))
      "textDocument/references" -> answer(id, JsonArray(uri.map { u ->
        whole = params.field("context").flatMap { it.field("includeDeclaration") }
        withDeclaration = whole.map { it == JsonBoolean(true) }.getOrElse(true)
        localAt(session, u, params).map { l ->
          localUses(session, l).filter { at -> withDeclaration || at != l.bound }.map { at ->
            location(l.file, at.line - 1, at.column - 1, l.name.length)
          }
        }.orElse { symbolAt(session, u, params).map { s ->
          (if (withDeclaration) locationOf(s).toList() else []) + usesOf(session, u, s).map { use ->
            (file, at, length) = use
            location(file, at.line - 1, at.column - 1, length)
          }
        } }.getOrElse([])
      }.getOrElse([])))
      "textDocument/documentHighlight" -> answer(id, JsonArray(uri.map { u ->
        here = pathOf(u).value
        places = localAt(session, u, params).map { l ->
          localUses(session, l).map { at -> (at, l.name.length) }
        }.orElse {
          symbolAt(session, u, params).map { s ->
            uses = usesOf(session, u, s).filter { use ->
              (file, _, _) = use
              file == here
            }.map { use ->
              (_, at, length) = use
              (at, length)
            }
            declared = nameOf(session, s).toList().filter { found ->
              (file, _, _) = found
              file == here
            }.map { found ->
              (_, line, column) = found
              (Position(line + 1, column + 1), s.declaration.name.split(".").lastOrNone().getOrElse("").length)
            }
            declared + uses
          }
        }.getOrElse([])
        places.distinct().map { place ->
          (at, length) = place
          JsonObject(
            [("range", range(at.line - 1, at.column - 1, at.line - 1, at.column - 1 + length))],
          )
        }
      }.getOrElse([])))
      "textDocument/rename" -> answer(id, uri.flatMap { u ->
        newName = params.field("newName").flatMap { it.text }.getOrElse("")
        localAt(session, u, params).map { l ->
          changes = localUses(session, l).map { at ->
            JsonObject([
              ("range", range(at.line - 1, at.column - 1, at.line - 1, at.column - 1 + l.name.length)),
              ("newText", JsonString(newName)),
            ])
          }
          JsonObject([("changes", JsonObject([(uriOf(l.file), JsonArray(changes))]))])
        }.orElse { symbolAt(session, u, params).map { s -> renamed(session, u, s, newName) } }
      }.getOrElse(JsonNull))
      "textDocument/codeAction" -> answer(id, JsonArray(uri.map { u ->
        said = params.field(
          "context",
        ).flatMap { it.field("diagnostics") }.map { it.items }.getOrElse([])
        said.flatMap { d -> fixes(session, u, d) }
      }.getOrElse([])))
      "textDocument/semanticTokens/full" -> answer(id, JsonObject([
        ("data", JsonArray(uri.map { u -> tokensOf(session, u) }.getOrElse([]).map { number(it) })),
      ]))
      // What implements the spec or spec's value at the position.
      "textDocument/implementation" -> answer(id, JsonArray(uri.map { u ->
        (line, character) = positionOf(params)
        specMarkers(session, u).filter { m ->
          (l, column, length, kind, _) = m
          kind == "implemented" && l == line && character >= column && character <= column + length
        }.flatMap { m ->
          (_, _, _, _, targets) = m
          targets
        }
      }.getOrElse([])))
      // fckt's own: each spec, module, and value of them, in the file, with what implements it or
      // what it implements, for an editor to mark.
      "fckt/specMarkers" -> answer(id, JsonArray(uri.map { u ->
        specMarkers(session, u).map { m ->
          (line, column, length, kind, targets) = m
          JsonObject([
            ("range", range(line, column, line, column + length)),
            ("kind", JsonString(kind)),
            ("targets", JsonArray(targets)),
          ])
        }
      }.getOrElse([])))
      "workspace/symbol" -> answer(id, JsonArray(symbolsNamed(
        session,
        params.field("query").flatMap { it.text }.getOrElse(""),
      )))
      "textDocument/signatureHelp" -> answer(
        id,
        uri.flatMap { u -> signatureHelp(session, u, params) }.getOrElse(JsonNull),
      )
      "textDocument/inlayHint" -> answer(
        id,
        JsonArray(uri.map { u -> hints(session, u) }.getOrElse([])),
      )
      "textDocument/completion" -> answer(
        id,
        JsonArray(uri.map { u -> completions(session, u, params) }.getOrElse([])),
      )
      "textDocument/documentSymbol" -> answer(id, JsonArray(uri.map { u ->
        text = session.open.get(u).getOrElse(readOrEmpty(pathOf(u)))
        when (Parser.parse(text)) {
          Ok(file) -> file.declarations.map { symbolOf(it, text) }
          Error(_) -> []
        }
      }.getOrElse([])))
      // What answers what this asked, as a refresh, has no method, and wants no answer.
      method -> if (id.isSome() && method.isNotEmpty() && !method.startsWith("$/")) refuse(
        id,
        method,
      ) else Unit
    }
  }

  // An edit that replaces all of text with laid.
  private whole(text: String, laid: String): Json = {
    lines = text.split("\n")
    JsonObject([
      ("range", range(0, 0, lines.size, 0)),
      ("newText", JsonString(laid)),
    ])
  }

  // check, which, if it can't be done, as the core can't be found, is let be, and said.
  // A library's interface isn't checked: it's in no project, and its library was checked already.
  @FileSystem @Channel @Process private checked(session: Session, uri: String): Unit =
    if (uri.endsWith(".fki")) Unit
    else when (attempt { check(session, uri) }) {
      Ok(_) -> Unit
      Error(why) -> printError("fckt: can't check $uri: $why")
    }

  // The project the file at uri is in, checked, and what's wrong with each of its files said: none,
  // for those it said something of before that are right now.
  @FileSystem @Channel @Process private check(
    session: Session,
    uri: String,
    publishing: Boolean = true,
  ): Unit = {
    file = pathOf(uri)
    project = projectOf(file)
    folders = if (project.folders.any { file.value.startsWith(it.value + "/") }) project.folders
    else project.folders + file.parent.toList()
    own = folders.flatMap { dir ->
      packagesIn(dir, [], ProgramProject, "${dir.value}/").map { pkg, sources ->
        (pkg, sources.map { s -> s.copy(text = editing(session, s)) })
      }
    }
    libraries = project.libraries.filter { it.resolve("unit").exists() }.flatMap {
      interfacesIn(it)
    }
    fckt = home()
    std = if (libraries.isEmpty()) whereTheyAre(standard(fckt), fckt) else []
    tree = SourceTree(merged(whereTheyAre(core(fckt), fckt) + std + own + libraries).mapValues { _, sources ->
      sources.map { withParsed(session, it) }
    })
    session.checkedTexts = tree.packages.values.flatMap { it }.filter { it.project == ProgramProject }.fold(session.checkedTexts) { m, source ->
      source.path.map { path -> m.put(path, source.text) }.getOrElse(m)
    }
    // A file with main is a program of its own, checked from it; the packages none of them reaches,
    // from what imports them.
    mains = own.filter { pkg, _ -> pkg.isEmpty() }.flatMap { _, sources -> sources }.map {
      withParsed(session, it)
    }.filter { source ->
      when (source.prepared) {
        Some(prepared) -> Tests.declaresMain(prepared.file)
        None -> declaresMain(source.text)
      }
    }
    fromMains = mains.map { checkedFrom(session, project, tree, it) }
    reached = fromMains.flatMap { program, _ ->
      program.toList().flatMap { p -> p.workspace.files.mapNotNull { it.source.path } }
    }.fold(emptyMap()) { m, path -> m.put(path, true) }
    unreached = own.filter { pkg, sources ->
      pkg.isNotEmpty() && sources.any { s -> !reached.containsKey(s.path.getOrElse("")) }
    }
    imported = unreached.map { pkg, _ -> "import ${pkg.joinToString(".")}.*\n" }.distinct()
    allReached = fromMains.isNotEmpty() && fromMains.all { program, _ -> program.isSome() }
    rest = if (allReached && imported.isEmpty()) []
    else [
      checkedFrom(
        session,
        project,
        tree,
        SourceText(None, ProgramProject, imported.joinToString("")),
      ),
    ]
    results = fromMains + rest
    problems = results.flatMap { _, found -> found }.distinct()
    checked = results.flatMap { program, _ -> program.toList() }
    // What a check that couldn't read the code found is nothing; what the last that could did is
    // kept, for what's asked while the code's half written.
    if (checked.isNotEmpty()) {
      session.facts = session.facts.put(project.root.value, when (checked) {
        // One program's are noted once each already.
        [one] -> one.facts.fold(
          emptyMap(),
        ) { m, fact -> m.put(fileOf(fact), [fact] + m.getOrDefault(fileOf(fact), [])) }
        else -> byFile(checked.flatMap { it.facts })
      })
      session.programs = session.programs.put(project.root.value, checked)
    }
    else Unit
    // A file that can't be read is checked as it last could be, and only what's wrong with how it's
    // written is said of it.
    paths = own.flatMap { _, sources -> sources.mapNotNull { it.path } }
    unread = paths.filter { session.unparsed.containsKey(it) }
    found = problems.filter { d -> d.file.isSome() && !unread.contains(d.file.getOrElse("")) } +
      unread.flatMap { session.unparsed.getOrDefault(it, []) }
    byFile = found.fold(emptyMap()) { m, d ->
      key = uriOf(d.file.getOrElse(""))
      m.put(key, m.getOrDefault(key, []) + [d])
    }
    if (publishing) {
      said(session, project, byFile)
      // What's coloured and hinted is what was checked: the editor asks again now it's changed.
      asked("workspace/semanticTokens/refresh")
      asked("workspace/inlayHint/refresh")
    }
    else Unit
  }

  // What's wrong with each file said, and that nothing is of those said to have something wrong
  // before that don't now.
  @FileSystem @Channel private said(
    session: Session,
    project: Project,
    byFile: Map<String, List<Diagnostic>>,
  ): Unit = {
    before = session.said.getOrDefault(project.root.value, [])
    before.filter { !byFile.containsKey(it) }.forEach { publish(it, []) }
    byFile.entries.forEach { key, diagnostics ->
      text = session.open.get(key).getOrElse(readOrEmpty(pathOf(key)))
      publish(key, diagnostics.map { shown(it, text) })
    }
    session.said = session.said.put(project.root.value, byFile.keys)
  }

  // The core's and the standard library's files, named where they are, as the compiler names them
  // otherwise, core:fckt/lang/Lists.fk and std/src/...: so an editor can go to them.
  @FileSystem private whereTheyAre(
    packages: List<(List<String>, List<SourceText>)>,
    home: Path,
  ): List<(List<String>, List<SourceText>)> = packages.map { pkg, sources ->
    (pkg, sources.map { source -> source.copy(path = source.path.map { p -> realPath(p, home) }) })
  }

  @FileSystem private realPath(written: String, home: Path): String =
    if (written.startsWith("core:")) {
      installed = home.resolve("core")
      folder = if (installed.isDirectory()) installed else home.resolve("src/main/resources/std")
      folder.resolve(written.removePrefix("core:")).canonical().value
    }
    else if (written.startsWith("/")) written
    else home.resolve(written).canonical().value

  // The source, read: as it was when its text was last the same, or now; or, if it can't be read
  // as it is, as it last could be, with why it can't be kept for saying.
  @Mutating private withParsed(session: Session, source: SourceText): SourceText = {
    key = "${source.path.getOrElse("")} ${source.interface}"
    path = source.path.getOrElse("")
    when (session.prepared.get(key)) {
      Some((text, prepared)) if text == source.text -> {
        session.unparsed = session.unparsed.remove(path)
        source.copy(prepared = Some(prepared))
      }
      before -> when (Loader.prepare(source)) {
        Some(prepared) -> {
          session.prepared = session.prepared.put(key, (source.text, prepared))
          session.unparsed = session.unparsed.remove(path)
          source.copy(prepared = Some(prepared))
        }
        None -> {
          errors = when (if (source.interface) Parser.parseInterface(source.text) else Parser.parse(source.text)) {
            Ok(_) -> []
            Error(found) -> found.map { Diagnostic(source.path, it.at, it.message) }
          }
          session.unparsed = session.unparsed.put(path, errors)
          when (before) {
            Some((text, prepared)) -> source.copy(text = text, prepared = Some(prepared))
            None -> source
          }
        }
      }
    }
  }

  // The program checked from entry, with what checking it before found, so what hasn't changed
  // since isn't checked again.
  @Mutating private checkedFrom(
    session: Session,
    project: Project,
    tree: SourceTree,
    entry: SourceText,
  ): (Option<CheckedProgram>, List<Diagnostic>) = {
    key = "${project.root.value} ${entry.path.getOrElse("")}"
    earlier = session.reuses.get(key).getOrElse(Reuse("", emptyMap(), 0))
    (program, problems) = Checker.check(entry, tree, true, true, Some(earlier))
    program.flatMap { it.reuse }.forEach { r -> session.reuses = session.reuses.put(key, r) }
    (program, problems)
  }

  private declaresMain(text: String): Boolean = when (Parser.parse(text)) {
    Ok(file) -> Tests.declaresMain(file)
    Error(_) -> false
  }

  // The function the name at params' position means: the one declared there, or the one function
  // of that name the project last checked has, if there's only one.
  @FileSystem private named(
    session: Session,
    uri: String,
    params: Json,
  ): Option<CheckedFunction> = {
    position = params.field("position")
    line = position.flatMap { it.field("line") }.flatMap { it.int }.getOrElse(0)
    character = position.flatMap { it.field("character") }.flatMap { it.int }.getOrElse(0)
    file = pathOf(uri)
    text = session.open.get(uri).getOrElse(readOrEmpty(file))
    name = wordAt(text.split("\n").getOrNone(line).getOrElse(""), character)
    programs = session.programs.getOrDefault(projectOf(file).root.value, [])
    candidates = programs.flatMap { it.functions }.filter { it.function.declaration.name == name }
    distinct = candidates.fold(emptyMap()) { m, f -> m.put(f.function.name, f) }.values
    here = distinct.find { f ->
      f.function.file.source.path == Some(file.value) && f.function.declaration.at.line == line + 1
    }
    if (name.isEmpty()) None
    else when (here) {
      Some(found) -> Some(found)
      None -> if (distinct.size == 1) distinct.firstOrNone() else None
    }
  }

  private fileOf(fact: Fact): String = when (fact) {
    Means(f, _, _, _, _) -> f.getOrElse("")
    Does(f, _, _) -> f.getOrElse("")
    Gives(f, _, _) -> f.getOrElse("")
    TypeName(f, _, _, _) -> f.getOrElse("")
    Binds(f, _, _, _, _, _, _) -> f.getOrElse("")
    Reads(f, _, _, _, _, _) -> f.getOrElse("")
  }

  // What's noted of each file, once each, as each of the programs it's in noted it.
  private byFile(facts: List<Fact>): Map<String, List<Fact>> = {
    (_, found) = facts.fold((emptyMap(), emptyMap())) { seen, fact ->
      (keys, files) = seen
      (file, key) = when (fact) {
        Means(f, at, _, symbol, _) -> (f.getOrElse(""), "m ${at.line} ${at.column} ${symbol.name}")
        Does(f, at, _) -> (f.getOrElse(""), "d ${at.line} ${at.column}")
        Gives(f, at, _) -> (f.getOrElse(""), "g ${at.line} ${at.column}")
        TypeName(f, at, _, _) -> (f.getOrElse(""), "t ${at.line} ${at.column}")
        Binds(f, at, _, name, _, _, _) -> (f.getOrElse(""), "b ${at.line} ${at.column} $name")
        Reads(f, at, _, name, _, _) -> (f.getOrElse(""), "r ${at.line} ${at.column} $name")
      }
      whole = "$file $key"
      if (keys.containsKey(whole)) seen
      else (keys.put(whole, true), files.put(file, [fact] + files.getOrDefault(file, [])))
    }
    found
  }

  // What's noted of the file, as the project it's in was last checked.
  @FileSystem private factsIn(session: Session, file: Path): List<Fact> =
    session.facts.getOrDefault(projectOf(file).root.value, emptyMap()).getOrDefault(file.value, [])

  // What's noted of every file of the project the file is in.
  @FileSystem private factsOf(session: Session, file: Path): List<Fact> =
    session.facts.getOrDefault(projectOf(file).root.value, emptyMap()).values.flatMap { it }

  // The zero-based line and character params says.
  private positionOf(params: Json): (Int, Int) = {
    position = params.field("position")
    (
      position.flatMap { it.field("line") }.flatMap { it.int }.getOrElse(0),
      position.flatMap { it.field("character") }.flatMap { it.int }.getOrElse(0)
    )
  }

  // What the name at params' position means: as the checker noted it, or the function declared
  // there, or the one function of that name the project has.
  @FileSystem private symbolAt(session: Session, uri: String, params: Json): Option<Symbol> =
    meansAt(
      session,
      uri,
      params,
    ).map { it.symbol }.orElse { named(session, uri, params).map { it.function } }

  // What can follow value., where value is a local or a value named name, written at line and
  // column: the extensions its type fits, and its record's fields.
  @FileSystem private members(
    session: Session,
    uri: String,
    receiver: Type,
    typed: String,
  ): List<Json> = {
    file = pathOf(uri)
    programs = session.programs.getOrDefault(projectOf(file).root.value, [])
    found = programs.flatMap { p ->
      p.environment.toList().flatMap { environment ->
        p.workspace.files.find { it.source.path == Some(file.value) }.map { loaded -> (p, environment, loaded) }.toList()
      }
    }.firstOrNone()
    when (found) {
      Some((program, environment, loaded)) -> {
        context = Context(environment, Place(loaded, []), emptyMap())
        fitting = Solutions.solving {
          environment.extensions.keys.filter { it.startsWith(typed) }.flatMap { n ->
            Globals.extensionsNamed(n, context)
          }.filter { s ->
            when (Diagnostics.attempting { Globals.fit(Globals.receiverType(s, context), receiver) }) {
              Ok(Some(_)) -> true
              _ -> false
            }
          }
        }
        extensions = fitting.fold(emptyMap()) { m, s -> m.put(s.name, s) }.values.map { s ->
          label = s.declaration.name.split(".").lastOrNone().getOrElse(s.declaration.name)
          detail = program.functions.find { it.function.name == s.name }.map { typeOf(it) }.getOrElse("")
          documented(if (Signatures.isProperty(s)) item(label, 10, detail, [])
          else called(item(label, 2, detail, []), label, Signatures.writtenParametersOf(s)), docsOf(s))
        }
        fields = when (receiver) {
          Named(n, _, _) -> program.types.flatMap { t ->
            when (t) {
              DeclaredRecord(record, _, declared) if record.name == n -> declared
              else -> []
            }
          }
          else -> []
        }.filter { it.name.startsWith(typed) }.map { f ->
          item(f.name, 5, Solutions.solving { TypeText.shown(f.t) }, [])
        }
        fields + extensions.take(200)
      }
      _ -> []
    }
  }

  // The type of the local or value named name, written at line and column: as the checker found
  // it there, or as the nearest binding of it above has it, or a top-level value's.
  @FileSystem private receiverOf(
    session: Session,
    file: Path,
    line: Int,
    column: Int,
    name: String,
    programs: List<CheckedProgram>,
  ): Option<Type> = {
    facts = factsIn(session, file)
    there = facts.flatMap { f ->
      when (f) {
        Reads(_, at, _, n, _, t) if n == name && at.line == line + 1 && at.column == column + 1 -> [
          t,
        ]
        Binds(
          _,
          at,
          _,
          n,
          t,
          _,
          _,
        ) if n == name && at.line == line + 1 && at.column == column + 1 -> [
          t,
        ]
        else -> []
      }
    }.firstOrNone()
    above = facts.flatMap { f ->
      when (f) {
        Binds(_, at, _, n, t, _, _) if n == name && at.line <= line + 1 -> [(at.line, t)]
        else -> []
      }
    }.fold(None) { best, entry ->
      (l, t) = entry
      when (best) {
        Some((bestLine, _)) if bestLine > l -> best
        _ -> Some((l, t))
      }
    }.map { entry ->
      (_, t) = entry
      t
    }
    value = programs.flatMap { it.functions }.find { f ->
      f.function.declaration.name == name && !Signatures.isFunction(f.function)
    }.map { it.scheme.template }
    there.orElse { above }.orElse { value }
  }

  // The locals bound above line in the function it's in, whose names start with typed, each once.
  @FileSystem private localsAbove(
    session: Session,
    uri: String,
    line: Int,
    typed: String,
  ): List<Json> = {
    file = pathOf(uri)
    start = session.programs.getOrDefault(
      projectOf(file).root.value,
      [],
    ).flatMap { it.functions }.filter { f ->
      f.function.file.source.path == Some(file.value) && f.function.declaration.at.line <= line + 1
    }.map { it.function.declaration.at.line }.maxOrNone().getOrElse(1)
    factsIn(session, file).flatMap { f ->
      when (f) {
        Binds(
          _,
          at,
          _,
          name,
          t,
          _,
          _,
        ) if at.line >= start && at.line <= line + 1 && name.startsWith(typed) -> [
          (name, t),
        ]
        else -> []
      }
    }.fold(emptyMap()) { m, entry ->
      (name, t) = entry
      m.put(name, t)
    }.entries.map { name, t -> item(name, 6, Solutions.solving { TypeText.shown(t) }, []) }
  }

  // What the file doesn't import yet whose name starts with typed: each package's public types,
  // modules, effects and specs, and each effect's operations; with the import it needs.
  @FileSystem private importable(
    session: Session,
    uri: String,
    typed: String,
    text: String,
  ): List<Json> =
    if (typed.isEmpty()) []
    else {
      file = pathOf(uri)
      programs = session.programs.getOrDefault(projectOf(file).root.value, [])
      found = programs.flatMap { p ->
        p.environment.toList().flatMap { environment ->
          p.workspace.files.find { it.source.path == Some(file.value) }.map { loaded -> (environment, loaded) }.toList()
        }
      }.firstOrNone()
      when (found) {
        Some((environment, loaded)) -> {
          imported = (full: String, pkg: List<String>) ->
            pkg == loaded.package || loaded.imports.any { i ->
              i.path.joinToString(".") == full || (i.wildcard && i.path == pkg)
            }
          line = importedAt(text)
          withImport = (full: String) -> [JsonObject([
            ("range", range(line, 0, line, 0)),
            ("newText", JsonString("import $full\n")),
          ])]
          declared = environment.definitions.namespace.table.declarations.filter { s ->
            s.declaration.visibility == Public && s.path == s.file.package && s.declaration.name.startsWith(
              typed,
            ) &&
              s.file.package.isNotEmpty() && !imported(s.name, s.file.package)
          }.map { s ->
            kind = when (s.declaration.definition) {
              ModuleDefinition(_, _, _, _, _) -> 9
              RecordDefinition(_, _, _, _, _) -> 7
              CasesDefinition(_, _, _, _) -> 13
              SpecDefinition(_, _, _, _, _) -> 8
              FunctionDefinition(_, _, _, _, _, _, _) -> 3
              else -> 7
            }
            documented(called(
              item(s.declaration.name, kind, s.name, withImport(s.name)),
              s.declaration.name,
              Signatures.writtenParametersOf(s),
            ), docsOf(s))
          }
          operations = environment.operations.entries.filter { name, _ -> name.startsWith(typed) }.flatMap { name, ops ->
            ops.filter { op ->
              !imported(
                op.effect.name,
                op.effect.file.package,
              ) && op.effect.declaration.visibility == Public
            }.map { op ->
              documented(called(
                item(
                  name,
                  3,
                  "@${op.effect.declaration.name}, from ${op.effect.name}",
                  withImport(op.effect.name),
                ),
                name,
                op.value.parameters,
              ), Docs.said(Docs.above(op.effect.file.source.text, op.value.at.line)))
            }
          }
          // A module's functions, through import module.*.
          members = environment.orderedFunctions.filter { f ->
            f.declaration.visibility == Public && f.path.isNotEmpty() && f.path.size > f.file.package.size &&
              f.declaration.name.startsWith(typed) && !Signatures.isExtension(
                f,
              ) && !f.declaration.name.contains(
                "$",
              ) &&
              !imported(f.path.joinToString(".") + ".*", f.file.package) &&
              !loaded.imports.any { i -> i.wildcard && i.path == f.path }
          }.map { f ->
            module = f.path.joinToString(".")
            documented(called(
              item(f.declaration.name, 3, "from $module", withImport("$module.*")),
              f.declaration.name,
              Signatures.writtenParametersOf(f),
            ), docsOf(f))
          }
          (declared + operations + members).take(100)
        }
        None -> []
      }
    }

  // What the symbol's documentation says, as its file has it.
  private docsOf(s: Symbol): Option<String> = Docs.of(s.file.source.text, s.declaration)

  // The item, with its documentation, if it has any.
  private documented(item: Json, docs: Option<String>): Json = when ((item, docs)) {
    (JsonObject(fields), Some(said)) ->
      JsonObject(
        fields + [
          ("documentation", JsonObject([("kind", JsonString("markdown")), ("value", JsonString(said))])),
        ],
      )
    _ -> item
  }

  // The item, for a function with parameters, written as a call: name(), the cursor after it, with
  // none; name { }, given only a function, as a block; or name(), the cursor in it.
  private called(
    item: Json,
    name: String,
    parameters: Option<List<Parameter>>,
  ): Json = when ((item, parameters)) {
    (JsonObject(fields), Some(ps)) -> {
      call = when (ps) {
        [] -> "$name()\$0"
        [p] if p.parameterType.map { isFunctionType(it) }.getOrElse(false) -> "$name { \$0 }"
        else -> "$name(\$0)"
      }
      JsonObject(fields + [("insertText", JsonString(call)), ("insertTextFormat", number(2))])
    }
    _ -> item
  }

  private isFunctionType(t: TypeRef): Boolean = when (t) {
    FunctionType(_, _, _, _) -> true
    else -> false
  }

  // The item as its name alone, where what's after it already calls it.
  private uncalled(item: Json): Json = when (item) {
    JsonObject(fields) -> JsonObject(
      fields.filter { key, _ -> key != "insertText" && key != "insertTextFormat" },
    )
    else -> item
  }

  private item(label: String, kind: Int, detail: String, edits: List<Json>): Json = JsonObject(
    [("label", JsonString(label)), ("kind", number(kind)), ("detail", JsonString(detail))] +
      (if (edits.isEmpty()) [] else [("additionalTextEdits", JsonArray(edits))]),
  )

  // The kinds of name the editor is told of, by their place here: LSP's own, with the colours
  // Kotlin gives what each is like.
  private tokenTypes: List<String> = [
    "namespace", "type", "class", "interface", "struct", "typeParameter", "parameter", "variable",
    "property", "enumMember", "function", "decorator",
  ]

  // Each name in the file, as LSP's semantic tokens say them: line, start and length, its kind,
  // and whether it's where it's declared; each from where the one before it starts.
  @FileSystem private tokensOf(session: Session, uri: String): List<Int> = {
    file = pathOf(uri)
    text = session.open.get(uri).getOrElse(readOrEmpty(file))
    lines = text.split("\n")
    facts = factsIn(session, file)
    parameters = facts.fold(emptyMap()) { m, f ->
      when (f) {
        Binds(_, at, _, _, _, _, parameter) -> m.put("${at.line} ${at.column}", parameter)
        else -> m
      }
    }
    local = (bound: Position) -> if (parameters.getOrDefault("${bound.line} ${bound.column}", false)) 6 else 7
    // What was noted is where it was in the text as it was checked: moved to where those lines are
    // now, and left out where they've changed since.
    moved = movedLines(session.checkedTexts.getOrDefault(file.value, text).split("\n"), lines)
    used = facts.flatMap { f ->
      when (f) {
        Means(_, at, length, symbol, _) -> tokenKindOf(symbol).toList().map { kind ->
          // An annotation, @Name, from its @.
          annotated = lines.getOrNone(
            at.line - 1,
          ).flatMap { it.toList().getOrNone(at.column - 2) } == Some('@')
          if (annotated) (at.line - 1, at.column - 2, length + 1, 11, 0) else (at.line - 1, at.column - 1, length, kind, 0)
        }
        Binds(_, at, length, _, _, _, parameter) -> [
          (at.line - 1, at.column - 1, length, if (parameter) 6 else 7, 1),
        ]
        Reads(_, at, length, _, bound, _) -> [(at.line - 1, at.column - 1, length, local(bound), 0)]
        TypeName(_, at, length, builtin) -> [
          (at.line - 1, at.column - 1, length, if (builtin) 2 else 5, 0),
        ]
        else -> []
      }
    }
    usedNow = used.flatMap { token ->
      (line, column, length, kind, modifiers) = token
      moved(line).toList().map { now -> (now, column, length, kind, modifiers) }
    }
    declared = if (file.value.endsWith(".fki")) interfaceTokens(text, lines)
    else when (Parser.parse(text)) {
      Ok(parsed) -> declarationTokens(parsed.declarations, lines)
      Error(_) -> []
    }
    // Each place once, the first said of it, in order.
    ordered = (declared + usedNow).fold((emptyMap(), [])) { seen, token ->
      (keys, kept) = seen
      (line, column, _, _, _) = token
      key = "$line $column"
      if (keys.containsKey(key)) seen else (keys.put(key, true), [token] + kept)
    }
    (_, kept) = ordered
    sorted = kept.sortedBy { token ->
      (line, column, _, _, _) = token
      line * 100000 + column
    }
    (_, _, encoded) = sorted.fold((0, 0, [])) { state, token ->
      (lastLine, lastColumn, out) = state
      (line, column, length, kind, modifiers) = token
      start = if (line == lastLine) column - lastColumn else column
      (line, column, [[line - lastLine, start, length, kind, modifiers]] + out)
    }
    encoded.reversed().flatMap { it }
  }

  // A library's interface's names, as its text alone says them, as nothing checks it: what it
  // declares, its functions' parameters, and the types its declarations are written with, the
  // language's own, type parameters, and the rest declared ones.
  private interfaceTokens(text: String, lines: List<String>): List<(Int, Int, Int, Int, Int)> =
    when (Parser.parseInterface(text)) {
      Ok(parsed) -> declarationTokens(parsed.declarations, lines) + writtenTypesIn(
        parsed.declarations,
        [],
      )
      Error(_) -> []
    }

  private builtinTypes: List<String> = [
    "Int", "Float", "String", "Char", "Boolean", "Unit", "Nothing", "Byte", "List", "Map", "Option",
    "Result", "Lazy", "Array",
  ]

  private writtenTypesIn(
    declarations: List<Declaration>,
    outer: List<String>,
  ): List<(Int, Int, Int, Int, Int)> =
    declarations.flatMap { d ->
      when (d.definition) {
        FunctionDefinition(typeParameters, receiver, parameters, result, _, _, _) -> {
          own = outer + typeParameters
          receiver.toList().flatMap { typeTokens(it, own) } + parameters.getOrElse([]).flatMap { p ->
            [
              (p.at.line - 1, p.at.column - 1, p.name.length, 6, 1),
            ] + p.parameterType.toList().flatMap { typeTokens(it, own) }
          } + result.toList().flatMap { typeTokens(it, own) }
        }
        RecordDefinition(typeParameters, fields, _, _, _) -> fields.flatMap { typeTokens(it.fieldType, outer + typeParameters) }
        CasesDefinition(typeParameters, cases, _, _) ->
          cases.flatMap { c -> c.fields.flatMap { typeTokens(it.fieldType, outer + typeParameters) } }
        AliasDefinition(typeParameters, target) -> typeTokens(target, outer + typeParameters)
        SpecDefinition(_, values, typeParameters, _, _) -> values.flatMap { v ->
          own = outer + typeParameters + v.typeParameters
          [(v.at.line - 1, v.at.column - 1, v.name.length, 10, 1)] + v.parameters.getOrElse(
            [],
          ).flatMap { p ->
            [
              (p.at.line - 1, p.at.column - 1, p.name.length, 6, 1),
            ] + p.parameterType.toList().flatMap { typeTokens(it, own) }
          } + typeTokens(v.valueType, own)
        }
        ModuleDefinition(inner, _, _, _, typeParameters) -> writtenTypesIn(
          inner,
          outer + typeParameters,
        )
        _ -> []
      }
    }

  private typeTokens(
    t: TypeRef,
    parameters: List<String>,
  ): List<(Int, Int, Int, Int, Int)> = when (t) {
    NamedType(at, name, arguments) -> {
      own = name.split(".").lastOrNone().getOrElse(name)
      kind = if (parameters.contains(name)) 5 else if (builtinTypes.contains(own)) 2 else 4
      [
        (at.line - 1, at.column - 1 + name.length - own.length, own.length, kind, 0),
      ] + arguments.flatMap { typeTokens(it, parameters) }
    }
    FunctionType(_, ps, result, _) -> ps.flatMap { typeTokens(it, parameters) } + typeTokens(result, parameters)
    TupleType(_, elements) -> elements.flatMap { typeTokens(it, parameters) }
    GivenType(_, _, given) -> typeTokens(given, parameters)
    _ -> []
  }

  // Where each line of before is in after, from 0: those before the first that changed, and those
  // after the last, as they were; none of those between.
  private movedLines(before: List<String>, after: List<String>): (Int) -> Option<Int> = {
    same = before.zip(after).takeWhile { a, b -> a == b }.size
    shorter = min(before.size, after.size) - same
    end = before.reversed().zip(after.reversed()).take(shorter).takeWhile { a, b -> a == b }.size
    shift = after.size - before.size
    (line: Int) ->
      if (line < same) Some(line)
      else if (line >= before.size - end) Some(line + shift)
      else None
  }

  // What a declared name is, as its kind of token: a function, a value, a type of each sort, a
  // case, a field, a module or a spec.
  private tokenKindOf(s: Symbol): Option<Int> = {
    owner = s.name.split(".").dropLast(
      1,
    ).lastOrNone().map { o -> o.toList().getOrNone(0).map { it.isUpperCase() }.getOrElse(false) }.getOrElse(false)
    when (s.declaration.definition) {
      FunctionDefinition(_, _, Some(_), _, _, _, _) -> Some(10)
      FunctionDefinition(_, _, None, _, _, _, _) -> Some(8)
      RecordDefinition(_, fields, _, annotation, _) ->
        if (owner && fields.any { it.name == s.declaration.name }) Some(8)
        else if (annotation) Some(11)
        else Some(4)
      CasesDefinition(_, cases, _, _) -> if (cases.any { it.name == s.declaration.name }) Some(
        9,
      ) else Some(
        3,
      )
      AliasDefinition(_, _) -> Some(1)
      SpecDefinition(_, _, _, _, _) -> Some(3)
      ModuleDefinition(_, _, _, _, _) -> Some(0)
      else -> None
    }
  }

  // Each declaration's own name, and its fields' and cases', where they're declared.
  private declarationTokens(
    declarations: List<Declaration>,
    lines: List<String>,
  ): List<(Int, Int, Int, Int, Int)> = declarations.flatMap { d ->
    name = d.name.split(".").lastOrNone().getOrElse(d.name)
    at = (p: Position, written: String, kind: Int) -> lines.getOrNone(p.line - 1).flatMap { line ->
      wordIn(
        line,
        written,
        p.column - 1,
      ).map { column -> (p.line - 1, column, written.length, kind, 1) }
    }.toList()
    when (d.definition) {
      FunctionDefinition(_, _, Some(_), _, _, _, _) -> at(d.at, name, 10)
      FunctionDefinition(_, _, None, _, _, _, _) -> at(d.at, name, 8)
      RecordDefinition(_, fields, _, annotation, _) ->
        at(d.at, name, if (annotation) 11 else 4) + fields.flatMap { f -> at(f.at, f.name, 8) }
      CasesDefinition(_, cases, _, _) -> at(d.at, name, 3) + cases.flatMap { c ->
        at(c.at, c.name, 9) + c.fields.flatMap { f -> at(f.at, f.name, 8) }
      }
      AliasDefinition(_, _) -> at(d.at, name, 1)
      SpecDefinition(_, _, _, _, _) -> at(d.at, name, 3)
      ModuleDefinition(inner, _, _, _, _) -> at(d.at, name, 0) + declarationTokens(inner, lines)
      else -> []
    }
  }

  // Each spec declared in the file, and each of its values, with what implements it, the modules
  // that follow it and their functions of its values' names; and each module declared in the file
  // that follows a spec, and each of its functions the spec has, with what it implements: as the
  // line and column of its name, what it is to them, and where they are.
  @FileSystem private specMarkers(
    session: Session,
    uri: String,
  ): List<(Int, Int, Int, String, List<Json>)> = {
    file = pathOf(uri).value
    programs = session.programs.getOrDefault(projectOf(pathOf(uri)).root.value, [])
    programs.flatMap { p -> p.environment.toList() }.firstOrNone().map { environment ->
      table = environment.definitions.namespace.table
      following = environment.moduleSpecs
      here = (s: Symbol) -> s.file.source.path == Some(file)
      modules = table.modules.values.flatMap { m ->
        when (m) {
          DeclaredModule(s) -> [s]
          _ -> []
        }
      }
      valuesOf = (spec: Symbol) -> when (spec.declaration.definition) {
        SpecDefinition(_, values, _, _, _) -> values
        _ -> []
      }
      named = (s: Symbol) -> s.declaration.name.split(".").lastOrNone().getOrElse(
        s.declaration.name,
      )
      at = (s: Symbol) -> nameOf(session, s).map { found ->
        (_, line, column) = found
        (line, column, named(s).length)
      }
      valueAt = (spec: Symbol, v: SpecValue) -> spec.file.source.text.lines().getOrNone(
        v.at.line - 1,
      ).flatMap { line ->
        wordIn(
          line,
          v.name,
          v.at.column - 1,
        ).map { column -> (v.at.line - 1, column, v.name.length) }
      }
      implemented = table.specs.values.filter { here(it) }.flatMap { spec ->
        followers = following.entries.filter { _, s -> s.name == spec.name }.flatMap { name, _ ->
          modules.filter { it.name == name }
        }
        if (followers.isEmpty()) []
        else {
          own = at(spec).toList().map { place ->
            (line, column, length) = place
            (line, column, length, "implemented", followers.flatMap { locationOf(it).toList() })
          }
          own + valuesOf(spec).flatMap { v ->
            targets = followers.flatMap { m -> environment.functions.get("${m.name}.${v.name}").toList() }
            if (targets.isEmpty()) []
            else valueAt(spec, v).toList().map { place ->
              (line, column, length) = place
              (line, column, length, "implemented", targets.flatMap { locationOf(it).toList() })
            }
          }
        }
      }
      implementing = modules.filter { here(it) }.flatMap { module ->
        following.get(module.name).toList().flatMap { spec ->
          own = at(module).toList().map { place ->
            (line, column, length) = place
            (line, column, length, "implements", locationOf(spec).toList())
          }
          own + valuesOf(spec).flatMap { v ->
            environment.functions.get("${module.name}.${v.name}").toList().flatMap { f ->
              target = valueAt(spec, v).map { place ->
                (line, column, length) = place
                location(spec.file.source.path.getOrElse(""), line, column, length)
              }
              at(f).toList().map { place ->
                (line, column, length) = place
                (line, column, length, "implements", target.toList())
              }
            }
          }
        }
      }
      implemented + implementing
    }.getOrElse([])
  }

  // What the projects last checked declare of their own whose names have query's letters in order,
  // as LSP's workspace symbols: each with its kind, where it is, and what it's in.
  @FileSystem private symbolsNamed(session: Session, query: String): List<Json> = {
    wanted = query.lowercase().toList()
    has = (name: String) -> wanted.fold(Some(name.lowercase().toList())) { left, c ->
      left.flatMap { rest ->
        i = rest.indexOfFirst { it == c }
        if (i < 0) None else Some(rest.drop(i + 1))
      }
    }.isSome()
    session.programs.values.flatMap { programs -> programs.flatMap { p -> p.environment.toList() }.take(1) }.flatMap { environment ->
      environment.definitions.namespace.table.declarations.filter { s ->
        s.file.source.project == ProgramProject && has(
          s.declaration.name.split(".").lastOrNone().getOrElse(""),
        )
      }
    }.fold(emptyMap()) { m, s -> m.put(s.name, s) }.values.take(200).flatMap { s ->
      locationOf(s).toList().map { where ->
        JsonObject([
          ("name", JsonString(s.declaration.name.split(".").lastOrNone().getOrElse(s.declaration.name))),
          ("kind", number(symbolKind(s.declaration.definition))),
          ("location", where),
          ("containerName", JsonString(s.name.split(".").dropLast(1).joinToString("."))),
        ])
      }
    }
  }

  // LSP's symbol kind for what's declared: a function, a value, a type of each sort, a module.
  private symbolKind(definition: Definition): Int = when (definition) {
    FunctionDefinition(_, _, Some(_), _, _, _, _) -> 12
    FunctionDefinition(_, _, None, _, _, _, _) -> 14
    RecordDefinition(_, _, _, _, _) -> 23
    CasesDefinition(_, _, _, _) -> 10
    AliasDefinition(_, _) -> 5
    SpecDefinition(_, _, _, _, _) -> 11
    ModuleDefinition(_, _, _, _, _) -> 2
    else -> 13
  }

  // The call the position is in: its function's signature, each parameter where it is in it, and
  // which one is being written, as what's before the position, back to the call's (, says.
  @FileSystem private signatureHelp(session: Session, uri: String, params: Json): Option<Json> = {
    (line, character) = positionOf(params)
    file = pathOf(uri)
    text = session.open.get(uri).getOrElse(readOrEmpty(file))
    lines = text.split("\n")
    offset = lines.take(line).map { it.length + 1 }.sum() + character
    chars = text.take(offset).toList()
    callOpen(chars, chars.size - 1, 0, 0).flatMap { found ->
      (open, commas) = found
      name = chars.take(
        open,
      ).reversed().dropWhile { it == ' ' }.takeWhile { isNameChar(it) }.reversed()
      start = open - (chars.take(open).reversed().takeWhile { it == ' ' }.size) - name.size
      nameLine = chars.take(start).filter { it == '\n' }.size
      nameColumn = chars.take(start).reversed().takeWhile { it != '\n' }.size
      written = name.map { it.toString() }.joinToString("")
      noted = factsIn(session, file).flatMap { f ->
        when (f) {
          Means(_, at, _, symbol, _) if at.line == nameLine + 1 && at.column == nameColumn + 1 -> [
            symbol,
          ]
          else -> []
        }
      }.firstOrNone()
      functions = session.programs.getOrDefault(
        projectOf(file).root.value,
        [],
      ).flatMap { it.functions }
      called = when (noted) {
        Some(s) -> functions.filter { it.function.name == s.name }.take(1)
        None -> functions.filter { f ->
          f.function.declaration.name.split(".").lastOrNone() == Some(
            written,
          ) && Signatures.isFunction(
            f.function,
          )
        }.fold(emptyMap()) { m, f -> m.put(f.function.name, f) }.values.take(5)
      }
      if (written.isEmpty() || called.isEmpty()) None
      else Some(JsonObject([
        ("signatures", JsonArray(called.map { f ->
          (label, effects) = signatureOf(f)
          JsonObject([
            ("label", JsonString(label)),
            ("documentation", JsonObject([
              ("kind", JsonString("markdown")),
              ("value", JsonString((effects.toList() + docsOf(f.function).toList()).joinToString("\n\n"))),
            ])),
            ("parameters", JsonArray(parameterRanges(label).map { r ->
              (from, to) = r
              JsonObject([("label", JsonArray([number(from), number(to)]))])
            })),
          ])
        })),
        ("activeSignature", number(0)),
        ("activeParameter", number(commas)),
      ]))
    }
  }

  // Where the call that's open at i opens, its (, and how many of its arguments come before i.
  private callOpen(chars: List<Char>, i: Int, depth: Int, commas: Int): Option<(Int, Int)> =
    when (chars.getOrNone(i)) {
      None -> None
      Some(c) if c == ')' || c == ']' || c == '}' -> callOpen(chars, i - 1, depth + 1, commas)
      Some(c) if c == '(' && depth == 0 -> Some((i, commas))
      Some(c) if c == '(' || c == '[' || c == '{' ->
        if (depth == 0) None else callOpen(chars, i - 1, depth - 1, commas)
      Some(',') if depth == 0 -> callOpen(chars, i - 1, depth, commas + 1)
      Some(_) -> callOpen(chars, i - 1, depth, commas)
    }

  // Where each parameter is in a signature, name(a: A, f: (B, C) -> D): R: from the first ( to
  // its ), split at its commas, but those in brackets of their own.
  private parameterRanges(label: String): List<(Int, Int)> = {
    chars = label.toList()
    open = chars.indexOfFirst { it == '(' }
    if (open < 0) []
    else rangesFrom(chars, open + 1, open + 1, 0, [])
  }

  private rangesFrom(
    chars: List<Char>,
    i: Int,
    start: Int,
    depth: Int,
    found: List<(Int, Int)>,
  ): List<(Int, Int)> = when (chars.getOrNone(i)) {
    None -> found
    Some(c) if (c == ')' || c == ']' || c == '>') && depth == 0 ->
      if (i > start) found + [(start, i)] else found
    Some(c) if c == '(' || c == '[' || c == '<' -> rangesFrom(chars, i + 1, start, depth + 1, found)
    Some(c) if c == ')' || c == ']' || c == '>' -> rangesFrom(chars, i + 1, start, depth - 1, found)
    Some(',') if depth == 0 -> rangesFrom(chars, i + 2, i + 2, depth, found + [(start, i)])
    Some(_) -> rangesFrom(chars, i + 1, start, depth, found)
  }

  // What would put right what the diagnostic says is wrong: an import it names, or an effect a
  // function must say it does.
  @FileSystem private fixes(session: Session, uri: String, diagnostic: Json): List<Json> = {
    message = diagnostic.field("message").flatMap { it.text }.getOrElse("")
    start = diagnostic.field("range").flatMap { it.field("start") }
    line = start.flatMap { it.field("line") }.flatMap { it.int }.getOrElse(0)
    character = start.flatMap { it.field("character") }.flatMap { it.int }.getOrElse(0)
    text = session.open.get(uri).getOrElse(readOrEmpty(pathOf(uri)))
    imports = if (!message.contains(" has one")) [] else message.substringAfter(";").split(
      "import ",
    ).drop(
      1,
    ).map { part ->
      part.toList().takeWhile { it != ',' && it != ' ' }.map { it.toString() }.joinToString("")
    }.filter { it.isNotEmpty() }
    importing = imports.map { name ->
      fix("Import $name", diagnostic, uri, importedAt(text), 0, "import $name\n")
    }
    said = message.substringAfter(
      " does @",
    ).toList().takeWhile { it.isLetterOrDigit() || it == '.' }
    e = said.map { it.toString() }.joinToString("")
    effect = if (!message.contains(", so it must say so") || e.isEmpty()) []
    else [fix("Say it does @$e", diagnostic, uri, line, character, "@$e ")]
    importing + effect
  }

  // The line a new import goes on: after the file's last, or first.
  private importedAt(text: String): Int =
    text.split(
      "\n",
    ).mapIndexed { i, l -> (i, l) }.filter { _, l -> l.startsWith("import ") }.lastOrNone().map { entry ->
      (i, _) = entry
      i + 1
    }.getOrElse(0)

  private fix(
    title: String,
    diagnostic: Json,
    uri: String,
    line: Int,
    character: Int,
    inserted: String,
  ): Json =
    JsonObject([
      ("title", JsonString(title)),
      ("kind", JsonString("quickfix")),
      ("diagnostics", JsonArray([diagnostic])),
      ("edit", JsonObject([("changes", JsonObject([(uri, JsonArray([JsonObject([
        ("range", range(line, character, line, character)),
        ("newText", JsonString(inserted)),
      ])]))]))])),
    ])

  // A local: the file it's in, where it's bound, its name and its type.
  private type LocalName(file: String, bound: Position, name: String, t: Type)

  // The local named, or bound, at params' position.
  @FileSystem private localAt(session: Session, uri: String, params: Json): Option<LocalName> = {
    (line, character) = positionOf(params)
    file = pathOf(uri).value
    under = (at: Position, length: Int) ->
      at.line == line + 1 && character + 1 >= at.column && character + 1 <= at.column + length
    factsIn(session, pathOf(uri)).flatMap { f ->
      when (f) {
        Binds(_, at, length, name, t, _, _) if under(at, length) -> [LocalName(file, at, name, t)]
        Reads(_, at, length, name, bound, t) if under(at, length) -> [
          LocalName(file, bound, name, t),
        ]
        else -> []
      }
    }.firstOrNone()
  }

  // Where the local is bound, and each place it's read or changed.
  @FileSystem private localUses(session: Session, l: LocalName): List<Position> =
    [l.bound] + factsIn(session, path(l.file)).flatMap { f ->
      when (f) {
        Reads(_, at, _, _, bound, _) if bound == l.bound -> [at]
        else -> []
      }
    }

  private type Meaning(at: Position, length: Int, symbol: Symbol, t: Option<Type>)

  @FileSystem private meansAt(session: Session, uri: String, params: Json): Option<Meaning> = {
    (line, character) = positionOf(params)
    file = pathOf(uri).value
    factsIn(session, pathOf(uri)).flatMap { f ->
      when (f) {
        Means(in, at, length, symbol, t) ->
          if (in == Some(file) && at.line == line + 1 && character + 1 >= at.column && character + 1 <= at.column + length)
            [Meaning(at, length, symbol, t)]
          else []
        else -> []
      }
    }.firstOrNone()
  }

  // Where s is used, each as the file, where, and how long the name is there.
  @FileSystem private usesOf(
    session: Session,
    uri: String,
    s: Symbol,
  ): List<(String, Position, Int)> =
    factsOf(session, pathOf(uri)).flatMap { f ->
      when (f) {
        Means(Some(file), at, length, symbol, _) if symbol.name == s.name -> [(file, at, length)]
        else -> []
      }
    }

  // The name, its type, and what calling it there does.
  @FileSystem private hover(session: Session, uri: String, params: Json): Option<Json> =
    meansAt(session, uri, params).map { m ->
      file = pathOf(uri).value
      checked = checkedOf(session, uri, m.symbol)
      does = factsIn(session, pathOf(uri)).flatMap { f ->
        when (f) {
          Does(
            Some(in),
            at,
            row,
          ) if in == file && at.line == m.at.line && at.column == m.at.column + m.length ->
            row.labels.map { it.name }
          else -> []
        }
      }
      written = when (checked) {
        Some(f) -> signatureOf(f)
        None -> (m.symbol.declaration.name + m.t.map { t -> ": " + Solutions.solving { TypeText.shown(t) } }.getOrElse(""), None)
      }
      (signature, effects) = written
      said = "```fckt\n$signature\n```" + effects.map { "\n\n$it" }.getOrElse("") +
        (if (does.isEmpty()) "" else "\n\nThis call does ${Doings.shown(does)}.") +
        docsOf(m.symbol).map { "\n\n---\n\n$it" }.getOrElse("")
      JsonObject(
        [("contents", JsonObject([("kind", JsonString("markdown")), ("value", JsonString(said))]))],
      )
    }.orElse {
      named(session, uri, params).map { f ->
        JsonObject([
          ("contents", JsonObject([
            ("kind", JsonString("markdown")),
            ("value", JsonString(hoverText(signatureOf(f)) + docsOf(f.function).map { "\n\n---\n\n$it" }.getOrElse(""))),
          ])),
        ])
      }
    }

  private hoverText(written: (String, Option<String>)): String = {
    (signature, effects) = written
    "```fckt\n$signature\n```" + effects.map { "\n\n$it" }.getOrElse("")
  }

  // A function as it's called, with its parameters' names and what it gives, its receiver's type
  // first if it extends one; and, if it's a function, what calling it does: its effects, and those
  // of the functions it's given that it calls, or nothing. A value as its name and type.
  private signatureOf(f: CheckedFunction): (String, Option<String>) = Solutions.solving {
    s = f.function
    name = s.declaration.name.split(".").lastOrNone().getOrElse(s.declaration.name)
    // Its unknowns named A, B, ... as they first come, as one signature, rather than each part
    // numbered its own.
    names = Types.variablesIn(f.scheme.template).fold(
      [],
    ) { seen, v -> if (seen.contains(v)) seen else seen + [v] }
    named = names.mapIndexed { i, v -> (v, TypeParameter(letterName(i))) }.toMap()
    // What it does is told from its own unknowns, which naming them for showing doesn't keep.
    (row, written) = when (f.scheme.template) {
      FunctionOf(own, _, does) -> (does, own)
      _ -> (Row([], None), [])
    }
    when (Types.substitute(f.scheme.template, named)) {
      FunctionOf(types, result, _) -> {
        extending = Signatures.receiverOf(s).isSome()
        receiver = if (extending) types.firstOrNone().map { TypeText.shown(it) + "." }.getOrElse("") else ""
        given = if (extending) types.drop(1) else types
        writtenParameters = Signatures.writtenParametersOf(s)
        parameters = writtenParameters.map { ps ->
          "(" + ps.zip(
            given,
          ).map { p, t -> "${p.name}: ${TypeText.shown(t)}" }.joinToString(", ") + ")"
        }.getOrElse("")
        labels = row.labels.map { it.name }
        ownGiven = if (extending) written.drop(1) else written
        carriers = writtenParameters.getOrElse([]).zip(ownGiven).filter { _, t ->
          when (t) {
            FunctionOf(_, _, theirs) -> row.rest.isSome() && theirs.rest == row.rest
            else -> false
          }
        }.map { p, _ -> p.name }
        theirs = "what ${carriers.joinToString(" and ")} does"
        effects = if (labels.isEmpty() && carriers.isEmpty()) "pure"
        else if (labels.isEmpty()) "does $theirs"
        else if (carriers.isEmpty()) "does ${Doings.shown(labels)}"
        else "does ${Doings.shown(labels)} and $theirs"
        ("$receiver$name$parameters: ${TypeText.shown(result)}", Some(effects))
      }
      t -> ("$name: ${TypeText.shown(t)}", None)
    }
  }

  // A, B, ..., Z, then A1, B1, ...
  private letterName(i: Int): String =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ".drop(i % 26).take(1) + (if (i < 26) "" else "${i / 26}")

  @FileSystem private checkedOf(session: Session, uri: String, s: Symbol): Option<CheckedFunction> =
    session.programs.getOrDefault(
      projectOf(pathOf(uri)).root.value,
      [],
    ).flatMap { it.functions }.find {
      it.function.name == s.name
    }

  // Where the name s is declared with is, in its file: the line and column, from 0.
  @FileSystem private nameOf(
    session: Session,
    s: Symbol,
  ): Option<(String, Int, Int)> = s.file.source.path.flatMap { file ->
    text = session.open.get(uriOf(file)).getOrElse(readOrEmpty(path(file)))
    lines = text.split("\n")
    name = s.declaration.name.split(".").lastOrNone().getOrElse(s.declaration.name)
    start = s.declaration.at.line - 1
    [start, start + 1, start + 2, start + 3].flatMap { n ->
      from = if (n == start) s.declaration.at.column - 1 else 0
      lines.getOrNone(
        n,
      ).toList().flatMap { line -> wordIn(line, name, from).map { (n, it) }.toList() }
    }.firstOrNone().map { found ->
      (n, column) = found
      (file, n, column)
    }
  }

  // Where name is in line, as a word of its own, from column on.
  private wordIn(line: String, name: String, column: Int): Option<Int> = {
    found = line.drop(column).indexOf(name)
    i = if (found < 0) -1 else found + column
    isName = (c: Option<Char>) -> c.map { it.isLetterOrDigit() || it == '_' }.getOrElse(false)
    if (i < 0) None
    else if (isName(line.toList().getOrNone(i - 1)) || isName(line.toList().getOrNone(i + name.length))) wordIn(
      line,
      name,
      i + 1,
    )
    else Some(i)
  }

  @FileSystem private locationOf(s: Symbol): Option<Json> = s.file.source.path.map { file ->
    at = s.declaration.at
    location(file, at.line - 1, at.column - 1, 0)
  }

  private location(file: String, line: Int, column: Int, length: Int): Json = JsonObject([
    ("uri", JsonString(uriOf(file))),
    ("range", range(line, column, line, column + length)),
  ])

  // Every use of s, and its declaration, named newName: only if it's the program's own.
  @FileSystem private renamed(session: Session, uri: String, s: Symbol, newName: String): Json =
    if (s.file.source.project != ProgramProject) JsonNull
    else {
      uses = usesOf(session, uri, s).map { use ->
        (file, at, length) = use
        (file, at.line - 1, at.column - 1, length)
      }
      declared = nameOf(session, s).map { found ->
        (file, line, column) = found
        (file, line, column, s.declaration.name.split(".").lastOrNone().getOrElse("").length)
      }.toList()
      edits = (declared + uses).distinct().fold(emptyMap()) { byFile, edit ->
        (file, line, column, length) = edit
        change = JsonObject(
          [("range", range(line, column, line, column + length)), ("newText", JsonString(newName))],
        )
        byFile.put(uriOf(file), byFile.getOrDefault(uriOf(file), []) + [change])
      }
      JsonObject(
        [("changes", JsonObject(edits.entries.map { u, changes -> (u, JsonArray(changes)) }))],
      )
    }

  // What the checker worked out of each function declared in the file that it doesn't say: the
  // effects it does, before its name, and what it gives, after its parameters.
  @FileSystem private hints(session: Session, uri: String): List<Json> = {
    file = pathOf(uri).value
    text = session.open.get(uri).getOrElse(readOrEmpty(pathOf(uri)))
    lines = text.split("\n")
    own = session.programs.getOrDefault(
      projectOf(pathOf(uri)).root.value,
      [],
    ).flatMap { it.functions }.filter {
      it.function.file.source.path == Some(file)
    }
    // Where the locals were bound when the file was checked, moved to where those lines are now.
    moved = movedLines(session.checkedTexts.getOrDefault(file, text).split("\n"), lines)
    locals = factsIn(session, pathOf(uri)).flatMap { fact ->
      when (fact) {
        Binds(_, at, length, _, t, false, _) -> moved(at.line - 1).toList().map { line ->
          hint(line, at.column - 1 + length, ": ${Solutions.solving { TypeText.shown(t) }}")
        }
        else -> []
      }
    }
    locals + own.fold(emptyMap()) { m, f -> m.put(f.function.name, f) }.values.flatMap { f ->
      d = f.function.declaration
      written = d.annotations.map { it.name }
      when ((d.definition, nameOf(session, f.function))) {
        (FunctionDefinition(_, _, parameters, result, _, None, _), Some(found)) -> {
          (_, line, column) = found
          name = d.name.split(".").lastOrNone().getOrElse(d.name)
          (results, does) = Solutions.solving {
            when (f.scheme.template) {
              FunctionOf(_, r, row) -> (TypeText.shown(r), row.labels.map { it.name })
              other -> (TypeText.shown(other), [])
            }
          }
          unsaid = does.filter { e -> !written.contains(e.split(".").lastOrNone().getOrElse(e)) }
          effects = if (unsaid.isEmpty()) [] else [hint(line, column, Doings.shown(unsaid) + " ")]
          after = if (parameters.isSome()) closing(lines, line, column + name.length) else Some(
            (line, column + name.length),
          )
          gives = if (result.isSome()) [] else after.map { end ->
            (l, c) = end
            hint(l, c, ": $results")
          }.toList()
          effects + gives
        }
        _ -> []
      }
    }
  }

  private hint(line: Int, column: Int, label: String): Json = JsonObject([
    ("position", JsonObject([("line", number(line)), ("character", number(column))])),
    ("label", JsonString(label)),
  ])

  // Where the parameters that open at or after line and column close: just after their ).
  private closing(lines: List<String>, line: Int, column: Int): Option<(Int, Int)> =
    closingFrom(lines, line, column, 0, false)

  private closingFrom(
    lines: List<String>,
    line: Int,
    column: Int,
    depth: Int,
    opened: Boolean,
  ): Option<(Int, Int)> = when (lines.getOrNone(line)) {
    None -> None
    Some(text) -> when (text.toList().getOrNone(column)) {
      None -> closingFrom(lines, line + 1, 0, depth, opened)
      Some('(') -> closingFrom(lines, line, column + 1, depth + 1, true)
      Some(')') -> if (depth == 1) Some((line, column + 1)) else closingFrom(
        lines,
        line,
        column + 1,
        depth - 1,
        opened,
      )
      Some(_) -> if (!opened && column > 0 && text.toList().getOrNone(column) == Some('=')) None
      else closingFrom(lines, line, column + 1, depth, opened)
    }
  }

  // Where f is declared, as LSP says where.
  private definitionOf(f: CheckedFunction): Option<Json> = f.function.file.source.path.map { file ->
    at = f.function.declaration.at
    JsonObject([
      ("uri", JsonString(uriOf(file))),
      ("range", range(at.line - 1, at.column - 1, at.line - 1, at.column - 1)),
    ])
  }

  // What the name being written at params' position could be, of the functions and values the
  // project last checked has: after Module., what that module declares; otherwise those whose
  // names start with what's written. Each with its type.
  @FileSystem @Channel @Process private completions(
    session: Session,
    uri: String,
    params: Json,
  ): List<Json> = {
    (line, character) = positionOf(params)
    file = pathOf(uri)
    text = session.open.get(uri).getOrElse(readOrEmpty(file))
    written = text.split("\n").getOrNone(line).getOrElse("")
    before = written.take(character).toList()
    prefix = before.reversed().takeWhile { isNameChar(it) }.reversed()
    rest = before.dropLast(prefix.size)
    typed = prefix.map { it.toString() }.joinToString("")
    found = offered(session, uri, line, character, file, text, written, rest, prefix, typed)
    // A name already followed by ( is called as it's written.
    after = written.drop(character).toList().dropWhile { isNameChar(it) }.firstOrNone()
    if (after == Some('(')) found.map { uncalled(it) } else found
  }

  @FileSystem @Channel @Process private offered(
    session: Session,
    uri: String,
    line: Int,
    character: Int,
    file: Path,
    text: String,
    written: String,
    rest: List<Char>,
    prefix: List<Char>,
    typed: String,
  ): List<Json> =
    if (rest.lastOrNone() != Some('.')) declaredOrBound(session, uri, line, file, text, None, typed)
    else {
      dot = rest.size - 1
      when (receiverIn(rest.dropLast(1))) {
        ModuleNamed(name) -> declaredOrBound(session, uri, line, file, text, Some(name), typed)
        NoReceiver -> []
        receiver -> {
          known = typeOfReceiver(session, file, line, receiver)
          t = if (known.isSome()) known
          else {
            // What's before the dot hasn't been checked as it's written: it's checked now, without
            // the dot, so the code can be read.
            lines = text.split("\n")
            trimmed = lines.mapIndexed { i, l -> if (i == line) written.take(dot) + written.drop(character) else l }
            session.open = session.open.put(uri, trimmed.joinToString("\n"))
            attempt { check(session, uri, false) }
            session.open = session.open.put(uri, text)
            typeOfReceiver(session, file, line, receiver)
          }
          t.map { members(session, uri, it, typed) }.getOrElse([])
        }
      }
    }

  private isNameChar(c: Char): Boolean = c.isLetterOrDigit() || c == '_'

  // What's before a dot: a module, by its name; a local or value, by its name and column; or a
  // call, an index or a member, at its ( or [ or its name; or nothing that has members.
  private type Receiver {
    ModuleNamed(name: String),
    NameAt(name: String, column: Int),
    ExpressionAt(column: Int),
    // Brackets, open and close, around what's in them.
    GroupAt(open: Int, close: Int),
    NoReceiver,
  }

  private receiverIn(chars: List<Char>): Receiver = when (chars.lastOrNone()) {
    Some(')') -> openerOf(chars, '(', ')').map { open ->
      // A call's ( follows what's called; otherwise the brackets only group what's in them.
      called = chars.take(open).reversed().dropWhile { it == ' ' }.firstOrNone().map { c ->
        isNameChar(c) || c == ')' || c == ']' || c == '}' || c == '>'
      }.getOrElse(false)
      if (called) ExpressionAt(open) else GroupAt(open, chars.size - 1)
    }.getOrElse(NoReceiver)
    Some(']') -> openerOf(chars, '[', ']').map { ExpressionAt(it) }.getOrElse(NoReceiver)
    Some('"') -> openingQuote(chars, chars.size - 2).map { ExpressionAt(it) }.getOrElse(NoReceiver)
    Some('}') -> openerOf(chars, '{', '}').map { ExpressionAt(it) }.getOrElse(NoReceiver)
    Some(c) if isNameChar(c) -> {
      name = chars.reversed().takeWhile { isNameChar(it) }.reversed()
      start = chars.size - name.size
      text = name.map { it.toString() }.joinToString("")
      if (chars.getOrNone(start - 1) == Some('.')) ExpressionAt(start)
      else if (name.firstOrNone().map { it.isUpperCase() }.getOrElse(false)) ModuleNamed(text)
      else NameAt(text, start)
    }
    _ -> NoReceiver
  }

  // Where the string that ends before i, its closing quote, opens.
  private openingQuote(chars: List<Char>, i: Int): Option<Int> = when (chars.getOrNone(i)) {
    None -> None
    Some('"') -> if (chars.getOrNone(i - 1) == Some('\\')) openingQuote(chars, i - 1) else Some(i)
    Some(_) -> openingQuote(chars, i - 1)
  }

  // Where the bracket that the one chars ends with closes opens, on the same line.
  private openerOf(chars: List<Char>, open: Char, close: Char): Option<Int> =
    openerFrom(chars, chars.size - 1, open, close, 0)

  private openerFrom(chars: List<Char>, i: Int, open: Char, close: Char, depth: Int): Option<Int> =
    when (chars.getOrNone(i)) {
      None -> None
      Some(c) if c == close -> openerFrom(chars, i - 1, open, close, depth + 1)
      Some(c) if c == open -> if (depth == 1) Some(i) else openerFrom(
        chars,
        i - 1,
        open,
        close,
        depth - 1,
      )
      Some(_) -> openerFrom(chars, i - 1, open, close, depth)
    }

  // The receiver's type, as the project was last checked.
  @FileSystem private typeOfReceiver(
    session: Session,
    file: Path,
    line: Int,
    receiver: Receiver,
  ): Option<Type> =
    when (receiver) {
      NameAt(name, column) -> receiverOf(
        session,
        file,
        line,
        column,
        name,
        session.programs.getOrDefault(projectOf(file).root.value, []),
      )
      ExpressionAt(column) -> factsIn(session, file).flatMap { f ->
        when (f) {
          Gives(_, at, t) if at.line == line + 1 && at.column == column + 1 -> [t]
          else -> []
        }
      }.firstOrNone()
      // What's in the brackets is what was noted last in them, as each is noted after what's in it.
      GroupAt(open, close) -> factsIn(session, file).flatMap { f ->
        when (f) {
          Gives(
            _,
            at,
            t,
          ) if at.line == line + 1 && at.column > open + 1 && at.column < close + 1 -> [
            t,
          ]
          else -> []
        }
      }.firstOrNone()
      _ -> None
    }

  // The module name means where the file is: as its imports and package say.
  @FileSystem private moduleOf(session: Session, file: Path, name: String): Option<String> =
    session.programs.getOrDefault(projectOf(file).root.value, []).flatMap { p ->
      p.workspace.files.find { it.source.path == Some(file.value) }.toList().flatMap { loaded ->
        namespace = p.environment.map { it.definitions.namespace }
        namespace.toList().flatMap { n ->
          when (Lookups.found(Lookups.moduleNamed(name, Place(loaded, []), n, Skipping))) {
            Some(DeclaredModule(m)) -> [m.name]
            _ -> []
          }
        }
      }
    }.firstOrNone()

  @FileSystem private declaredOrBound(
    session: Session,
    uri: String,
    line: Int,
    file: Path,
    text: String,
    owner: Option<String>,
    typed: String,
  ): List<Json> = {
    module = owner.flatMap { name -> moduleOf(session, file, name) }
    functions = session.programs.getOrDefault(
      projectOf(file).root.value,
      [],
    ).flatMap { it.functions }
    candidates = functions.filter { f ->
      name = f.function.declaration.name
      inOwner = when (owner) {
        Some(o) -> when (module) {
          Some(m) -> f.function.path.joinToString(".") == m
          None -> f.function.path.lastOrNone() == Some(o)
        }
        None -> f.function.path.isEmpty() || f.function.file.source.path == Some(file.value)
      }
      sameFile = f.function.file.source.path == Some(file.value)
      visible = sameFile || f.function.declaration.visibility != Private
      inOwner && visible && name.startsWith(typed) && !name.contains("__")
    }
    modules = if (owner.isSome()) []
    else functions.mapNotNull { it.function.path.lastOrNone() }.filter { m ->
      m.startsWith(typed) && m.getOrNone(0).map { it.isUpperCase() }.getOrElse(false) &&
        !m.contains("__")
    }.distinct().take(100).map { m -> JsonObject([("label", JsonString(m)), ("kind", number(9))]) }
    own = if (owner.isSome()) [] else localsAbove(session, uri, line, typed)
    more = if (owner.isSome()) [] else importable(session, uri, typed, text)
    own + modules + more + candidates.fold(
      emptyMap(),
    ) { m, f -> m.put(f.function.declaration.name, f) }.values.take(200).map { f ->
      name = f.function.declaration.name
      kind = when (f.function.declaration.definition) {
        FunctionDefinition(_, _, Some(_), _, _, _, _) -> 3
        else -> 6
      }
      documented(
        called(item(name, kind, typeOf(f), []), name, Signatures.writtenParametersOf(f.function)),
        docsOf(f.function),
      )
    }
  }

  // A declaration, as an editor's outline shows it: its name, what kind it is, its line, and what
  // a module declares, in it.
  private symbolOf(d: Declaration, text: String): Json = {
    line = d.at.line - 1
    width = text.split("\n").getOrNone(line).map { it.length }.getOrElse(0)
    column = max(0, d.at.column - 1)
    // Where the name is, as a module's declaration starts at module.
    found = text.split("\n").getOrNone(line).getOrElse("").drop(column).indexOf(d.name)
    start = if (found >= 0) column + found else column
    inner = when (d.definition) {
      ModuleDefinition(declarations, _, _, _, _) -> declarations.map { symbolOf(it, text) }
      else -> []
    }
    JsonObject([
      ("name", JsonString(d.name)),
      ("kind", number(kindOf(d.definition))),
      ("range", range(line, 0, line, width)),
      ("selectionRange", range(line, start, line, min(width, start + d.name.length))),
      ("children", JsonArray(inner)),
    ])
  }

  // LSP's kind of symbol: a module, a function, a value, a type with cases, a record, or a spec.
  private kindOf(definition: Definition): Int = when (definition) {
    ModuleDefinition(_, _, _, _, _) -> 2
    FunctionDefinition(_, _, Some(_), _, _, _, _) -> 12
    FunctionDefinition(_, Some(_), None, _, _, _, _) -> 7
    FunctionDefinition(_, _, _, _, _, _, _) -> 14
    CasesDefinition(_, _, _, _) -> 10
    RecordDefinition(_, _, _, _, _) -> 23
    AliasDefinition(_, _) -> 26
    SpecDefinition(_, _, _, _, _) -> 11
  }

  // The name the character at column is in, or "".
  private wordAt(line: String, column: Int): String = {
    cs = line.toList()
    isName = (c: Char) -> c.isLetterOrDigit() || c == '_'
    start = cs.take(column).reversed().takeWhile { isName(it) }.size
    end = cs.drop(column).takeWhile { isName(it) }.size
    cs.drop(column - start).take(start + end).map { it.toString() }.joinToString("")
  }

  private typeOf(
    f: CheckedFunction,
  ): String = Solutions.solving { TypeText.shown(f.scheme.template) }

  // The source's text: as it is in the editor, if it's open there.
  private editing(session: Session, source: SourceText): String =
    session.open.get(uriOf(source.path.getOrElse(""))).getOrElse(source.text)

  // The folder with build.fk at or above file's, its folders and libraries as .kiln/paths says;
  // and, for a file in a folder a scope in .kiln/scopes names, as a plugin's tests are, that
  // folder, and the libraries its files see too.
  @FileSystem private projectOf(file: Path): Project = {
    start = file.parent.getOrElse(path("."))
    root = rootAbove(start).getOrElse(start)
    paths = root.resolve(".kiln/paths")
    if (paths.exists()) {
      lines = paths.readLines()
      scopes = root.resolve(".kiln/scopes")
      scoped = (if (scopes.isDirectory()) scopes.listFiles() else []).map { it.readLines() }.filter {
        scope -> scope.filter { it.startsWith("folder ") }.any { line ->
          file.value.startsWith(at(root, line.removePrefix("folder ")).value + "/")
        }
      }.flatMap { it }
      Project(
        root,
        (lines + scoped).filter { it.startsWith("source ") || it.startsWith("folder ") }.map { line ->
          at(root, line.substringAfter(" "))
        }.filter { it.isDirectory() }.distinct(),
        (lines + scoped).filter { it.startsWith("library ") }.map {
          path(it.removePrefix("library "))
        }.distinct(),
      )
    }
    else Project(root, [root.resolve("src")].filter { it.isDirectory() }, [])
  }

  private at(root: Path, folder: String): Path =
    if (folder.startsWith("/")) path(folder) else root.resolve(folder)

  @FileSystem private rootAbove(folder: Path): Option<Path> =
    if (folder.resolve("build.fk").exists()) Some(folder)
    else when (folder.parent) {
      Some(up) if up.value != folder.value -> rootAbove(up)
      _ -> None
    }

  @FileSystem private readOrEmpty(file: Path): String = if (file.exists()) file.readText() else ""

  // A diagnostic, as LSP has it: from where fckt says, to the end of the word there.
  private shown(d: Diagnostic, text: String): Json = {
    line = max(d.at.line - 1, 0)
    column = max(d.at.column - 1, 0)
    rest = text.split("\n").getOrNone(line).map { it.drop(column) }.getOrElse("")
    word = rest.toList().takeWhile { it.isLetterOrDigit() || it == '_' }.size
    JsonObject([
      ("range", range(line, column, line, column + max(word, 1))),
      ("severity", number(1)),
      ("source", JsonString("fckt")),
      ("message", JsonString(d.message)),
    ])
  }

  private range(startLine: Int, startColumn: Int, endLine: Int, endColumn: Int): Json =
    JsonObject([
      ("start", JsonObject([("line", number(startLine)), ("character", number(startColumn))])),
      ("end", JsonObject([("line", number(endLine)), ("character", number(endColumn))])),
    ])

  @Channel private publish(uri: String, diagnostics: List<Json>): Unit = sent(JsonObject([
    ("jsonrpc", JsonString("2.0")),
    ("method", JsonString("textDocument/publishDiagnostics")),
    ("params", JsonObject([("uri", JsonString(uri)), ("diagnostics", JsonArray(diagnostics))])),
  ]))

  // Asks the editor to do what method says, which it answers with nothing this needs.
  @Channel private asked(method: String): Unit = sent(JsonObject([
    ("jsonrpc", JsonString("2.0")),
    ("id", JsonString(method)),
    ("method", JsonString(method)),
  ]))

  @Channel private answer(id: Option<Json>, result: Json): Unit = sent(JsonObject([
    ("jsonrpc", JsonString("2.0")),
    ("id", id.getOrElse(JsonNull)),
    ("result", result),
  ]))

  @Channel private refuse(id: Option<Json>, method: String): Unit = sent(JsonObject([
    ("jsonrpc", JsonString("2.0")),
    ("id", id.getOrElse(JsonNull)),
    ("error", JsonObject([
      ("code", number(-32601)),
      ("message", JsonString("fckt doesn't do $method")),
    ])),
  ]))

  // The next message, or None once the editor has closed the input.
  @Channel private received(): Option<Json> = headers(None).flatMap { length ->
    Jsons.parse(readFrom(standardInput, length).decodeToString())
  }

  // The headers, up to the blank line after them: the length of what follows.
  @Channel private headers(length: Option<Int>): Option<Int> =
    when (readLineFrom(standardInput)) {
      None -> None
      Some(raw) -> {
        line = raw.removeSuffix("\r")
        if (line.isEmpty()) (if (length.isSome()) length else headers(length))
        else if (line.lowercase().startsWith("content-length:")) headers(
          line.substringAfter(":").trim().toIntOrNone(),
        )
        else headers(length)
      }
    }

  @Channel private sent(message: Json): Unit = {
    body = Jsons.render(message).encodeToBytes()
    writeTo(standardOutput, "Content-Length: ${body.size}\r\n\r\n".encodeToBytes() + body)
    flushed(Unit)
  }

  private external flushed(u: Unit): Unit = "(fun _ -> flush stdout) u"

  // The file a file: URI names, its escapes, as %20, undone.
  private pathOf(uri: String): Path = path(unescaped(uri.removePrefix("file://").toList()))

  private uriOf(file: String): String =
    "file://" + file.toList().map { c -> if (c == ' ') "%20" else c.toString() }.joinToString("")

  private unescaped(cs: List<Char>): String = when (cs) {
    ['%', a, b, *rest] -> when ((hexDigit(a), hexDigit(b))) {
      (Some(high), Some(low)) -> (high * 16 + low).toChar().toString() + unescaped(rest)
      _ -> "%" + unescaped([a, b] + rest)
    }
    [c, *rest] -> c.toString() + unescaped(rest)
    [] -> ""
  }

  private hexDigit(c: Char): Option<Int> =
    if (c.isDigit()) Some(c.code - 48)
    else if (c >= 'a' && c <= 'f') Some(c.code - 87)
    else if (c >= 'A' && c <= 'F') Some(c.code - 55)
    else None
}
