import fckt.collections.Maps.*
import fckt.io.Channel
import fckt.io.Channels.*
import fckt.io.FileSystem
import fckt.io.Path
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Process
import fckt.effects.Failure.attempt
import fckt.text.Encodings.*
import fckt.checker.Checker
import fckt.parser.Parser
import fckt.checker.diagnostics.Diagnostic
import fckt.checker.sources.*
import fckt.compiler.Sources.*
import fckt.compiler.Jsons.*

// fckt --language-server: the Language Server Protocol, on standard input and output, for any
// editor that speaks it. Each file opened, changed or saved has its project checked, with what's
// open as it is in the editor, and what's wrong said of each of its files; and a file is laid out
// as fckt --format lays it out. A project is the folder with build.fk above the file, its folders
// and libraries as kiln last wrote them, in .kiln/paths; or, without kiln's, the file's folder.
module LanguageServer {
  // What's open, by URI, and the URIs said to have something wrong, by the project they're in.
  private type Session(
    var open: Map<String, String>,
    var said: Map<String, List<String>>,
    var stopping: Boolean,
  )

  // A project: the folders of its own packages, and the libraries' interfaces.
  private type Project(root: Path, folders: List<Path>, libraries: List<Path>)

  @FileSystem @Channel @Process serve(): Unit = served(Session(emptyMap(), emptyMap(), false))

  @FileSystem @Channel @Process private served(session: Session): Unit = when (received()) {
    None -> exit(if (session.stopping) 0 else 1)
    Some(message) -> {
      handled(session, message)
      served(session)
    }
  }

  @FileSystem @Channel @Process private handled(session: Session, message: Json): Unit = {
    id = message.field("id")
    params = message.field("params").getOrElse(JsonNull)
    uri = params.field("textDocument").flatMap { it.field("uri") }.flatMap { it.text }
    when (message.field("method").flatMap { it.text }.getOrElse("")) {
      "initialize" -> answer(id, JsonObject([
        ("capabilities", JsonObject([
          ("textDocumentSync", number(1)),
          ("documentFormattingProvider", JsonBoolean(true)),
        ])),
        ("serverInfo", JsonObject([("name", JsonString("fckt"))])),
      ]))
      "shutdown" -> {
        session.stopping = true
        answer(id, JsonNull)
      }
      "exit" -> exit(if (session.stopping) 0 else 1)
      "textDocument/didOpen" -> uri.forEach { u ->
        text = params.field("textDocument").flatMap { it.field("text") }.flatMap { it.text }
        session.open = session.open.put(u, text.getOrElse(""))
        checked(session, u)
      }
      "textDocument/didChange" -> uri.forEach { u ->
        changes = params.field("contentChanges").map { it.items }.getOrElse([])
        changes.lastOrNone().flatMap { it.field("text") }.flatMap { it.text }.forEach { text ->
          session.open = session.open.put(u, text)
        }
        checked(session, u)
      }
      "textDocument/didSave" -> uri.forEach { checked(session, it) }
      "textDocument/didClose" -> uri.forEach { u -> session.open = session.open.remove(u) }
      "textDocument/formatting" -> answer(id, JsonArray(uri.flatMap { u ->
        session.open.get(u).flatMap { text ->
          laid = Layout.formatted(text)
          if (laid == text) None else Some(whole(text, laid))
        }
      }.toList()))
      method -> if (id.isSome() && !method.startsWith("$/")) refuse(id, method) else Unit
    }
  }

  // An edit that replaces all of text with laid.
  private whole(text: String, laid: String): Json = {
    lines = text.split("\n")
    JsonObject([
      ("range", range(0, 0, lines.size, 0)),
      ("newText", JsonString(laid)),
    ])
  }

  // check, which, if it can't be done, as the core can't be found, is let be, and said.
  @FileSystem @Channel @Process private checked(session: Session, uri: String): Unit =
    when (attempt { check(session, uri) }) {
      Ok(_) -> Unit
      Error(why) -> printError("fckt: can't check $uri: $why")
    }

  // The project the file at uri is in, checked, and what's wrong with each of its files said: none,
  // for those it said something of before that are right now.
  @FileSystem @Channel @Process private check(session: Session, uri: String): Unit = {
    file = pathOf(uri)
    project = projectOf(file)
    folders = if (project.folders.any { file.value.startsWith(it.value + "/") }) project.folders
    else project.folders + file.parent.toList()
    own = folders.flatMap { dir ->
      packagesIn(dir, [], ProgramProject, "${dir.value}/").map { pkg, sources ->
        (pkg, sources.map { s -> s.copy(text = editing(session, s)) })
      }
    }
    libraries = project.libraries.filter { it.resolve("unit").exists() }.flatMap {
      interfacesIn(it)
    }
    std = if (libraries.isEmpty()) standard(home()) else []
    imported = own.filter { pkg, sources -> pkg.isNotEmpty() && sources.isNotEmpty() }.map { pkg, _ ->
      "import ${pkg.joinToString(".")}.*\n"
    }.distinct()
    tree = SourceTree(merged(core(home()) + std + own + libraries))
    // A file with main is a program of its own, checked from it; the rest, from what imports them.
    mains = own.filter { pkg, _ -> pkg.isEmpty() }.flatMap { _, sources -> sources }.filter {
      declaresMain(it.text)
    }
    entries = [SourceText(None, ProgramProject, imported.joinToString(""))] + mains
    problems = entries.flatMap { entry ->
      (_, found) = Checker.check(entry, tree, true)
      found
    }.distinct()
    found = problems.filter { it.file.isSome() }
    byFile = found.fold(emptyMap()) { m, d ->
      key = uriOf(d.file.getOrElse(""))
      m.put(key, m.getOrDefault(key, []) + [d])
    }
    before = session.said.getOrDefault(project.root.value, [])
    before.filter { !byFile.containsKey(it) }.forEach { publish(it, []) }
    byFile.entries.forEach { key, diagnostics ->
      text = session.open.get(key).getOrElse(readOrEmpty(pathOf(key)))
      publish(key, diagnostics.map { shown(it, text) })
    }
    session.said = session.said.put(project.root.value, byFile.keys)
  }

  private declaresMain(text: String): Boolean = when (Parser.parse(text)) {
    Ok(file) -> file.declarations.any { it.name == "main" }
    Error(_) -> false
  }

  // The source's text: as it is in the editor, if it's open there.
  private editing(session: Session, source: SourceText): String =
    session.open.get(uriOf(source.path.getOrElse(""))).getOrElse(source.text)

  // The folder with build.fk at or above file's, its folders and libraries as .kiln/paths says.
  @FileSystem private projectOf(file: Path): Project = {
    start = file.parent.getOrElse(path("."))
    root = rootAbove(start).getOrElse(start)
    paths = root.resolve(".kiln/paths")
    if (paths.exists()) {
      lines = paths.readLines()
      Project(
        root,
        lines.filter { it.startsWith("source ") }.map { line ->
          folder = line.removePrefix("source ")
          if (folder.startsWith("/")) path(folder) else root.resolve(folder)
        }.filter { it.isDirectory() },
        lines.filter { it.startsWith("library ") }.map { path(it.removePrefix("library ")) },
      )
    }
    else Project(root, [root.resolve("src")].filter { it.isDirectory() }, [])
  }

  @FileSystem private rootAbove(folder: Path): Option<Path> =
    if (folder.resolve("build.fk").exists()) Some(folder)
    else when (folder.parent) {
      Some(up) if up.value != folder.value -> rootAbove(up)
      _ -> None
    }

  @FileSystem private readOrEmpty(file: Path): String = if (file.exists()) file.readText() else ""

  // A diagnostic, as LSP has it: from where fckt says, to the end of the word there.
  private shown(d: Diagnostic, text: String): Json = {
    line = max(d.at.line - 1, 0)
    column = max(d.at.column - 1, 0)
    rest = text.split("\n").getOrNone(line).map { it.drop(column) }.getOrElse("")
    word = rest.toList().takeWhile { it.isLetterOrDigit() || it == '_' }.size
    JsonObject([
      ("range", range(line, column, line, column + max(word, 1))),
      ("severity", number(1)),
      ("source", JsonString("fckt")),
      ("message", JsonString(d.message)),
    ])
  }

  private range(startLine: Int, startColumn: Int, endLine: Int, endColumn: Int): Json =
    JsonObject([
      ("start", JsonObject([("line", number(startLine)), ("character", number(startColumn))])),
      ("end", JsonObject([("line", number(endLine)), ("character", number(endColumn))])),
    ])

  @Channel private publish(uri: String, diagnostics: List<Json>): Unit = sent(JsonObject([
    ("jsonrpc", JsonString("2.0")),
    ("method", JsonString("textDocument/publishDiagnostics")),
    ("params", JsonObject([("uri", JsonString(uri)), ("diagnostics", JsonArray(diagnostics))])),
  ]))

  @Channel private answer(id: Option<Json>, result: Json): Unit = sent(JsonObject([
    ("jsonrpc", JsonString("2.0")),
    ("id", id.getOrElse(JsonNull)),
    ("result", result),
  ]))

  @Channel private refuse(id: Option<Json>, method: String): Unit = sent(JsonObject([
    ("jsonrpc", JsonString("2.0")),
    ("id", id.getOrElse(JsonNull)),
    ("error", JsonObject([
      ("code", number(-32601)),
      ("message", JsonString("fckt doesn't do $method")),
    ])),
  ]))

  // The next message, or None once the editor has closed the input.
  @Channel private received(): Option<Json> = headers(None).flatMap { length ->
    Jsons.parse(readFrom(standardInput, length).decodeToString())
  }

  // The headers, up to the blank line after them: the length of what follows.
  @Channel private headers(length: Option<Int>): Option<Int> =
    when (readLineFrom(standardInput)) {
      None -> None
      Some(raw) -> {
        line = raw.removeSuffix("\r")
        if (line.isEmpty()) (if (length.isSome()) length else headers(length))
        else if (line.lowercase().startsWith("content-length:")) headers(
          line.substringAfter(":").trim().toIntOrNone(),
        )
        else headers(length)
      }
    }

  @Channel private sent(message: Json): Unit = {
    body = Jsons.render(message).encodeToBytes()
    writeTo(standardOutput, "Content-Length: ${body.size}\r\n\r\n".encodeToBytes() + body)
    flushed(Unit)
  }

  private external flushed(u: Unit): Unit = "(fun _ -> flush stdout) u"

  // The file a file: URI names, its escapes, as %20, undone.
  private pathOf(uri: String): Path = path(unescaped(uri.removePrefix("file://").toList()))

  private uriOf(file: String): String =
    "file://" + file.toList().map { c -> if (c == ' ') "%20" else c.toString() }.joinToString("")

  private unescaped(cs: List<Char>): String = when (cs) {
    ['%', a, b, *rest] -> when ((hexDigit(a), hexDigit(b))) {
      (Some(high), Some(low)) -> (high * 16 + low).toChar().toString() + unescaped(rest)
      _ -> "%" + unescaped([a, b] + rest)
    }
    [c, *rest] -> c.toString() + unescaped(rest)
    [] -> ""
  }

  private hexDigit(c: Char): Option<Int> =
    if (c.isDigit()) Some(c.code - 48)
    else if (c >= 'a' && c <= 'f') Some(c.code - 87)
    else if (c >= 'A' && c <= 'F') Some(c.code - 55)
    else None
}
