import fckt.io.Console
import fckt.effects.Fail
import fckt.effects.Failure.*
import fckt.collections.Maps.*
import fckt.collections.Sets.*

effect Clock { now(): Int }
effect Yielding<A> { yield(value: A): Unit }
effect Persistence
@Persistence @Encapsulates annotation type Repository
@Repository spec Store { load(): Int }
module Timed : Store { load() = Clock(now = ~1) { now() } }
main() = assert(true)

// compiles
