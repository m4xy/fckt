import fckt.io.Console

main() = {
  println("${1.0} ${2.5} ${-0.5} ${100.0} ${0.001} ${1234567.0} ${0.1 + 0.2}")
  println("${0.000001} ${12345678.0} ${1.5e10} ${-2.0e-7} ${1e300}")
}

// prints: 1.0 2.5 -0.5 100.0 0.001 1234567.0 0.30000000000000004
// prints: 1.0E-6 1.2345678E7 1.5E10 -2.0E-7 1.0E300
