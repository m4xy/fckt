import fckt.io.Console
import fckt.effects.Fail
import fckt.effects.Failure.*
import fckt.collections.Maps.*
import fckt.collections.Sets.*

module Greeter {
  private shout(name: String): Unit = println(name.uppercase())

  greet(name: String): Unit = shout(name)
}

main() = Greeter.greet("ada")

// error: 'greet' does @Console, so it must say so: @Console greet(...)
