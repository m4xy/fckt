import fckt.io.Console
import fckt.effects.Fail
import fckt.effects.Failure.*
import fckt.collections.Maps.*
import fckt.collections.Sets.*

spec Logger { log(s: String): Unit }
module L : Logger { @Console log(s: String) = println(s) }
module F(M: Logger) { run() = M.log("x") }
module G = F(L)
g() = G.run()
main() = assert(true)

