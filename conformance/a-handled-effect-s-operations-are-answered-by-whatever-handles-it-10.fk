import fckt.io.Console
import fckt.effects.Fail
import fckt.effects.Failure.*
import fckt.collections.Maps.*
import fckt.collections.Sets.*

effect Clock { now(): Int }
effect Yielding<A> { yield(value: A): Unit }
@Console greet() = println("hi")
quiet(): Int = { Console(print = s -> Unit, println = s -> Unit, readLine = ~"") { greet() }; 1 }
main() = assert(true)

