import fckt.io.Console
import fckt.effects.Fail
import fckt.effects.Failure.*
import fckt.collections.Maps.*
import fckt.collections.Sets.*

spec Ordered {
  type T
  compare(a: T, b: T): Int
}
module SortedSet(M: Ordered) {
  type Set(items: List<M.T>)
  empty = Set([])
  insert(s: Set, x: M.T): Set = Set([x, *s.items])
}
module IntOrder {
  opaque type T = Int
  compare(a: T, b: T) = a - b
}
module IntSet = SortedSet(IntOrder)
x = IntSet.insert(IntSet.empty, 5)

// error: expected IntOrder.T but found Int
