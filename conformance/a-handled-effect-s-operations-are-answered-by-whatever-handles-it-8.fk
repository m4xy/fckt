import fckt.io.Console
import fckt.effects.Fail
import fckt.effects.Failure.*
import fckt.collections.Maps.*
import fckt.collections.Sets.*

effect Clock { now(): Int }
effect Yielding<A> { yield(value: A): Unit }
effect Persistence
@Persistence @Encapsulates annotation type Repository
@Repository spec Store { load(): Int }
module Timed : Store { @Clock load() = now() }
main() = assert(true)

// error: 'load' does @Clock, which needs a handler and has no default, so Store can't hide it: handle it inside Timed, or give Clock a default with @HandledBy
