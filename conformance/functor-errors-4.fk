import fckt.io.Console
import fckt.effects.Fail
import fckt.effects.Failure.*
import fckt.collections.Maps.*
import fckt.collections.Sets.*

spec Ordered {
  type T
  compare(a: T, b: T): Int
}
module SortedSet(M: Ordered) {
  type Set(items: List<M.T>)
  empty = Set([])
  insert(s: Set, x: M.T): Set = Set([x, *s.items])
}
spec Other { type T }
module A : Other { type T = Int }
module S = SortedSet(A)

// error: it follows Other, not Ordered
