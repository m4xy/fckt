import fckt.io.Console

@Console f(s: String): Int = {
  print(s)
  1
}
g(a: Int, b: Int) = a + b
@Console main() = {
  pair = (f("a"), f("b"))
  sum = f("c") + g(b = f("d"), a = f("e"))
  items = [f("f"), f("g")]
  println("${f("h")}${f("i")} $pair $sum $items")
}

// prints: abcdefghi11 (1, 1) 3 [1, 1]
