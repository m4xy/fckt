// What a declaration defines.
type Definition {
  // type Name<T>(fields), type Name private(...), an annotation type, or an external type, which is
  // OCaml's.
  RecordDefinition(
    typeParameters: List<String>,
    fields: List<Field>,
    privateConstructor: Boolean,
    annotation: Boolean,
    external: Option<String>,
  ),
  // type Name<T> { Case(fields), Other.Case, *Other }
  CasesDefinition(
    typeParameters: List<String>,
    cases: List<CaseDefinition>,
    caseRefs: List<CaseRef>,
    includes: List<TypeRef>,
  ),
  // type Name<T> = Other<T>
  AliasDefinition(typeParameters: List<String>, target: TypeRef),
  // name<T>(parameters): R = body, a value without parameters, or an extension, Receiver.name(...),
  // whose type parameters begin with those its receiver names, as List<A>'s A.
  FunctionDefinition(
    typeParameters: List<String>,
    receiver: Option<TypeRef>,
    parameters: Option<List<Parameter>>,
    result: Option<TypeRef>,
    body: Expression,
    external: Option<String>,
    operator: Boolean,
  ),
  // module Name<E>(M: Spec) : Spec { declarations }, or module Name = Functor(Module)
  ModuleDefinition(
    declarations: List<Declaration>,
    spec: Option<TypeRef>,
    parameters: List<ModuleParameter>,
    application: Option<Application>,
    typeParameters: List<String>,
  ),
  // spec Name<T> : Parents { types and values }, or an effect, or a copy of one, effect A = B
  SpecDefinition(
    types: List<SpecType>,
    values: List<SpecValue>,
    typeParameters: List<String>,
    copyOf: Option<TypeRef>,
    parents: List<TypeRef>,
  ),
}
