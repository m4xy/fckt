// A record's or case's field: var if it can change, with a default if it can be left out, and
// vararg for an annotation's last, given its items in order.
type Field(
  at: Position,
  name: String,
  fieldType: TypeRef,
  annotations: List<Annotation> = [],
  variable: Boolean = false,
  default: Option<Expression> = None,
  vararg: Boolean = false,
)
