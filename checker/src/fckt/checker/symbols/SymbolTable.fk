import fckt.collections.Maps.*

// Every declaration in the files a program is checked with, each kind by full name, as names are
// looked up in one kind at a time: a type, a spec, a function, a module; and all of them, but
// packages, in the order they're written, which is the order they're checked in.
type SymbolTable(
  modules: Map<String, ModuleSymbol>,
  records: Map<String, Symbol>,
  // Types with cases.
  caseTypes: Map<String, Symbol>,
  aliases: Map<String, Symbol>,
  // annotation types, which are only checked: no value has one.
  annotationTypes: Map<String, Symbol>,
  // Specs, effects among them.
  specs: Map<String, Symbol>,
  // Functions and values, extensions among them.
  functions: Map<String, Symbol>,
  cases: Map<String, CaseSymbol>,
  declarations: List<Symbol>,
  // Whether any declaration has a name of its own, private to its file, which lookups must try first.
  filePrivate: Boolean = false,
)
