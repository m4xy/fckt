import fckt.collections.Maps.*
import fckt.checker.symbols.SymbolTable

// What looking names up needs: every declaration; what each file's imports bring in, by the file's
// path, None for the program's own; and what modules are beyond what they declare, which is known
// once functors' parameters and applications are; and where to look for what a name that means
// nothing here may mean elsewhere.
type Namespace(table: SymbolTable, imports: Map<Option<String>, FileImports>, modules: Modules, hints: Hints)
