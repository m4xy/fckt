import fckt.collections.Maps.*
import fckt.checker.symbols.*
import fckt.checker.types.Types

// What the name of a type, as written, means: a type parameter or a spec's own type where it's
// written, one of the language's own, a declared type, or a spec, as the type of the modules that
// follow it.
module TypeNames {
  meaning(name: String, scope: TypeScope, namespace: Namespace): Lookup<TypeMeaning> =
    if (scope.typeParameters.contains(name)) Found(TypeParameterType(name))
    else if (scope.specTypes.contains(name)) Found(SpecOwnType(name))
    else if (Types.builtins.containsKey(name)) Found(BuiltinType(name))
    else when (Lookups.anyType(name, scope.place, namespace, Refusing)) {
      Found(symbol) -> Found(DeclaredType(symbol))
      Refused(why) -> Refused(why)
      NotFound -> notDeclared(name, scope, namespace)
    }

  // What a name that's no type means: a spec, as its modules' type; or why it can't be a type.
  private notDeclared(name: String, scope: TypeScope, namespace: Namespace): Lookup<TypeMeaning> = {
    when (Lookups.spec(name, scope.place, namespace, Skipping)) {
      Found(spec) -> Found(SpecModuleType(spec))
      else -> when (Lookups.annotationType(name, scope.place, namespace, Skipping)) {
        Found(_) -> Refused("'$name' is an annotation, written @$name(...) before a declaration; no value has its type")
        else ->
          if (scope.typeParameters.contains("@$name")) Refused("'$name' is an effect parameter, written @$name, as in @$name () -> Unit")
          else if (name == "_") Refused("'_' only marks a spec type's parameters, as in Monad<Result<_, String>>")
          else Refused("unknown type '$name'${ImportHints.forName(name, namespace)}")
      }
    }
  }
}
