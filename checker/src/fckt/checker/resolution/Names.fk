import fckt.collections.Maps.*
import fckt.checker.symbols.*

// Finding what a name means among the declarations of one kind, from where it's written.
module Names {
  // What the name, maybe dotted, means among the entries, looked up from the place. In module A.B,
  // x could be A.B.x, A.x or x, innermost first, but no further out than the place's package, so
  // a file never sees another package's declarations but through imports; written in full from a
  // package, as fckt.io.Files.readFile, it's looked for from the top too. Then what the file
  // imports: Shapes.area, with import geometry.Shapes, is geometry.Shapes.area. Two imports
  // bringing in the name matter only if both mean something alike, which alike says of a full
  // name: two types, for a type.
  find<A>(
    name: String,
    entries: Map<String, A>,
    symbolOf: (A) -> Option<Symbol>,
    alike: (String) -> Boolean,
    place: Place,
    namespace: Namespace,
    strictness: Strictness,
  ): Lookup<A> = when (specPlace(place, namespace)) {
    // A spec's default, in a module that follows it, names its module's own members, and then what
    // it names where the spec is, before anything around the module: a program's own Shape isn't
    // the Shape a library's default means.
    Some(at) -> when (around(name, [place.path.size], entries, symbolOf, place, namespace, strictness)) {
      NotFound -> when (find(name, entries, symbolOf, alike, at, namespace, strictness)) {
        NotFound -> anywhere(name, entries, symbolOf, alike, place, namespace, strictness)
        other -> other
      }
      other -> other
    }
    None -> anywhere(name, entries, symbolOf, alike, place, namespace, strictness)
  }

  // What the name means looked up from the place, out to its package, then where a functor or a
  // spec is, then through the file's imports.
  private anywhere<A>(
    name: String,
    entries: Map<String, A>,
    symbolOf: (A) -> Option<Symbol>,
    alike: (String) -> Boolean,
    place: Place,
    namespace: Namespace,
    strictness: Strictness,
  ): Lookup<A> = when (around(name, reach(name, place, namespace.table), entries, symbolOf, place, namespace, strictness)) {
    NotFound -> when (whereFunctorIs(name, entries, symbolOf, alike, place, namespace, strictness)) {
      NotFound -> when (whereSpecIs(name, entries, symbolOf, alike, place, namespace, strictness)) {
        NotFound -> imported(name, entries, symbolOf, alike, place, namespace, strictness)
        other -> other
      }
      other -> other
    }
    other -> other
  }

  // The name, with a module a functor made's parameter at its start replaced by the module it was
  // given: IntSet.M.T is IntOrder.T, in module IntSet = SortedSet(IntOrder).
  canonical(name: String, namespace: Namespace): String = {
    parts = name.split(".")
    found = parts.mapIndexed { i, _ -> parts.size - i }.mapNotNull { n ->
      namespace.modules.aliases.get(
        parts.take(n).joinToString("."),
      ).map { given -> ([given] + parts.drop(n)).joinToString(".") }
    }.firstOrNone()
    when (found) {
      Some(replaced) -> canonical(replaced, namespace)
      None -> name
    }
  }

  // The module a functor made that the path is in, if any.
  enclosingApplication(path: List<String>, namespace: Namespace): Option<String> =
    path.mapIndexed { i, _ -> path.take(i + 1).joinToString(".") }.find { namespace.modules.applications.containsKey(it) }

  // In a module a functor made, what the functor's body names is what it names where the functor is:
  // what's beside it in its package, wherever it's applied. Not its modules, which the made module
  // has as what it was given.
  private whereFunctorIs<A>(
    name: String,
    entries: Map<String, A>,
    symbolOf: (A) -> Option<Symbol>,
    alike: (String) -> Boolean,
    place: Place,
    namespace: Namespace,
    strictness: Strictness,
  ): Lookup<A> = when (enclosingApplication(place.path, namespace).flatMap { app -> namespace.modules.applications.get(app).map { made -> (app, made) } }) {
    None -> NotFound
    Some((app, made)) -> {
      inFunctor = Place(
        place.file,
        made.functor.name.split(".") + place.path.drop(app.split(".").size),
      )
      isParameters = (full: String) -> namespace.modules.parameterModules.any { p -> full == p || full.startsWith("$p.") }
      when (find(name, entries, symbolOf, alike, inFunctor, namespace, strictness)) {
        Found(entry) if symbolOf(
          entry,
        ).map { s -> !isParameters(s.name) }.getOrElse(true) -> Found(entry)
        Refused(why) -> Refused(why)
        _ -> NotFound
      }
    }
  }

  // A spec's default, in a module elsewhere that follows the spec, names what it names where the
  // spec is: as a default's file is the spec's, a module whose own file isn't the place's has the
  // default written there.
  private whereSpecIs<A>(
    name: String,
    entries: Map<String, A>,
    symbolOf: (A) -> Option<Symbol>,
    alike: (String) -> Boolean,
    place: Place,
    namespace: Namespace,
    strictness: Strictness,
  ): Lookup<A> = when (specPlace(place, namespace)) {
    Some(at) -> find(name, entries, symbolOf, alike, at, namespace, strictness)
    None -> NotFound
  }

  // Where the spec is whose default is written at the place, if one is: in a module that follows
  // it, written in another file, the spec's, as the default is written there.
  private specPlace(
    place: Place,
    namespace: Namespace,
  ): Option<Place> = when (namespace.table.modules.get(place.path.joinToString("."))) {
    Some(DeclaredModule(m)) if m.file.source.path != place.file.source.path && enclosingApplication(
      place.path,
      namespace,
    ).isNone() ->
      namespace.modules.specs.get(m.name).flatMap { followed ->
        spec = if (followed.file.source.path == place.file.source.path) Some(followed)
          else namespace.table.specs.toList().map { _, s -> s }.find { s -> s.file.source.path == place.file.source.path }
        spec.map { s -> Place(place.file, s.path) }
      }
    _ -> None
  }

  // The first of the full names the reach gives that's an entry that can be seen; with Refusing,
  // the first that's an entry, refused if it can't be seen.
  private around<A>(
    name: String,
    depths: List<Int>,
    entries: Map<String, A>,
    symbolOf: (A) -> Option<Symbol>,
    place: Place,
    namespace: Namespace,
    strictness: Strictness,
  ): Lookup<A> = when (depths) {
    [] -> NotFound
    [depth, *further] -> {
      table = namespace.table
      next = () -> around(name, further, entries, symbolOf, place, namespace, strictness)
      full = canonical((place.path.take(depth) + [name]).joinToString("."), namespace)
      // The place's file's own, private to it, before any other file's.
      own = if (!namespace.table.filePrivate) None else place.file.source.path.flatMap { path -> entries.get(Symbols.filePrivateName(full, path)) }
      when (own.orElse { entries.get(full) }) {
        None -> next()
        Some(entry) -> when (symbolOf(entry)) {
          Some(symbol) if Visibility.isForeign(symbol, place) -> next()
          Some(symbol) -> when (Visibility.whyHidden(symbol, place, table)) {
            None -> Found(entry)
            Some(why) -> when (strictness) {
              Skipping -> next()
              Refusing -> Refused(why)
            }
          }
          None -> Found(entry)
        }
      }
    }
  }

  // How far out from the place's module, by how many of its path's names are kept, the name is
  // looked for: out to its package, and from the top if it's written in full from a package.
  reach(name: String, place: Place, table: SymbolTable): List<Int> = {
    depth = packageDepth(place.path, 0, table)
    first = name.split(".").firstOrNone().getOrElse(name)
    full = depth > 0 && isPackage(first, table)
    descending(place.path.size, depth) + (if (full) [0] else [])
  }

  // From the first number down to the last, both included.
  private descending(
    from: Int,
    to: Int,
  ): List<Int> = if (from < to) [] else [from, *descending(from - 1, to)]

  // How many of the path's names, from the first, are packages: fckt.io in fckt.io.Files.
  private packageDepth(path: List<String>, depth: Int, table: SymbolTable): Int =
    if (depth < path.size && isPackage(path.take(depth + 1).joinToString("."), table)) packageDepth(
      path,
      depth + 1,
      table,
    )
    else depth

  private isPackage(name: String, table: SymbolTable): Boolean = when (table.modules.get(name)) {
    Some(PackageModule(_)) -> true
    else -> false
  }

  // What the name means through the file's imports, if it starts with a name they bring in.
  private imported<A>(
    name: String,
    entries: Map<String, A>,
    symbolOf: (A) -> Option<Symbol>,
    alike: (String) -> Boolean,
    place: Place,
    namespace: Namespace,
    strictness: Strictness,
  ): Lookup<A> = {
    names = importedNames(name, place, namespace)
    found = names.map { canonical(it, namespace) }.filter { entries.containsKey(it) }.distinct()
    similar = names.filter { alike(it) }.distinct()
    first = name.split(".").firstOrNone().getOrElse(name)
    if (similar.size > 1 || found.size > 1) {
      clashing = if (similar.size > 1) similar else found
      when (strictness) {
        Skipping -> NotFound
        Refusing -> Refused(
          "'$first' is imported from ${clashing.joinToString(" and ")}; import the one you mean by name",
        )
      }
    } else when (found) {
      [full] -> when (entries.get(full)) {
        None -> NotFound
        Some(entry) -> when (symbolOf(entry).flatMap { Visibility.whyHidden(it, place, namespace.table) }) {
          None -> Found(entry)
          Some(why) -> when (strictness) {
            Skipping -> NotFound
            Refusing -> Refused(why)
          }
        }
      }
      else -> NotFound
    }
  }

  // The full names the name may mean through the place's file's imports, if it starts with a name
  // they bring in: several, if they bring that name in from several places.
  importedNames(name: String, place: Place, namespace: Namespace): List<String> = {
    first = name.split(".").firstOrNone().getOrElse(name)
    rest = name.removePrefix(first)
    imports = namespace.imports.getOrDefault(
      place.file.source.path,
      FileImports(emptyMap(), emptyMap()),
    )
    targets = when (imports.named.get(first)) {
      Some(target) -> [target]
      None -> imports.ambiguous.getOrDefault(first, [])
    }
    targets.map { it + rest }
  }
}
