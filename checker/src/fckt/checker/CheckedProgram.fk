import fckt.collections.Maps.*
import fckt.checker.core.TypeDeclaration
import fckt.checker.core.DeclaredEffect
import fckt.checker.symbols.Symbol
import fckt.checker.sources.Workspace
import fckt.checker.inference.CheckedFunction
import fckt.checker.inference.DefaultHandler
import fckt.checker.inference.FunctionGroup

// A program, checked: the files it's checked with; the type of each of its functions and values,
// and its code, in the order they're written; each handled effect's default handler, which main is
// run in; the functions' groups, each after those it uses, as their code must be; the types it
// declares; the extension that's each type's own toString, where it has one, by its full name; and
// the handled effects it declares, with their operations.
type CheckedProgram(
  workspace: Workspace,
  functions: List<CheckedFunction>,
  defaultHandlers: List<DefaultHandler> = [],
  groups: List<FunctionGroup> = [],
  types: List<TypeDeclaration> = [],
  toStrings: Map<String, Symbol> = emptyMap(),
  effects: List<DeclaredEffect> = [],
)
