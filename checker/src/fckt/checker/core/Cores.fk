import fckt.checker.symbols.Symbol

// What can be told of core from what it is.
module Cores {
  // Whether working out the core may run code, which could do something: anything but values,
  // names, functions, and what's made of them.
  runs(c: Core): Boolean = when (c) {
    Value(_) -> false
    LocalRead(_, isVar) -> isVar
    GlobalRead(_) -> false
    ExternalRead(_) -> false
    FunctionValue(_, _, _) -> false
    Operated(_, operands) -> operands.any { runs(it) }
    Shown(value, _) -> runs(value)
    TupleMade(parts) -> parts.any { runs(it) }
    ListMade(items) -> items.any { item ->
      when (item) {
        OneItem(value) -> runs(value)
        SpreadItems(list) -> runs(list)
      }
    }
    Conditional(condition, then, otherwise) -> runs(condition) || runs(then) || runs(otherwise)
    Constructed(_, fields, _) -> fields.any { runs(it) }
    FieldRead(record, _, _) -> runs(record)
    Copied(record, _, changes) -> runs(record) || changes.any { _, c -> runs(c) }
    NarrowedRead(_, _, _, _) -> false
    Widened(value, _) -> runs(value)
    ModulePacked(_, _) -> false
    else -> true
  }

  // A call whose arguments, given in its parameters' order, are written in another: each that runs
  // code bound first, in the order they're written, as Kotlin runs them, so what they do happens in
  // that order. The order is the argument each parameter gets, by its place where it's written.
  inWrittenOrder(arguments: List<Core>, order: List<Int>, call: (List<Core>) -> Core): Core =
    if (order == order.sorted() || arguments.count { runs(it) } < 2) call(arguments)
    else {
      // Each parameter's argument, with the name it's bound to, if it's bound.
      named = arguments.mapIndexed { i, a -> (a, if (runs(a)) Some("fk_named${i + 1}") else None) }
      written = named.zip(order).sortedBy { _, at -> at }.map { entry, _ -> entry }
      given = named.map { a, name -> name.map { LocalRead(it, false) }.getOrElse(a) }
      written.reversed().fold(call(given)) { body, entry ->
        (a, name) = entry
        when (name) {
          Some(n) -> Bound(NameMatcher(n), a, body)
          None -> body
        }
      }
    }

  // The declarations the core uses, by name: functions, values, effects, and the types it builds or
  // reads the fields of.
  references(c: Core): List<Symbol> = when (c) {
    Value(_) -> []
    LocalRead(_, _) -> []
    GlobalRead(f) -> [f]
    ExternalRead(f) -> [f]
    Applied(function, arguments) -> references(function) + all(arguments)
    ExternalApplied(f, arguments) -> [f] + all(arguments)
    Performed(effect, _, arguments) -> [effect] + all(arguments)
    Operated(_, operands) -> all(operands)
    Shown(value, _) -> references(value)
    Constructed(constructor, fields, _) -> when (constructor) {
      RecordConstructor(record) -> [record]
      CaseConstructor(case) -> [case.owner]
      BuiltinCase(_) -> []
    } + all(fields)
    FieldRead(record, owner, _) -> [owner] + references(record)
    Copied(record, owner, changes) -> [owner] + references(record) + all(changes.map { _, c -> c })
    FieldWritten(record, owner, _, value) -> [owner] + references(record) + references(value)
    NarrowedWritten(_, _, _, _, value) -> references(value)
    CaseName(value, cases) -> cases.map { it.owner } + references(value)
    ListMade(items) -> items.flatMap { item ->
      when (item) {
        OneItem(value) -> references(value)
        SpreadItems(list) -> references(list)
      }
    }
    TupleMade(parts) -> all(parts)
    Joined(list, separator, _) -> references(list) + references(separator)
    Assertion(condition, _) -> references(condition)
    EqualityAssertion(expected, actual, _, _) -> references(expected) + references(actual)
    Matched(subject, branches) -> references(subject) + branches.flatMap { b -> b.guard.map { references(it) }.getOrElse([]) + references(b.body) }
    NarrowedRead(_, _, _, _) -> []
    Conditional(condition, then, otherwise) -> references(condition) + references(then) + references(otherwise)
    Bound(_, value, body) -> references(value) + references(body)
    VarBound(_, value, body) -> references(value) + references(body)
    VarWritten(_, value) -> references(value)
    FunctionBound(_, _, body, rest) -> references(body) + references(rest)
    Sequenced(first, then) -> references(first) + references(then)
    FunctionValue(_, body, _) -> references(body)
    Absurd(call) -> references(call)
    Widened(value, _) -> references(value)
    ModulePacked(module, spec) -> [module, spec]
    ModuleMemberRead(value, spec, _) -> [spec] + references(value)
    HandlerMade(effect, answers) -> [effect] + all(answers.map { it.answer })
    ModuleHandler(module, effect) -> [module, effect]
    Handled(effect, handler, block) -> [effect] + references(handler) + references(block)
    Pending(_) -> []
  }

  private all(cores: List<Core>): List<Symbol> = cores.flatMap { references(it) }
}
