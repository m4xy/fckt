import fckt.checker.symbols.*
import fckt.checker.types.Type

// What checked code is: each name resolved to what it means, each operator to the operation it
// does, each call to what it calls, its arguments in its parameters' order and its defaults filled
// in, and each type as checking worked it out. fckt.lowering writes OCaml from it.
type Core {
  // A constant.
  Value(literal: Literal),
  // A name bound where code is: a parameter, a block's value, or what a pattern bound; or a var, as
  // what it holds now.
  LocalRead(name: String, isVar: Boolean),
  // A function or value declared in a package or a module.
  GlobalRead(function: Symbol),
  // An external used as a value, rather than called.
  ExternalRead(function: Symbol),
  // The function, called with the arguments.
  Applied(function: Core, arguments: List<Core>),
  // An external's OCaml, given the arguments for its parameters, in order.
  ExternalApplied(function: Symbol, arguments: List<Core>),
  // An effect's operation, performed: whatever handles the effect answers.
  Performed(effect: Symbol, operation: String, arguments: List<Core>),
  // One of the language's own operations: on numbers, Booleans, strings and lists, or comparing any
  // two values of a type.
  Operated(primitive: Primitive, operands: List<Core>),
  // The value as text, as toString and a string template show it: of type t.
  Shown(value: Core, t: Type),
  // A record or a case built, its fields in the order it declares them: a value of type t.
  Constructed(constructor: Constructor, fields: List<Core>, t: Type),
  // record.copy(field = value): the record, with the fields named holding the values given; by its
  // declaration.
  Copied(record: Core, owner: Symbol, changes: List<(String, Core)>),
  // A record's field, by its record's declaration and its name.
  FieldRead(record: Core, owner: Symbol, field: String),
  // Which case the value is, as its name, for a type whose cases carry nothing.
  CaseName(value: Core, cases: List<CaseSymbol>),
  // A record's var field, changed to hold the value.
  FieldWritten(record: Core, owner: Symbol, field: String, value: Core),
  // A var field of the case is found a local to be, changed where it's found so.
  NarrowedWritten(local: String, caseName: String, caseType: String, field: String, value: Core),
  // [a, *rest, b]: a list of the items, in order.
  ListMade(items: List<ListItem>),
  // (a, b): a tuple of the parts.
  TupleMade(parts: List<Core>),
  // A list's items as text, each shown as toString shows it, with the separator between them: of
  // element type, element.
  Joined(list: Core, separator: Core, element: Type),
  // assert(condition): failing, with the summary, where it is and what it checked, if it doesn't
  // hold; then, for a test runner to say more, the facts, each a key and its value, a string.
  Assertion(condition: Core, summary: String, facts: List<(String, Core)>),
  // assertEquals(expected, actual): failing, saying where and showing both, if they differ, and the
  // call as written, where it's known; of type t.
  EqualityAssertion(expected: Core, actual: Core, t: Type, where: String, source: String),
  // when (subject) { ... }: the first branch whose patterns it matches, and whose guard holds.
  Matched(subject: Core, branches: List<MatchBranch>),
  // A field of the case is found a local to be, read where it's found so: the case by its name, of
  // the type with cases it's of, by its full name.
  NarrowedRead(local: String, caseName: String, caseType: String, field: String),
  // if (condition) then else otherwise
  Conditional(condition: Core, then: Core, otherwise: Core),
  // The value, taken apart by the pattern, whose names body can use.
  Bound(pattern: Matcher, value: Core, body: Core),
  // A var, holding the value to begin with, called name in body.
  VarBound(name: String, value: Core, body: Core),
  // The var, changed to hold the value.
  VarWritten(name: String, value: Core),
  // A function of the block's own, which can call itself, called name in rest.
  FunctionBound(name: String, parameters: List<Matcher>, body: Core, rest: Core),
  // first, done for what it does, then then.
  Sequenced(first: Core, then: Core),
  // A function of the parameters, each a pattern what it's given matches: what its body gives, or, if
  // it drops what its body gives, as one wanted to give back Unit does, Unit.
  FunctionValue(parameters: List<Matcher>, body: Core, dropsResult: Boolean),
  // A handler for the effect, made from an answer to each of its operations, in the order it
  // declares them.
  HandlerMade(effect: Symbol, answers: List<Answer>),
  // A module that follows the effect's spec, as a handler: each answer its function of that name.
  ModuleHandler(module: Symbol, effect: Symbol),
  // The block, run with the handler handling the effect.
  Handled(effect: Symbol, handler: Core, block: Core),
  // A value of a type with cases, as the wider type it's used as, which has each of its cases.
  Widened(value: Core, t: Type),
  // A module that follows the spec, as a value of it.
  ModulePacked(module: Symbol, spec: Symbol),
  // A value of a module given as a value, as its spec has it.
  ModuleMemberRead(value: Core, spec: Symbol, member: String),
  // A call that never returns, as one giving Nothing doesn't: it fits wherever it is.
  Absurd(call: Core),
  // An expression whose core fckt.checker doesn't make yet: what it is.
  Pending(what: String),
}
