import fckt.collections.Maps.*

// Every package a program could use: each by its path, with the files directly in its folder, in
// order of their names. A folder with only folders in it is a package too, with no files. What
// each of the program's own files imports besides what it says, as a build script imports kiln.*.
type SourceTree(packages: Map<List<String>, List<SourceText>>, imports: List<String> = [])
