import fckt.collections.Maps.*
import fckt.checker.core.*
import fckt.checker.diagnostics.*
import fckt.checker.symbols.*
import fckt.checker.types.*
import fckt.checker.types.Types.*
import fckt.checker.types.Unification.*
import fckt.parser.*

// Operators. && and || take Booleans; == and != any two values of a type; .. and ..< are the left
// side's rangeTo and rangeUntil; + joins lists and strings; and the rest are numbers', an Int
// becoming a Float beside one, or, for a type whose operators are its own, as a Set's are, its
// operator method: a + b is a.plus(b).

@Inferring inferBinary(at: Position, operator: String, left: Expression, right: Expression, scope: Scope, context: Context): Typed = when (operator) {
  "&&" -> logical(And, left, right, scope, context)
  "||" -> logical(Or, left, right, scope, context)
  "==" -> equality(at, Equal, left, right, scope, context)
  "!=" -> equality(at, NotEqual, left, right, scope, context)
  "..", "..<" -> range(at, operator, left, right, scope, context)
  else -> arithmetic(at, operator, left, right, scope, context)
}

// a..b and a..<b: whatever the left side is, its operator rangeTo or rangeUntil, as Int's is.
@Inferring private range(at: Position, operator: String, left: Expression, right: Expression, scope: Scope, context: Context): Typed = {
  fromTyped = infer(left, None, scope, context)
  from = resolved(fromTyped.t)
  method = References.rangeMethods.lookup(operator).getOrElse("rangeTo")
  if (Globals.extensionsNamed(method, context).any { s -> Signatures.isOperator(s) && fitsReceiver(s, from, context) })
    operatorCall(operator, at, left, fromTyped, method, [right], scope, context)
  else abandon(Globals.problem(context, at, "'$operator' can't be applied to ${TypeText.shown(from)}: ${noOperator(operator, method, from, context)}"))
}

@Inferring private logical(primitive: Primitive, left: Expression, right: Expression, scope: Scope, context: Context): Typed = {
  l = check(left, boolean, scope, context)
  Typed(boolean, None, Operated(primitive, [l, check(right, boolean, scope, context)]))
}

// Two values of a type; different types with cases compare as the smallest one that has both,
// as Alphabet.E == vowel does.
@Inferring private equality(at: Position, primitive: Primitive, left: Expression, right: Expression, scope: Scope, context: Context): Typed = {
  l = infer(left, None, scope, context)
  r = infer(right, Some(l.t), scope, context)
  (x, y) = (caseTypeOf(l.t, context), caseTypeOf(r.t, context))
  if (x.isSome() && y.isSome() && x != y) {
    join([(left, l), (right, r)], at, context)
    Unit
  } else assign(right, r, l.t, context)
  Typed(boolean, None, Operated(primitive, [l.core, r.core]))
}

@Inferring private arithmetic(at: Position, operator: String, left: Expression, right: Expression, scope: Scope, context: Context): Typed = {
  leftTyped = infer(left, None, scope, context)
  l = resolved(leftTyped.t)
  method = References.operatorMethods.lookup(operator)
  ownOperator = method.filter { m -> ownsOperators(l) && Globals.extensionsNamed(m, context).any { s -> Signatures.isOperator(s) && fitsReceiver(s, l, context) } }
  when (ownOperator) {
    Some(m) -> operatorCall(operator, at, left, leftTyped, m, [right], scope, context)
    None -> numbers(at, operator, method, left, leftTyped, right, scope, context)
  }
}

@Inferring private numbers(at: Position, operator: String, method: Option<String>, left: Expression, leftTyped: Typed, right: Expression, scope: Scope, context: Context): Typed = {
  l = resolved(leftTyped.t)
  hint = when (l) {
    Variable(_) -> None
    else -> Some(l)
  }
  rightTyped = infer(right, hint, scope, context)
  r = resolved(rightTyped.t)
  isArithmetic = ["+", "-", "*", "/", "%"].contains(operator)
  if (operator == "+" && (isNamed(l, "List") || isNamed(r, "List"))) {
    expect(r, l, Positions.of(right), context)
    Typed(l, None, Operated(Appended, [leftTyped.core, rightTyped.core]))
  } else if (operator == "+" && (isNamed(l, "String") || isNamed(r, "String"))) {
    expect(l, string, Positions.of(left), context)
    expect(r, string, Positions.of(right), context)
    Typed(string, None, Operated(Concatenated, [leftTyped.core, rightTyped.core]))
  } else {
    // Unknown operands are settled from the other side, or, for arithmetic, are Ints.
    when ((l, r)) {
      (Variable(_), Variable(_)) -> {
        unify(l, r)
        if (isArithmetic) unify(l, int) else true
        Unit
      }
      (Variable(_), _) -> {
        unify(l, r)
        Unit
      }
      (_, Variable(_)) -> {
        unify(r, l)
        Unit
      }
      else -> Unit
    }
    (x, y) = (resolved(l), resolved(r))
    if (isNumeric(x) && isNumeric(y)) {
      isFloat = isNamed(x, "Float") || isNamed(y, "Float")
      // An Int beside a Float is one.
      operands = [(leftTyped.core, x), (rightTyped.core, y)].map { core, t -> if (isFloat && isNamed(t, "Int")) Operated(Promoted, [core]) else core }
      if (!isArithmetic) Typed(boolean, None, Operated(comparison(operator), operands))
      else Typed(if (isFloat) float else int, None, Operated(arithmeticOn(operator, isFloat), operands))
    } else if (isArithmetic) {
      why = method.filter { ownsOperators(x) }.map { m -> ": ${noOperator(operator, m, x, context)}" }.getOrElse("")
      abandon(Globals.problem(context, at, "'$operator' can't be applied to ${TypeText.shown(x)} and ${TypeText.shown(y)}$why"))
    } else {
      expect(y, x, Positions.of(right), context)
      Typed(boolean, None, Operated(comparison(operator), [leftTyped.core, rightTyped.core]))
    }
  }
}

// What an arithmetic operator does, on Ints or on Floats.
private arithmeticOn(operator: String, isFloat: Boolean): Primitive = when (operator) {
  "+" -> if (isFloat) FloatPlus else IntPlus
  "-" -> if (isFloat) FloatMinus else IntMinus
  "*" -> if (isFloat) FloatTimes else IntTimes
  "/" -> if (isFloat) FloatDivide else IntDivide
  else -> if (isFloat) FloatRemainder else IntRemainder
}

// What a comparison is.
private comparison(operator: String): Primitive = when (operator) {
  "<" -> Less
  "<=" -> LessOrEqual
  ">" -> Greater
  else -> GreaterOrEqual
}

private isNumeric(t: Type): Boolean = isNamed(t, "Int") || isNamed(t, "Float")

// Whether the type's operators are its own, as a Set's are: not a number's, a string's or a list's.
ownsOperators(t: Type): Boolean = when (t) {
  Named(name, _, _) -> !["Int", "Float", "String", "List"].contains(name)
  Variable(_) -> false
  FunctionOf(_, _, _) -> false
  Effects(_) -> false
  else -> true
}

// a + b, where a's type has its own +, as a.plus(b): a call to an operator extension of the
// method, with the operand, already worked out, as its receiver.
@Inferring operatorCall(operator: String, at: Position, operand: Expression, operandTyped: Typed, method: String, arguments: List<Expression>, scope: Scope, context: Context): Typed = {
  t = resolved(operandTyped.t)
  notOperator = () -> abandon(Globals.problem(context, at, "'$operator' can't be applied to ${TypeText.shown(t)}: its $method isn't an operator; mark it operator to use '$operator' for it"))
  when (extensionFor(at, method, t, context)) {
    Some(s) if Signatures.isOperator(s) ->
      callExtension(at, at, operand, operandTyped.core, s, t, arguments.map { CallArgument(None, WrittenValue(it)) }, [], scope, context)
    else -> notOperator()
  }
}

// Why the operator can't be applied to a type whose operators are its own, as its method.
@Solving @Abandoning noOperator(operator: String, method: String, t: Type, context: Context): String =
  if (Globals.extensionsNamed(method, context).any { fitsReceiver(it, t, context) }) "its $method isn't an operator; mark it operator to use '$operator' for it"
  else "there's no operator $method${methodImportHint(method, t, context)}"
