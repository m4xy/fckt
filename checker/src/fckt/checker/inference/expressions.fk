import fckt.collections.Maps.*
import fckt.checker.diagnostics.*
import fckt.checker.resolution.*
import fckt.checker.symbols.*
import fckt.checker.types.*
import fckt.checker.types.Types.*
import fckt.checker.types.Unification.*
import fckt.parser.*

// What each kind of expression is. Where it's known, what's expected guides lambdas, literals and
// constructors: 1 is a Float where one is wanted, and None an Option of what's wanted.

// The expression's type, and the case it spells out, if it does.
@Inferring infer(e: Expression, expected: Option<Type>, scope: Scope, context: Context): Typed = {
  typed = inferInner(e, expected, scope, context)
  when (e) {
    // A call that gives Nothing never returns, so it fits wherever it is.
    Call(_, _, _, _) if isNamed(resolved(typed.t), "Nothing") -> Typed(Variable(fresh()))
    else -> typed
  }
}

// What's expected, unless it's still unknown: branches aren't checked against an unknown, they're
// joined.
@Solving known(expected: Option<Type>): Option<Type> = expected.filter { t ->
  when (resolved(t)) {
    Variable(_) -> false
    else -> true
  }
}

@Inferring private inferInner(e: Expression, expected: Option<Type>, scope: Scope, context: Context): Typed = when (e) {
  Assign(at, target, value) -> Typed(inferAssign(at, target, value, scope, context))
  Handle(at, handler, block, parameters) -> inferHandle(at, handler, block, parameters, expected, scope, context)
  // An integer literal can stand for a float where one is expected.
  IntConstant(_, _) -> Typed(if (expected.map { isNamed(resolved(it), "Float") }.getOrElse(false)) float else int)
  FloatConstant(_, _) -> Typed(float)
  BooleanConstant(_, _) -> Typed(boolean)
  CharConstant(_, _) -> Typed(char)
  Tuple(_, elements) -> Typed(inferTuple(elements, expected, scope, context))
  Spread(at, _) -> abandon(Globals.problem(context, at, "'*' can only spread a list inside a list literal"))
  StringTemplate(_, parts) -> {
    parts.forEach { part ->
      when (part) {
        Interpolation(inner) -> {
          infer(inner, None, scope, context)
          Unit
        }
        TemplateText(_) -> Unit
      }
    }
    Typed(string)
  }
  Name(at, name) -> inferName(at, name, expected, scope, context)
  ListOf(at, items) -> Typed(inferList(at, items, expected, scope, context))
  Call(at, callee, arguments, typeArguments) -> inferCall(at, callee, arguments.map { written(it) }, typeArguments, expected, scope, context)
  Member(at, target, name) -> inferMember(at, target, name, expected, scope, context)
  Binary(at, operator, left, right) -> Typed(inferBinary(at, operator, left, right, scope, context))
  Unary(at, "!", operand) -> {
    check(operand, boolean, scope, context)
    Typed(boolean)
  }
  Unary(at, operator, operand) -> Typed(inferNegation(at, operator, operand, expected, scope, context))
  Lambda(at, parameters, body, ignoresArguments) -> Typed(inferLambda(at, Some(parameters), body, ignoresArguments, false, expected, scope, context))
  Pipe(at, value, function) -> Typed(inferPipe(at, value, function, scope, context))
  If(at, condition, then, otherwise, hasElse) -> Typed(inferIf(at, condition, then, otherwise, hasElse, expected, scope, context))
  When(at, subject, branches) -> Typed(inferWhen(at, subject, branches, expected, scope, context))
  Block(at, statements, result, endsInBinding) -> Typed(inferBlock(at, statements, result, endsInBinding, expected, scope, None, context))
  Monadic(at, monad, block) -> Typed(inferMonadic(at, monad, block, scope, context))
}

@Inferring private inferTuple(elements: List<Expression>, expected: Option<Type>, scope: Scope, context: Context): Type = {
  hint = expected.flatMap { t ->
    when (resolved(t)) {
      TupleOf(parts) if parts.size == elements.size -> Some(parts)
      else -> None
    }
  }
  TupleOf(elements.mapIndexed { i, x ->
    wanted = hint.flatMap { it.getOrNone(i) }
    typed = infer(x, wanted, scope, context)
    wanted.forEach { assign(x, typed, it, context) }
    typed.t
  })
}

// [a, b, *rest]: a list of what its items are, joined, or of what's expected of them; each spread
// list a list of that.
@Inferring private inferList(at: Position, items: List<Expression>, expected: Option<Type>, scope: Scope, context: Context): Type = {
  given = known(expected.flatMap { t ->
    when (resolved(t)) {
      Named("List", [element], _) -> Some(element)
      else -> None
    }
  })
  elements = items.filter { !isSpread(it) }
  element = when (given) {
    Some(t) -> {
      elements.forEach { check(it, t, scope, context) }
      t
    }
    None -> if (elements.isEmpty()) Variable(fresh()) else join(elements.map { x -> (x, infer(x, None, scope, context)) }, at, context)
  }
  items.forEach { item ->
    when (item) {
      Spread(_, list) -> check(list, listOf(element), scope, context)
      else -> Unit
    }
  }
  listOf(element)
}

private isSpread(e: Expression): Boolean = when (e) {
  Spread(_, _) -> true
  else -> false
}

// -x: a number's minus, or, for a type whose operators are its own, its unaryMinus.
@Inferring private inferNegation(at: Position, operator: String, operand: Expression, expected: Option<Type>, scope: Scope, context: Context): Type = {
  typed = infer(operand, expected, scope, context)
  t = resolved(typed.t)
  if (ownsOperators(t) && Globals.extensionsNamed(References.unaryMinus, context).any { s -> Signatures.isOperator(s) && fitsReceiver(s, t, context) })
    operatorCall(operator, at, operand, typed, References.unaryMinus, [], scope, context)
  else {
    when (t) {
      Variable(_) -> {
        unify(t, int)
        Unit
      }
      else -> Unit
    }
    after = resolved(t)
    if (!isNamed(after, "Int") && !isNamed(after, "Float")) {
      why = if (ownsOperators(after)) ": ${noOperator(operator, References.unaryMinus, after, context)}" else ""
      abandon(Globals.problem(context, at, "can't negate a ${TypeText.shown(after)}$why"))
    } else after
  }
}

// if (c) a else b: what a and b are, joined, or what's expected of both. Without an else, it gives
// Unit, so its branch must too.
@Inferring private inferIf(
  at: Position,
  condition: Expression,
  then: Expression,
  otherwise: Expression,
  hasElse: Boolean,
  expected: Option<Type>,
  scope: Scope,
  context: Context,
): Type = {
  check(condition, boolean, scope, context)
  if (!hasElse) {
    thenTyped = infer(then, None, scope, context)
    branch = resolved(thenTyped.t)
    when (branch) {
      Variable(_) -> Unit
      _ if isNamed(branch, "Unit") -> Unit
      else -> abandon(Globals.problem(context, at, "an 'if' without 'else' gives Unit, but this branch gives ${TypeText.shown(branch)}: add an 'else' to give a value"))
    }
    assign(then, thenTyped, unit, context)
    infer(otherwise, Some(unit), scope, context).t
  } else when (known(expected)) {
    Some(t) -> {
      check(then, t, scope, context)
      check(otherwise, t, scope, context)
      t
    }
    None -> join([(then, infer(then, None, scope, context)), (otherwise, infer(otherwise, None, scope, context))], at, context)
  }
}

// What a name means: a local; a function or value; a handled effect's operation, as a function
// that does it; a constructor; one of the language's own; or a module, as a handler or a value.
@Inferring private inferName(at: Position, name: String, expected: Option<Type>, scope: Scope, context: Context): Typed =
  when (Scopes.lookup(scope, name)) {
    Some(local) ->
      if (local.hides) abandon(Globals.problem(context, at, "this block's 'it' hides the 'it' outside it: name this block's parameter, { x -> ... }"))
      else Typed(local.t)
    None -> when (Globals.findOrRefuse(name, at, context)) {
      Some(global) -> Typed(Globals.typeOf(global, at, context))
      None -> when (operationNamed(name, at, context)) {
        Some(operation) -> Typed(operationValue(operation, at, context))
        None -> when (constructorShape(name, expected, at, true, None, true, scope, context)) {
          Some(shape) -> Typed(
            if (shape.fieldTypes.isEmpty()) shape.result else FunctionOf(shape.fieldTypes, shape.result, Row([], Some(fresh()))),
            spelledCase(shape),
          )
          None -> when (builtinFunction(name)) {
            Some(t) -> Typed(t)
            None -> when (Lookups.found(Lookups.moduleNamed(name, context.place, context.environment.definitions.namespace, Skipping))) {
              Some(m) -> Typed(moduleAsValue(m, at, context))
              None ->
                if (name == "it") abandon(Globals.problem(context, at, "there's no 'it' here: only a block given as a function of one parameter has one, as in xs.filter { it > 1 }"))
                else abandon(Globals.problem(context, at, "unknown name '$name'"))
            }
          }
        }
      }
    }
  }

// The language's own functions: Unit, which is both the type and its one value; and assert and
// assertEquals, which a test fails with.
@Solving private builtinFunction(name: String): Option<Type> = when (name) {
  "Unit" -> Some(unit)
  "assert" -> Some(FunctionOf([boolean], unit, Row([], Some(fresh()))))
  "assertEquals" -> {
    a = Variable(fresh())
    Some(FunctionOf([a, a], unit, Row([], Some(fresh()))))
  }
  else -> None
}

// x = value, or r.field = value: changes a var, so it's @Mutating on where the var lives.
@Inferring private inferAssign(at: Position, target: Expression, value: Expression, scope: Scope, context: Context): Type = {
  (region, targetType) = when (target) {
    Name(nameAt, name) -> when (Scopes.lookup(scope, name)) {
      None -> abandon(Globals.problem(context, nameAt,
        if (Lookups.found(Globals.find(name, context, Skipping)).isSome()) "'$name' is a top-level value, which can't be changed" else "unknown name '$name'"))
      Some(local) -> when (local.region) {
        None -> abandon(Globals.problem(context, nameAt, "'$name' can't be changed; declare it with var $name = ..."))
        Some(r) -> (r, infer(target, None, scope, context).t)
      }
    }
    Member(memberAt, receiverExpression, name) -> {
      receiver = resolved(infer(receiverExpression, None, scope, context).t)
      field = fieldOf(memberAt, receiverExpression, name, receiver, scope, context)
      (owner, fields) = when (field) {
        Some(NarrowedField(narrowing, _)) ->
          if (narrowing.shared) abandon(Globals.problem(context, memberAt,
            "$name can't be changed here: its case is shared with another type, and OCaml can't change such a case's fields in place"))
          else (narrowing.caseName, narrowing.fields)
        Some(RecordField(record, _)) -> (Symbols.simpleName(record), recordFieldsOf(record))
        Some(ModuleMember(_, _, _)) -> abandon(Globals.problem(context, at, "only a var or a var field can be assigned to"))
        None -> abandon(noField(memberAt, receiverExpression, name, receiver, context))
      }
      if (!fields.any { f -> f.name == name && f.variable }) {
        abandon(Globals.problem(context, memberAt, "$owner's $name can't be changed; declare it with var $name: ..."))
      } else Unit
      fieldType = infer(target, None, scope, context).t
      when (receiver) {
        Named(_, _, Some(r)) -> (r, fieldType)
        else -> (Variable(fresh()), fieldType)
      }
    }
    else -> abandon(Globals.problem(context, at, "only a var or a var field can be assigned to"))
  }
  check(value, targetType, scope, context)
  perform(mutating(region), at)
  unit
}

// Changing what's in the region.
mutating(region: Type): Row = Row([EffectLabel(Types.mutating, [region])], None)

// An argument as written in a call.
written(a: Argument): CallArgument = CallArgument(a.name, WrittenValue(a.value))
