import fckt.collections.Maps.*
import fckt.checker.core.*
import fckt.checker.definitions.*
import fckt.checker.diagnostics.*
import fckt.checker.symbols.Positions
import fckt.checker.types.*
import fckt.checker.types.Types.*
import fckt.parser.*

// Lambdas, and blocks written after a call, which are its last argument. What a lambda's body does
// is what calling it does, not what the code around it does. What's expected tells its parameters'
// types, unless they're written.

@Inferring inferLambda(
  at: Position,
  parameters: Option<List<Parameter>>,
  body: Expression,
  ignoresArguments: Boolean,
  trailing: Boolean,
  expected: Option<Type>,
  scope: Scope,
  context: Context,
): Typed = {
  expectedFunction = expected.flatMap { t ->
    when (resolved(t)) {
      FunctionOf(ps, r, row) -> Some(FunctionOf(ps, r, row))
      else -> None
    }
  }
  row = when (expectedFunction) {
    Some(FunctionOf(_, _, effects)) -> effects
    else -> Row([], Some(fresh()))
  }
  written = parameters.getOrElse([])
  if (ignoresArguments) ignoringArguments(body, expectedFunction, row, scope, context)
  else when ((trailing, expectedFunction)) {
    (true, Some(FunctionOf(wanted, result, _))) if written.isEmpty() && wanted.size == 1 -> {
      // A block given one parameter calls it it.
      t = wanted.getOrNone(0).getOrElse(Variable(fresh()))
      inner = Scopes.bind(
        Scopes.inside(scope),
        "it",
        Local(t, None, None, Scopes.lookup(scope, "it").isSome()),
      )
      (core, drops) = doingIn(row, context) { checkLambdaBody(body, result, inner, context) }
      Typed(FunctionOf([t], result, row), None, FunctionValue([NameMatcher("it")], core, drops))
    }
    (true, Some(FunctionOf(wanted, _, _))) if written.isNotEmpty() && wanted.isEmpty() -> abandon(Globals.problem(context, at,
      "this block takes no parameters, as it's run with none: to give back a function, write { (${written.map { it.name }.joinToString(", ")} -> ...) }"))
    (true, Some(FunctionOf(wanted, _, _))) if written.isEmpty() && wanted.size > 1 -> abandon(Globals.problem(context, at,
      "this block is given ${wanted.size} parameters, so it has no 'it': name them, { ${"abcdefghijklmnopqrstuvwxyz".toList().take(wanted.size).map { "$it" }.joinToString(", ")} -> ... }"))
    else -> {
      checkDistinct(written.map { p -> (p.name, p.at) }, context)
      when (expectedFunction) {
        Some(FunctionOf([tuple], result, _)) if written.size > 1 -> takingApart(
          at,
          written,
          tuple,
          result,
          row,
          body,
          scope,
          context,
        )
        else -> withParameters(written, expectedFunction, row, body, scope, context)
      }
    }
  }
}

// ~body, which ignores what it's given: as many parameters as are expected.
@Inferring private ignoringArguments(
  body: Expression,
  expectedFunction: Option<Type>,
  row: Row,
  scope: Scope,
  context: Context,
): Typed = {
  (parameters, result) = when (expectedFunction) {
    Some(FunctionOf(ps, r, _)) -> (ps, r)
    else -> ([], Variable(fresh()))
  }
  (core, drops) = doingIn(row, context) { checkLambdaBody(body, result, scope, context) }
  Typed(
    FunctionOf(parameters, result, row),
    None,
    FunctionValue(parameters.map { AnyMatcher }, core, drops),
  )
}

// Several parameters where one is expected take apart a tuple, as pairs.map((k, v) -> ...) does.
@Inferring private takingApart(
  at: Position,
  written: List<Parameter>,
  tuple: Type,
  result: Type,
  row: Row,
  body: Expression,
  scope: Scope,
  context: Context,
): Typed = {
  parts = when (resolved(tuple)) {
    TupleOf(elements) ->
      if (elements.size != written.size) abandon(Globals.problem(context, at,
        "this function is given a tuple of ${elements.size}, so it takes ${elements.size} parameters, not ${written.size}"))
      else elements
    _ -> {
      made = written.map { Variable(fresh()) }
      expect(tuple, TupleOf(made), at, context)
      made
    }
  }
  inner = written.zip(parts).fold(Scopes.inside(scope)) { s, entry ->
    (p, part) = entry
    p.parameterType.forEach { declared -> expect(part, parameterType(declared, row, context), p.at, context) }
    Bindings.bound(s, p.name, Local(part), p.at, p.parameterType.isSome(), context)
  }
  (core, drops) = doingIn(row, context) { checkLambdaBody(body, result, inner, context) }
  Typed(
    FunctionOf([tuple], result, row),
    None,
    FunctionValue([TupleMatcher(written.map { matcherOf(it) })], core, drops),
  )
}

// Each parameter of the type written for it, or else the one expected, or else unknown.
@Inferring private withParameters(
  written: List<Parameter>,
  expectedFunction: Option<Type>,
  row: Row,
  body: Expression,
  scope: Scope,
  context: Context,
): Typed = {
  (hintedParameters, hintedResult) = when (expectedFunction) {
    Some(FunctionOf(ps, r, _)) if ps.size == written.size -> (Some(ps), Some(r))
    else -> (None, None)
  }
  types = written.mapIndexed { i, p ->
    declared = p.parameterType.map { parameterType(it, row, context) }
    hinted = hintedParameters.flatMap { ps -> ps.getOrNone(i) }
    when ((declared, hinted)) {
      (Some(d), Some(h)) -> {
        expect(h, d, p.at, context)
        d
      }
      (Some(d), None) -> d
      (None, Some(h)) -> h
      (None, None) -> Variable(fresh())
    }
  }
  inner = written.zip(types).fold(Scopes.inside(scope)) { s, entry ->
    (p, t) = entry
    Bindings.bound(s, p.name, Local(t), p.at, p.parameterType.isSome(), context)
  }
  result = hintedResult.getOrElse(Variable(fresh()))
  (core, drops) = doingIn(row, context) { checkLambdaBody(body, result, inner, context) }
  Typed(
    FunctionOf(types, result, row),
    None,
    FunctionValue(written.map { matcherOf(it) }, core, drops),
  )
}

// A lambda's parameter, as a pattern: its name, or _, which binds nothing.
private matcherOf(p: Parameter): Matcher = if (p.name == "_") AnyMatcher else NameMatcher(p.name)

// A parameter's written type, where a function type without effects does what the lambda does.
@Solving @Abandoning parameterType(t: TypeRef, row: Row, context: Context): Type =
  Conversion.typeOf(
    t,
    TypeContext(
      context.place,
      context.typeParameters,
      None,
      Some(row),
      valueParameters = context.valueParameters,
    ),
    context.environment.definitions,
  )

// What block gives, checked as code that does the row.
@Solving @Abandoning @Noting doingIn<A>(
  row: Row,
  context: Context,
  block: @Doing () -> A,
): A = Doings.doing(row, context.place.file.source.path, block)

// A lambda's body, against the result it's wanted to give back, and its core, with whether what it
// gives is dropped. Where that's Unit, as forEach's is, what the body gives is dropped, whatever it
// is, so xs.forEach { log.add(it) } needn't end with Unit; anything else must be what the body gives.
@Inferring private checkLambdaBody(
  body: Expression,
  result: Type,
  scope: Scope,
  context: Context,
): (Core, Boolean) =
  if (resolved(result) != unit) (check(body, result, scope, context), false)
  else {
    typed = infer(body, None, scope, context)
    when (resolved(typed.t)) {
      Variable(v) -> {
        expect(Variable(v), unit, Positions.of(body), context)
        (typed.core, false)
      }
      other -> (typed.core, other != unit)
    }
  }
