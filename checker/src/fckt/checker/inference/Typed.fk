import fckt.checker.core.*
import fckt.checker.symbols.CaseSymbol
import fckt.checker.types.Type

// What an expression was found to be: its type; if it spells out a case, as Alphabet.A or Cons(1,
// Nil) does, which, so that it can take on any type with cases that has it; and its core, what it is
// once its names and operators are resolved.
type Typed(t: Type, spelled: Option<CaseSymbol> = None, core: Core = Pending("an expression"))
