import fckt.parser.Expression
import fckt.checker.core.*
import fckt.checker.coverage.Matches

// A when's branch, checked: its body and what it was found to be, where nothing was expected of it,
// to join with the others; what its patterns match, for coverage; and the branch, as core.
type CheckedBranch(body: Option<(Expression, Typed)>, matches: List<Matches>, core: MatchBranch)
