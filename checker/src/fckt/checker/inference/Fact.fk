import fckt.parser.Position
import fckt.checker.symbols.Symbol
import fckt.checker.types.Row
import fckt.checker.types.Type

// What the checker found, as Noting notes it.
type Fact {
  // The name written in file at, as long as length, is symbol; where it's read as a value, of
  // type t.
  Means(file: Option<String>, at: Position, length: Int, symbol: Symbol, t: Option<Type>),
  // The call in file at does row.
  Does(file: Option<String>, at: Position, row: Row),
  // The local name bound in file at, as long as length, of type t, whether it's written there, and
  // whether it's a parameter, of a function or a lambda.
  Binds(
    file: Option<String>,
    at: Position,
    length: Int,
    name: String,
    t: Type,
    written: Boolean,
    parameter: Boolean,
  ),
  // A type's name written in file at, as long as length, that's one of the language's own, or, if
  // not, a type parameter of what it's written in.
  TypeName(file: Option<String>, at: Position, length: Int, builtin: Boolean),
  // The call or member in file at, its ( or [ or its member's name, gives a t.
  Gives(file: Option<String>, at: Position, t: Type),
  // The local name read or changed in file at, as long as length: the one bound at bound, of
  // type t.
  Reads(file: Option<String>, at: Position, length: Int, name: String, bound: Position, t: Type),
}
