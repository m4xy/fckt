import fckt.collections.Maps.*
import fckt.text.Digests.*
import fckt.checker.diagnostics.*
import fckt.parser.*
import fckt.checker.symbols.*
import fckt.checker.sources.*
import fckt.checker.resolution.*
import fckt.checker.definitions.*
import fckt.checker.expansion.*
import fckt.checker.functors.*
import fckt.checker.metadata.*
import fckt.checker.inference.*
import fckt.checker.types.*
import fckt.checker.types.Types.*

// Checking a program: reading the files it uses, filling in what its declarations say, working out
// what its names mean, then what type everything is, each stage from what the one before found. Each error is reported, and checking goes as far as it can.
module Checker {
  // What each type's name written in each file the program uses means, file by file, the
  // program's own first, and every error found on the way.
  typeNames(
    entry: SourceText,
    tree: SourceTree,
  ): (List<ResolvedFile>, List<Diagnostic>) = Diagnostics.collecting {
    resolved = Diagnostics.recovering {
      workspace = Expansion.expanded(Loader.load(entry, tree))
      namespace = Functors.applied(Resolution.namespace(workspace, tree))
      workspace.files.map { file -> ResolvedFile(file, Resolution.resolvedTypes(file, namespace, workspace.borrowed)) }
    }
    resolved.getOrElse([])
  }

  // The program, checked, as far as it can be, and every error found. With coverage, each when
  // must cover every value of its subject, as it must for a program to compile; tools that only
  // want to know what names mean needn't ask. With facts, what each name written means and what
  // each call does are kept, for tools that show them. With earlier, what checking it before
  // found, what hasn't changed since isn't checked again; and the program has what this check
  // found, for the next.
  check(
    entry: SourceText,
    tree: SourceTree,
    coverage: Boolean,
    facts: Boolean = false,
    earlier: Option<Reuse> = None,
  ): (Option<CheckedProgram>, List<Diagnostic>) = {
    (checked, errors) = checking(entry, tree, coverage, facts, earlier)
    (checked, Diagnostics.ordered(errors))
  }

  private checking(
    entry: SourceText,
    tree: SourceTree,
    coverage: Boolean,
    facts: Boolean,
    earlier: Option<Reuse>,
  ): (Option<CheckedProgram>, List<Diagnostic>) = Diagnostics.collecting {
    Solutions.solving(earlier.map { it.highest }.getOrElse(0)) {
      Diagnostics.recovering {
        workspace = Expansion.expanded(Loader.load(entry, tree))
        namespace = Functors.applied(Resolution.namespace(workspace, tree))
        definitions = Definitions(namespace, Cases.all(namespace), Regions.regioned(namespace))
        // main is checked once nothing else is wrong.
        var noted: List<Fact> = []
        (inferred, errors) = Noting(note = fact -> { if (facts) noted = [fact] + noted }) {
          Diagnostics.collecting {
            inferred = Inference.functionTypes(definitions, coverage, earlier)
            Diagnostics.recovering { AnnotationChecks.checkAll(inferred) }
            inferred
          }
        }
        named = if (facts) namesWritten(
          workspace,
          namespace,
          earlier,
          inferred.reuse,
        ) else emptyMap()
        errors.forEach { report(it) }
        if (errors.isEmpty()) Inference.checkMain(inferred.environment, inferred.known) else Unit
        CheckedProgram(workspace, inferred.functions, defaultHandlers(inferred.environment, inferred.known), inferred.groups, TypeDeclarations.all(definitions),
          TypeDeclarations.toStrings(definitions), declaredEffects(
            inferred.environment,
          ), declaredSpecs(
            inferred.environment,
          ),
          Some(inferred.environment), inferred.facts + Facts.settled(
            noted,
          ) + named.values.flatMap { _, found -> found },
          inferred.reuse.map { r -> r.copy(named = named) })
      }
    }
  }


  // What each type's and annotation's name written in the program's own files means, by each
  // file's path, with its text's digest: as checking it before found, for a file whose text and
  // the program's shape are as they were then.
  private namesWritten(
    workspace: Workspace,
    namespace: Namespace,
    earlier: Option<Reuse>,
    now: Option<Reuse>,
  ): Map<String, (String, List<Fact>)> = {
    same = when ((earlier, now)) {
      (Some(e), Some(n)) -> e.shape == n.shape
      _ -> false
    }
    workspace.files.filter { it.source.project == ProgramProject }.fold(emptyMap()) { found, file ->
      key = file.source.path.getOrElse("")
      digest = file.source.text.md5()
      before = earlier.flatMap { it.named.get(key) }.filter { entry ->
        (was, _) = entry
        same && was == digest
      }
      found.put(key, when (before) {
        Some(kept) -> kept
        None -> (digest, namesIn(file, workspace, namespace))
      })
    }
  }

  private namesIn(file: LoadedFile, workspace: Workspace, namespace: Namespace): List<Fact> = {
      path = file.source.path
      // Their errors are said where they're checked.
      (types, _) = Diagnostics.collecting { Resolution.resolvedTypes(file, namespace, workspace.borrowed) }
      typed = types.flatMap { r ->
        when (r.meaning) {
          DeclaredType(s) -> [Means(path, r.written.at, r.written.name.length, s, None)]
          BuiltinType(_) -> [TypeName(path, r.written.at, r.written.name.length, true)]
          TypeParameterType(_) -> [TypeName(path, r.written.at, r.written.name.length, false)]
          else -> []
        }
      }
      place = Place(file, [])
      annotated = annotationsIn(file.declarations).flatMap { a ->
        found = Lookups.found(Lookups.spec(a.name, place, namespace, Skipping)).orElse {
          Lookups.found(Lookups.annotationType(a.name, place, namespace, Skipping))
        }
        // An annotation is written from its @.
        found.map { s -> Means(path, Position(a.at.line, a.at.column + 1), a.name.length, s, None) }.toList()
      }
      imported = file.imports.flatMap { i ->
        full = i.path.joinToString(".")
        table = namespace.table
        found = table.records.get(
          full,
        ).orElse { table.caseTypes.get(full) }.orElse { table.aliases.get(full) }
          .orElse { table.specs.get(full) }.orElse { table.annotationTypes.get(full) }.orElse { table.functions.get(full) }
          .orElse {
            when (table.modules.get(full)) {
              Some(DeclaredModule(s)) -> Some(s)
              _ -> None
            }
          }
        // On the import's line, its last name.
        last = i.path.lastOrNone().getOrElse("")
        line = file.source.text.lines().getOrNone(i.at.line - 1).getOrElse("")
        written = line.drop(i.at.column - 1).indexOf(full)
        found.filter { _ -> written >= 0 }.map { s ->
          Means(
            path,
            Position(i.at.line, i.at.column + written + full.length - last.length),
            last.length,
            s,
            None,
          )
        }.toList()
      }
      // The spec a module follows, module InMemoryLinks : LinkRepository.
      followed = specsFollowedIn(file.declarations).flatMap { ref ->
        when (ref) {
          NamedType(at, name, _) -> Lookups.found(
            Lookups.spec(name, place, namespace, Skipping),
          ).toList().map { s ->
            last = name.split(".").lastOrNone().getOrElse(name)
            Means(
              path,
              Position(at.line, at.column + name.length - last.length),
              last.length,
              s,
              None,
            )
          }
          _ -> []
        }
      }
      typed + annotated + imported + followed
  }

  private specsFollowedIn(
    declarations: List<Declaration>,
  ): List<TypeRef> = declarations.flatMap { d ->
    when (d.definition) {
      ModuleDefinition(inner, spec, _, _, _) -> spec.toList() + specsFollowedIn(inner)
      else -> []
    }
  }

  private annotationsIn(
    declarations: List<Declaration>,
  ): List<Annotation> = declarations.flatMap { d ->
    d.annotations + when (d.definition) {
      ModuleDefinition(inner, _, _, _, _) -> annotationsIn(inner)
      else -> []
    }
  }
}
