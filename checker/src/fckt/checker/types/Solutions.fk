import fckt.collections.Maps.*

// Where what's learned while solving is kept.
module Solutions {
  // What block gives, with every unknown it makes and solves kept here while it runs. What it
  // gives may hold unknowns this knew the solutions to, so it should resolve them first, with
  // Types.resolvedFully, if they're to mean anything outside. Each unknown it makes is numbered
  // after from, so none is one a type given it from another solving has.
  solving<A>(from: Int = 0, block: @Solving () -> A): A = {
    var made = from
    var solutions: Map<TypeVariable, Type> = emptyMap()
    Solving(
      fresh = () -> {
        made = made + 1
        TypeVariable(made)
      },
      solutionOf = variable -> solutions.get(variable),
      solve = (variable, t) -> { solutions = solutions.put(variable, t) },
    ) { block() }
  }
}
