import fckt.collections.Maps.*
import fckt.checker.annotations.*
import fckt.checker.diagnostics.*
import fckt.checker.resolution.*
import fckt.checker.symbols.*
import fckt.checker.types.*
import fckt.checker.types.Types.*
import fckt.parser.*

// What a type as written is, as a Type: its names resolved where it's written, its aliases
// expanded, and its regions and rows of effects made.
module Conversion {
  // The written type as a Type.
  @Solving @Abandoning typeOf(
    t: TypeRef,
    context: TypeContext,
    definitions: Definitions,
  ): Type = when (t) {
    // A parameter's @Fail () -> A may do Fail and more, which calling it passes on: attempt {
    // println("x"); fail("y") } is @Console where it's called.
    FunctionType(_, parameters, result, effects) -> FunctionOf(
      parameters.map { typeOf(it, context, definitions) },
      typeOf(result, context, definitions),
      if (effects.isEmpty()) context.arrowEffects.getOrElse(pure)
      else rowOf(effects, context.arrowEffects.isSome(), false, context, definitions),
    )
    EffectsType(_, effects) -> Effects(rowOf(effects, false, true, context, definitions))
    TupleType(_, elements) -> TupleOf(elements.map { typeOf(it, context, definitions) })
    GivenType(at, name, _) -> abandon(
      problem(context, at, "'$name = ...' gives a spec value's own type, as in Format<T = Int>"),
    )
    NamedType(at, name, arguments) -> when (parameterOwnType(at, name, arguments, context, definitions)) {
      Some(own) -> own
      None -> when (specNamed(name, context, definitions)) {
        Some(spec) -> specValueType(spec, at, name, arguments, context, definitions)
        None ->
          if (arguments.any { isGiven(it) })
            abandon(
              problem(
                context,
                at,
                "'$name' isn't a spec, so its type arguments aren't named: ${Written.typeRef(NamedType(at, name, arguments.map { unnamed(it) }))}",
              ),
            )
          else namedType(
            at,
            name,
            arguments,
            arguments.map { typeOf(it, context, definitions) },
            context,
            definitions,
          )
      }
    }
  }

  specNamed(name: String, context: TypeContext, definitions: Definitions): Option<Symbol> =
    if (context.typeParameters.containsKey(name) || context.specTypes.containsKey(name) || Types.builtins.containsKey(name)) None
    else when (TypeNames.meaning(name, scopeOf(context), definitions.namespace)) {
      Found(SpecModuleType(spec)) -> Some(spec)
      else -> None
    }

  @Solving @Abandoning private parameterOwnType(
    at: Position,
    name: String,
    arguments: List<TypeRef>,
    context: TypeContext,
    definitions: Definitions,
  ): Option<Type> = {
    parameter = name.split(".").firstOrNone().getOrElse(name)
    own = name.drop(parameter.length + 1)
    if (parameter == name || !startsLowerCase(parameter)) None
    else if (context.laterParameters.contains(parameter))
      abandon(
        problem(
          context,
          at,
          "'$name' names $parameter, which comes after it: a parameter's type can name only those before it",
        ),
      )
    else context.valueParameters.get(parameter).map { given ->
      when (resolved(given)) {
        ModuleValue(specName, ownArguments, _) -> when (definitions.namespace.table.specs.get(specName)) {
          Some(spec) -> {
            if (arguments.isNotEmpty()) abandon(
              problem(context, at, "${Symbols.simpleName(spec)}'s $own takes no type arguments"),
            ) else Unit
            names = ownTypeNames(spec)
            if (!names.contains(own)) abandon(
              problem(context, at, "${Symbols.simpleName(spec)} has no type '$own'"),
            )
            else ownArguments.getOrNone(names.indexOf(own)).getOrElse(given)
          }
          None -> abandon(
            problem(
              context,
              at,
              "'$parameter' isn't a value of a spec with types of its own, so it has no $own",
            ),
          )
        }
        else -> abandon(
          problem(
            context,
            at,
            "'$parameter' isn't a value of a spec with types of its own, so it has no $own",
          ),
        )
      }
    }
  }

  @Solving @Abandoning private specValueType(
    spec: Symbol,
    at: Position,
    name: String,
    arguments: List<TypeRef>,
    context: TypeContext,
    definitions: Definitions,
  ): Type = {
    own = Symbols.simpleName(spec)
    types = ownTypesOf(spec)
    types.find { it.typeParameters.isNotEmpty() }.forEach { t ->
      abandon(
        problem(
          context,
          at,
          "$own's ${t.name} takes type parameters, so a value of $own can't say what it is yet",
        ),
      )
    }
    positional = arguments.filter { !isGiven(it) }
    if (types.isEmpty() && arguments.isNotEmpty()) abandon(
      problem(context, at, "'$name' takes 0 type arguments, not ${arguments.size}"),
    ) else Unit
    if (positional.isNotEmpty()) {
      named = types.zip(
        positional,
      ).map { t, written -> "${t.name} = ${Written.typeRef(written)}" }.joinToString(", ")
      abandon(problem(context, at, "a $own value names its own types: $own<$named>"))
    } else Unit
    given = arguments.mapNotNull { a ->
      when (a) {
        GivenType(givenAt, givenName, written) -> Some((givenAt, givenName, written))
        else -> None
      }
    }
    given.forEachIndexed { i, entry ->
      (givenAt, givenName, _) = entry
      if (types.none { it.name == givenName }) abandon(
        problem(context, givenAt, "$own has no type '$givenName'"),
      )
      else if (given.take(i).any { _, earlier, _ -> earlier == givenName }) abandon(
        problem(context, givenAt, "$own's $givenName is given twice"),
      )
      else Unit
    }
    ownArguments = types.map { t ->
      when (given.find { _, givenName, _ -> givenName == t.name }) {
        Some((_, _, written)) -> typeOf(written, context, definitions)
        None -> Variable(fresh())
      }
    }
    moduleType(spec, at, ownArguments, context, definitions)
  }

  private ownTypesOf(spec: Symbol): List<SpecType> = when (spec.declaration.definition) {
    SpecDefinition(ts, _, _, _, _) -> ts
    else -> []
  }

  ownTypeNames(spec: Symbol): List<String> = ownTypesOf(spec).map { it.name }

  private isGiven(t: TypeRef): Boolean = when (t) {
    GivenType(_, _, _) -> true
    else -> false
  }

  private unnamed(t: TypeRef): TypeRef = when (t) {
    GivenType(_, _, written) -> written
    else -> t
  }

  private startsLowerCase(
    name: String,
  ): Boolean = name.toList().firstOrNone().map { it.isLowerCase() }.getOrElse(false)

  @Solving @Abandoning private namedType(
    at: Position,
    name: String,
    written: List<TypeRef>,
    arguments: List<Type>,
    context: TypeContext,
    definitions: Definitions,
  ): Type = when (context.typeParameters.get(name)) {
    Some(parameter) -> {
      checkArity(name, 0, arguments, at, context)
      parameter
    }
    None -> when (context.specTypes.get(name)) {
      Some(arity) -> {
        checkArity(name, arity, arguments, at, context)
        SpecOwnType(name, arguments)
      }
      None -> builtinOrDeclared(at, name, written, arguments, context, definitions)
    }
  }

  @Solving @Abandoning private builtinOrDeclared(
    at: Position,
    name: String,
    written: List<TypeRef>,
    arguments: List<Type>,
    context: TypeContext,
    definitions: Definitions,
  ): Type = when (Types.builtins.get(name)) {
    Some(arity) -> {
      checkArity(name, arity, arguments, at, context)
      Named(if (name == "Double") "Float" else name, arguments, None)
    }
    None -> when (TypeNames.meaning(name, scopeOf(context), definitions.namespace)) {
      Found(DeclaredType(symbol)) -> {
        parameters = typeParametersOf(symbol)
        given = withEffectArguments(name, written, parameters, arguments, context)
        checkArity(name, parameters.size, given, at, context)
        declared(symbol, given, context, definitions)
      }
      Found(SpecModuleType(spec)) -> specValueType(spec, at, name, written, context, definitions)
      Found(_) -> abandon(problem(context, at, "unknown type '$name'"))
      Refused(why) -> abandon(problem(context, at, why))
      NotFound -> abandon(problem(context, at, "unknown type '$name'"))
    }
  }

  // The type of a module that follows the spec, as a value: Plugin; or, for a spec with types of its
  // own, with what they are, in the order the spec declares them.
  @Abandoning moduleType(
    spec: Symbol,
    at: Position,
    arguments: List<Type>,
    context: TypeContext,
    definitions: Definitions,
  ): Type = {
    own = Symbols.simpleName(spec)
    (types, typeParameters) = when (spec.declaration.definition) {
      SpecDefinition(ts, _, ps, _, _) -> (ts, ps)
      else -> ([], [])
    }
    if (Annotations.isEffect(spec, definitions.namespace)) {
      abandon(
        problem(
          context,
          at,
          "'$own' is an effect: a function does it, written @$own, and a handler answers it; no value has its type",
        ),
      )
    } else Unit
    types.find { it.typeParameters.isNotEmpty() }.forEach { t ->
      abandon(
        problem(
          context,
          at,
          "$own's ${t.name} takes type parameters, so a value of $own can't say what it is yet",
        ),
      )
    }
    if (typeParameters.isNotEmpty()) abandon(
      problem(context, at, "$own takes type parameters, so it can't be a value's type yet"),
    ) else Unit
    ModuleValue(spec.name, arguments, types.map { it.name })
  }

  // What TypeNames needs of the context: the names of the type parameters in scope.
  private scopeOf(context: TypeContext): TypeScope =
    TypeScope(context.place, context.typeParameters.toList().map { name, _ -> name }, [])

  @Abandoning private checkArity(
    name: String,
    arity: Int,
    arguments: List<Type>,
    at: Position,
    context: TypeContext,
  ): Unit =
    if (arguments.size == arity) Unit
    else abandon(
      problem(
        context,
        at,
        "'$name' takes $arity type argument${if (arity == 1) "" else "s"}, not ${arguments.size}",
      ),
    )

  // The arguments written for a type whose parameters these are, with what goes to its effect
  // parameters: effects, as in Queue<@Console>, and, for any left out, anything, as Queue is.
  @Solving @Abandoning private withEffectArguments(
    name: String,
    written: List<TypeRef>,
    parameters: List<String>,
    arguments: List<Type>,
    context: TypeContext,
  ): List<Type> = {
    effectParameters = parameters.count { it.startsWith("@") }
    writtenEffects = written.any { isEffectsRef(it) }
    if (effectParameters == 0 && !writtenEffects) arguments
    else if (arguments.size == parameters.size) {
      parameters.zip(written).forEach { parameter, given ->
        if (parameter.startsWith("@") && !isEffectsRef(given))
          abandon(
            problem(
              context,
              Positions.ofType(given),
              "$name's ${parameter.removePrefix("@")} is effects, like $name<@Console>, not a type",
            ),
          )
        else if (!parameter.startsWith("@") && isEffectsRef(given))
          abandon(
            problem(context, Positions.ofType(given), "$name's $parameter is a type, not effects"),
          )
        else Unit
      }
      arguments
    } else if (arguments.size != parameters.size - effectParameters || writtenEffects) arguments
    else interleaved(parameters, arguments)
  }

  // A type for each parameter: the next of the arguments for a type parameter, anything for an
  // effect parameter.
  @Solving private interleaved(
    parameters: List<String>,
    arguments: List<Type>,
  ): List<Type> = when (parameters) {
    [] -> []
    [p, *rest] ->
      if (p.startsWith("@")) [Variable(fresh()), *interleaved(rest, arguments)]
      else when (arguments) {
        [a, *more] -> [a, *interleaved(rest, more)]
        [] -> []
      }
  }

  private isEffectsRef(t: TypeRef): Boolean = when (t) {
    EffectsType(_, _) -> true
    else -> false
  }



  // The type parameters a type declaration declares.
  typeParametersOf(symbol: Symbol): List<String> = when (symbol.declaration.definition) {
    RecordDefinition(typeParameters, _, _, _, _) -> typeParameters
    CasesDefinition(typeParameters, _, _, _) -> typeParameters
    AliasDefinition(typeParameters, _) -> typeParameters
    else -> []
  }

  // The declared type applied to the arguments, as seen from the context's place, with a region
  // if its values can change.
  @Solving @Abandoning declared(
    symbol: Symbol,
    arguments: List<Type>,
    context: TypeContext,
    definitions: Definitions,
  ): Type =
    withRegion(symbol, seenFrom(symbol, arguments, context, definitions), context, definitions)

  @Solving @Abandoning private seenFrom(
    symbol: Symbol,
    arguments: List<Type>,
    context: TypeContext,
    definitions: Definitions,
  ): Type =
    if (isAbstractHere(symbol, context.seenFrom.getOrElse(context.place), definitions) || (context.outsideView && isAbstract(symbol, definitions))) outsideType(
      symbol.path.joinToString("."),
      Symbols.simpleName(symbol),
      arguments,
      context,
      definitions,
    )
    else when (symbol.declaration.definition) {
      AliasDefinition(_, _) -> expand(symbol, arguments, context, definitions)
      else -> Named(symbol.name, arguments, None)
    }

  // Whether the type can be named here but not seen into: an opaque type outside its module, or a
  // functor's parameter's type, outside the module that stands for what it's given.
  isAbstractHere(symbol: Symbol, place: Place, definitions: Definitions): Boolean =
    isAbstract(symbol, definitions) && !Visibility.isInside(place, symbol.path)

  // Whether the type is abstract outside its module: opaque, or a functor's parameter's.
  isAbstract(symbol: Symbol, definitions: Definitions): Boolean =
    symbol.declaration.opaque || definitions.namespace.modules.parameterModules.contains(
      symbol.path.joinToString("."),
    )

  // Whether a module the path is in has an opaque alias, which its functions' inferred types show as
  // what it stands for, and callers outside see as written.
  isOpaqueAround(path: List<String>, definitions: Definitions): Boolean =
    definitions.namespace.table.aliases.toList().any { _, a -> a.declaration.opaque && a.path.isNotEmpty() && path.take(a.path.size) == a.path }

  // What the owner module's type of that name, applied to the arguments, is outside it: what its
  // spec's type arguments say it is; or, for an opaque record or type with cases, itself, with only
  // what's in it hidden; or abstract.
  @Solving @Abandoning outsideType(
    owner: String,
    name: String,
    arguments: List<Type>,
    context: TypeContext,
    definitions: Definitions,
  ): Type = {
    modules = definitions.namespace.modules
    table = definitions.namespace.table
    full = "$owner.$name"
    when (modules.fixedTypes.get(full)) {
      Some(fixed) -> fixedType(fixed, name, arguments, context, definitions)
      None -> {
        declared = table.records.get(
          full,
        ).orElse { table.caseTypes.get(full) }.orElse { table.aliases.get(full) }
          .filter { _ -> !modules.parameterModules.contains(owner) }
        when (declared.map { d -> (d, d.declaration.definition) }) {
          Some((d, AliasDefinition(_, _))) -> if (d.declaration.opaque) Abstract(
            full,
            arguments,
          ) else expand(
            d,
            arguments,
            context,
            definitions,
          )
          Some((d, _)) -> Named(d.name, arguments, None)
          None -> Abstract(full, arguments)
        }
      }
    }
  }

  // A type a spec's type argument fixes: what the argument is, given the type's own arguments, which
  // it must take as many more of as the type takes parameters.
  @Solving @Abandoning private fixedType(
    fixed: Symbol,
    name: String,
    arguments: List<Type>,
    context: TypeContext,
    definitions: Definitions,
  ): Type = {
    n = typeParametersOf(fixed).size
    when (Diagnostics.attempting { expand(fixed, arguments, context, definitions) }) {
      Ok(t) -> t
      Error(d) ->
        if (n == 0) abandon(d)
        else abandon(
          Diagnostic(
            d.file,
            d.at,
            "$name takes $n type parameter${if (n == 1) "" else "s"}, so its type argument must take $n more: ${d.message}",
          ),
        )
    }
  }

  // The type, of the declaration, with a region if its values can change: the one it's in, or its own.
  @Solving private withRegion(
    symbol: Symbol,
    t: Type,
    context: TypeContext,
    definitions: Definitions,
  ): Type = when (t) {
    Named(name, arguments, None) if definitions.regioned.contains(symbol.name) ->
      Named(name, arguments, Some(context.region.getOrElse(Variable(fresh()))))
    else -> t
  }

  // A new region for a value of the type being made, if its values can change.
  @Solving newRegion(symbol: Symbol, definitions: Definitions): Option<Type> =
    if (definitions.regioned.contains(symbol.name)) Some(Variable(fresh())) else None

  // What the alias stands for, applied to the arguments; its target means what it does where it's
  // written. In module Results<E>, type M<A> = Result<A, E> has the E of what uses it there;
  // elsewhere, any.
  @Solving @Abandoning expand(
    alias: Symbol,
    arguments: List<Type>,
    context: TypeContext,
    definitions: Definitions,
  ): Type =
    when (alias.declaration.definition) {
      AliasDefinition(typeParameters, target) ->
        if (context.expanding.contains(alias.name)) {
          abandon(
            Diagnostic(
              alias.file.source.path,
              alias.declaration.at,
              "type '${Symbols.simpleName(alias)}' is defined in terms of itself",
            ),
          )
        } else {
          inModule = Visibility.isInside(context.place, alias.path)
          moduleParameters = moduleTypeParameters(alias.path, definitions).map { p ->
            (p, if (inModule) context.typeParameters.getOrElse(p) { Variable(fresh()) } else Variable(fresh()))
          }
          inner = TypeContext(
            Place(alias.file, alias.path),
            (moduleParameters + typeParameters.zip(arguments)).toMap(),
            context.region,
            context.arrowEffects,
            context.expanding + [alias.name],
            context.specTypes,
            context.outsideView,
            context.seenFrom,
          )
          typeOf(target, inner, definitions)
        }
      else -> Named(alias.name, arguments, None)
    }

  // The type parameters of the module at the path: E, for module Results<E>.
  moduleTypeParameters(path: List<String>, definitions: Definitions): List<String> =
    when (definitions.namespace.table.modules.get(path.joinToString("."))) {
      Some(DeclaredModule(Symbol(_, _, Declaration(_, _, ModuleDefinition(_, _, _, _, typeParameters), _, _, _), _))) -> typeParameters
      else -> []
    }

  // ---- Effects ----

  // The row the annotations say: the effects they name, and an effect parameter's, whose rest is
  // its own. Without one, open leaves room for more. A row of effects alone may be pure, which
  // names no effect.
  @Solving @Abandoning rowOf(
    annotations: List<Annotation>,
    open: Boolean,
    pure: Boolean,
    context: TypeContext,
    definitions: Definitions,
  ): Row = {
    (parameters, named) = annotations.partition { context.typeParameters.containsKey("@${it.name}") }
    when (parameters) {
      [_, second, *_] -> abandon(
        problem(context, second.at, "effects can name only one effect parameter"),
      )
      else -> Unit
    }
    labels = labelsOf(named, context, definitions).filter { !pure || it.name != "fckt.lang.Pure" }
    when (parameters) {
      [parameter, *_] -> {
        own = rowOfType(
          context.typeParameters.getOrElse("@${parameter.name}") { Effects(Types.pure) },
        )
        Row((labels + own.labels).distinct(), own.rest)
      }
      [] -> Row(labels, if (open) Some(fresh()) else None)
    }
  }

  // An effect parameter's row: what it's been found to be, or, while unknown, any.
  @Solving private rowOfType(t: Type): Row = when (resolved(t)) {
    Effects(row) -> flattened(row)
    Variable(v) -> Row([], Some(v))
    else -> Types.pure
  }

  // The effects a function type's annotations say it has, @Io (String) -> Unit: each must be, or
  // carry, one. A generic effect has its type arguments: @Yielding<Int> () -> Unit.
  @Solving @Abandoning private labelsOf(
    annotations: List<Annotation>,
    context: TypeContext,
    definitions: Definitions,
  ): List<EffectLabel> =
    annotations.flatMap { a ->
      namespace = definitions.namespace
      when (Annotations.declarationOf(a, context.place, namespace)) {
        None -> abandon(
          problem(
            context,
            a.at,
            "unknown effect '${a.name}'${ImportHints.forName(a.name, namespace)}",
          ),
        )
        Some(declaration) if Symbols.isSpec(declaration) && a.typeArguments.isNotEmpty() ->
          [EffectLabel(declaration.name, a.typeArguments.map { typeOf(it, context, definitions) })]
        Some(_) -> when (Annotations.effectsOf([a], context.place, a.at, namespace)) {
          [] -> abandon(
            problem(
              context,
              a.at,
              "'${a.name}' isn't an effect; declare one with effect ${a.name.split(".").lastOrNone().getOrElse(a.name)}",
            ),
          )
          effects -> effects.map { EffectLabel(it, []) }
        }
      }
    }

  // ---- Fields ----

  // The types of a record's fields, for its type arguments, holding values in the region, as seen
  // from the place, if it's given.
  @Solving @Abandoning recordFields(
    record: Symbol,
    arguments: List<Type>,
    region: Option<Type>,
    definitions: Definitions,
    seenFrom: Option<Place> = None,
  ): List<Type> =
    when (record.declaration.definition) {
      RecordDefinition(typeParameters, fields, _, _, _) -> {
        context = TypeContext(
          Place(record.file, record.path),
          typeParameters.zip(arguments).toMap(),
          region,
          None,
          [],
          emptyMap(),
          false,
          seenFrom,
        )
        fields.map { typeOf(it.fieldType, context, definitions) }
      }
      else -> []
    }

  // The types of a case's fields, as the type with cases whose parameters are given has it, for
  // that type's arguments: an included case's in terms of the type it's included from, given the
  // type arguments it's included with.
  @Solving @Abandoning caseFields(
    c: CaseInfo,
    parameters: List<String>,
    arguments: List<Type>,
    region: Option<Type>,
    definitions: Definitions,
    seenFrom: Option<Place> = None,
  ): List<Type> =
    when (c.source) {
      OwnCase -> {
        context = TypeContext(
          Place(c.origin.file, c.origin.path),
          parameters.zip(arguments).toMap(),
          region,
          None,
          [],
          emptyMap(),
          false,
          seenFrom,
        )
        c.definition.fields.map { typeOf(it.fieldType, context, definitions) }
      }
      NamedCase(from) -> caseFields(from, [], [], region, definitions, seenFrom)
      IncludedCase(included, written, place, from) -> {
        context = TypeContext(
          place,
          parameters.zip(arguments).toMap(),
          region,
          None,
          [],
          emptyMap(),
          false,
          seenFrom,
        )
        caseFields(
          from,
          Cases.typeParametersOf(included),
          written.map { typeOf(it, context, definitions) },
          region,
          definitions,
          seenFrom,
        )
      }
    }

  // The cases of the type with cases, each with its fields' types for the type's arguments, as seen
  // from the place, if it's given.
  @Solving @Abandoning casesWithFields(
    caseType: Symbol,
    arguments: List<Type>,
    region: Option<Type>,
    definitions: Definitions,
    seenFrom: Option<Place> = None,
  ): List<(CaseInfo, List<Type>)> =
    definitions.cases.getOrDefault(caseType.name, []).map { c ->
      (c, caseFields(c, Cases.typeParametersOf(caseType), arguments, region, definitions, seenFrom))
    }

  private problem(
    context: TypeContext,
    at: Position,
    message: String,
  ): Diagnostic = Diagnostic(context.place.file.source.path, at, message)
}
