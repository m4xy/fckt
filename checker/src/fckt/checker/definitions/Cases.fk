import fckt.collections.Maps.*
import fckt.checker.diagnostics.*
import fckt.checker.resolution.*
import fckt.checker.symbols.*
import fckt.parser.*

// The cases of each type with cases: those it declares, then those it names one by one, Owner.Case,
// then those of each type it includes, *Other. A case it has twice is one case, if its fields are
// the same types both times.
module Cases {
  // Every type with cases' cases, by its full name.
  @Abandoning all(namespace: Namespace): Map<String, List<CaseInfo>> = {
    computing = Computing(namespace, emptyMap())
    namespace.table.caseTypes.toList().forEach { _, symbol ->
      // Worked out for what it keeps in computing.
      casesOf(computing, symbol, [])
      Unit
    }
    computing.done
  }

  // Whether two are the same case: the same type's case of the same name.
  same(
    a: CaseInfo,
    b: CaseInfo,
  ): Boolean = a.origin.name == b.origin.name && a.definition.name == b.definition.name

  // The case's fields' types as written, in the terms of the type that has it: an included case's
  // with the type arguments it's included with in place of its own type's parameters.
  writtenFields(c: CaseInfo): List<TypeRef> = when (c.source) {
    OwnCase -> c.definition.fields.map { it.fieldType }
    NamedCase(from) -> writtenFields(from)
    IncludedCase(included, arguments, _, from) -> {
      substitution = typeParametersOf(included).zip(arguments).toMap()
      writtenFields(from).map { substituted(it, substitution) }
    }
  }

  // The type parameters a type with cases declares.
  typeParametersOf(symbol: Symbol): List<String> = when (symbol.declaration.definition) {
    CasesDefinition(typeParameters, _, _, _) -> typeParameters
    else -> []
  }

  // The cases worked out so far, by type.
  private type Computing(namespace: Namespace, var done: Map<String, List<CaseInfo>>)

  // The type's cases, working out those of the types it takes cases from first; visiting are the
  // types whose cases are being worked out around this, which it mustn't take from.
  @Abandoning @Mutating private casesOf(computing: Computing, symbol: Symbol, visiting: List<String>): List<CaseInfo> =
    when (computing.done.get(symbol.name)) {
      Some(cases) -> cases
      None -> {
        if (visiting.contains(symbol.name)) abandon(problem(symbol, symbol.declaration.at, "type '${Symbols.simpleName(symbol)}' includes itself"))
        else Unit
        place = Place(symbol.file, symbol.path)
        inner = visiting + [symbol.name]
        found = when (symbol.declaration.definition) {
          CasesDefinition(_, cases, caseRefs, includes) -> {
            own = cases.map { c -> (CaseInfo(symbol, c, OwnCase), c.at) }
            named = caseRefs.map { ref -> (namedCase(computing, symbol, ref, place, inner), ref.at) }
            included = includes.flatMap { include -> includedCases(computing, symbol, include, place, inner) }
            (own + named + included).fold([]) { result, entry ->
              (c, at) = entry
              added(symbol, result, c, at)
            }
          }
          else -> []
        }
        computing.done = computing.done.put(symbol.name, found)
        found
      }
    }

  // Owner.Case: the case of that name of a type that takes no type parameters.
  @Abandoning @Mutating private namedCase(
    computing: Computing,
    symbol: Symbol,
    ref: CaseRef,
    place: Place,
    visiting: List<String>,
  ): CaseInfo =
    when (Lookups.caseType(ref.owner, place, computing.namespace, Refusing)) {
      Refused(why) -> abandon(problem(symbol, ref.at, why))
      NotFound -> abandon(problem(symbol, ref.at, "unknown type '${ref.owner}'"))
      Found(owner) -> {
        own = Symbols.simpleName(owner)
        if (typeParametersOf(owner).isNotEmpty()) {
          abandon(
            problem(
              symbol,
              ref.at,
              "can't take single cases from the generic type $own; include it whole with *$own<...>",
            ),
          )
        } else Unit
        when (casesOf(computing, owner, visiting).filter { it.definition.name == ref.caseName }) {
          [c] -> CaseInfo(c.origin, c.definition, NamedCase(c))
          [] -> abandon(problem(symbol, ref.at, "$own has no case '${ref.caseName}'"))
          else -> abandon(problem(symbol, ref.at, "$own has several cases named '${ref.caseName}'"))
        }
      }
    }

  // *Other<A>: each of Other's cases, as included.
  @Abandoning @Mutating private includedCases(computing: Computing, symbol: Symbol, include: TypeRef, place: Place, visiting: List<String>): List<(CaseInfo, Position)> =
    when (include) {
      NamedType(at, name, arguments) -> when (Lookups.caseType(name, place, computing.namespace, Refusing)) {
        Refused(why) -> abandon(problem(symbol, at, why))
        NotFound -> abandon(
          problem(symbol, at, "'*' takes a type with cases, and '$name' isn't one"),
        )
        Found(other) -> casesOf(computing, other, visiting).map { c ->
          (CaseInfo(c.origin, c.definition, IncludedCase(other, arguments, place, c)), at)
        }
      }
      else -> []
    }

  // The cases with the case added, unless it's there already with the same fields' types.
  @Abandoning private added(symbol: Symbol, cases: List<CaseInfo>, c: CaseInfo, at: Position): List<CaseInfo> =
    when (cases.find { same(it, c) }) {
      None -> cases + [c]
      Some(existing) ->
        if (writtenFields(existing).map { Written.typeRef(it) } == writtenFields(c).map { Written.typeRef(it) }) cases
        else abandon(
          problem(
            symbol,
            at,
            "'${symbol.name}' takes ${c.origin.name}.${c.definition.name} twice, with different types",
          ),
        )
    }

  // A type as written, with each name the substitution has, and no type arguments, in its place.
  private substituted(t: TypeRef, substitution: Map<String, TypeRef>): TypeRef = when (t) {
    NamedType(at, name, []) if substitution.containsKey(name) -> substitution.getOrDefault(name, t)
    NamedType(at, name, arguments) -> NamedType(at, name, arguments.map { substituted(it, substitution) })
    FunctionType(at, parameters, result, effects) -> FunctionType(at, parameters.map { substituted(it, substitution) }, substituted(result, substitution), effects)
    TupleType(at, elements) -> TupleType(at, elements.map { substituted(it, substitution) })
    EffectsType(_, _) -> t
    GivenType(at, name, given) -> GivenType(at, name, substituted(given, substitution))
  }

  private problem(symbol: Symbol, position: Position, message: String): Diagnostic = Diagnostic(symbol.file.source.path, position, message)
}
