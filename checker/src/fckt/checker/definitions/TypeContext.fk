import fckt.collections.Maps.*
import fckt.checker.resolution.Place
import fckt.checker.types.*

// What a written type means where it's written: the place, which decides what its names mean; what
// each type parameter in scope there stands for; while converting a type's fields, the region of
// the value they're in, which what they hold shares; while converting a function's parameters'
// types, its own row, which a function type written there without effects shares, so map(xs, f)
// does what f does; the aliases being expanded, none of which can be in its own expansion; and, in
// a spec, its own types, with how many type parameters each takes; whether it's read as callers
// outside its module see it, so that an opaque type there is opaque inside too; and where it's seen
// from, if not where it's written, which decides whether an opaque type in it is: a record's field's
// type, seen from outside the module of the opaque type it names, is that opaque type.
type TypeContext(
  place: Place,
  typeParameters: Map<String, Type>,
  region: Option<Type> = None,
  arrowEffects: Option<Row> = None,
  expanding: List<String> = [],
  specTypes: Map<String, Int> = emptyMap(),
  outsideView: Boolean = false,
  seenFrom: Option<Place> = None,
)
