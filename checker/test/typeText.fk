import uk.m4xy.fktests.api.Test
import fckt.checker.types.*
import fckt.checker.types.Types.*
import fckt.checker.types.TypeText.*

// Types, as messages show them.

@Test showsTypesAsKotlinWritesThem() = Solutions.solving {
  assertEquals("Int", shown(int))
  assertEquals("List<Option<String>>", shown(listOf(optionOf(string))))
  assertEquals("(Int, Char)", shown(TupleOf([int, char])))
  assertEquals("(Int, String) -> Boolean", shown(FunctionOf([int, string], boolean, pure)))
  assertEquals("A", shown(TypeParameter("A")))
}

@Test namesUnknownsInTheOrderTheyreMet() = Solutions.solving {
  a = Variable(fresh())
  b = Variable(fresh())
  assertEquals("(T1, T2) -> T1", shown(FunctionOf([b, a], b, pure)))
  assertEquals(["List<T1>", "Option<T2>", "T1"], shownTogether([listOf(a), optionOf(b), a]))
}

@Test showsWhatAFunctionDoes() = Solutions.solving {
  assertEquals("@Console @FileSystem () -> Unit", shown(FunctionOf([], unit, rowOf(["fckt.io.FileSystem", "fckt.io.Console"], Some(fresh())))))
}

@Test showsEffectsAsATypeArgument() = Solutions.solving {
  e = fresh()
  assertEquals("Queue<@Pure>", shown(Named("Queue", [Effects(pure)], None)))
  assertEquals("Queue<@Console @T1>", shown(Named("Queue", [Effects(rowOf(["fckt.io.Console"], Some(e)))], None)))
}

@Test showsWhatsBeenSolved() = Solutions.solving {
  v = fresh()
  solve(v, int)
  assertEquals("List<Int>", shown(listOf(Variable(v))))
}
