// What a type is.
type TypeBody {
  // type t: nothing said of it.
  AbstractType,
  // type t = int list
  AliasType(typexpr: Typexpr),
  // type t = { a : int; mutable b : string }
  RecordType(fields: List<FieldDeclaration>),
  // type t = A | B of int | C of { x : int }
  VariantType(constructors: List<ConstructorDeclaration>),
  // type t = [ `A | `B of int * string ]: a closed polymorphic variant, whose tags other types can
  // have too.
  PolymorphicVariantType(tags: List<Tag>),
}
