// A type, as OCaml writes it: 'a, int list, (int, string) result, int -> bool, int * string.
type Typexpr {
  TypeVar(name: String),
  // A type constructor with its arguments, if it takes any: the name may be a path, M.t.
  TypeApplication(name: String, arguments: List<Typexpr>),
  Arrow(parameter: Typexpr, result: Typexpr),
  Product(parts: List<Typexpr>),
  // A type for any types the variables stand for, as a record's field may be: 'a. (unit -> 'a) -> 'a.
  Polymorphic(variables: List<String>, body: Typexpr),
}
