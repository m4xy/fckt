import fckt.checker.core.*
import fckt.checker.types.*
import fckt.ocaml.*

// fckt's types as OCaml's: Int is int, List<A> 'a list, a type declared in geometry Geometry.shape.
module OcamlTypes {
  @Lowering typexpr(t: Type): Typexpr = typexprNaming(t, [])

  // The type, with each unknown named as given, as a signature's values are; any other, whatever
  // OCaml works out.
  @Lowering typexprNaming(t: Type, variables: List<(TypeVariable, String)>): Typexpr = when (t) {
    Variable(v) -> TypeVar(variables.find { variable, _ -> variable == v }.map { _, name -> name }.getOrElse("_"))
    TypeParameter(name) -> TypeVar("'" + name.lowercase())
    // A spec's own type, in its module type.
    SpecOwnType(name, arguments) -> TypeApplication(Naming.snake(name).removeSuffix("_"), arguments.map { typexprNaming(it, variables) })
    // A module given as a value of a spec: (module Format with type t = point), its own types as its
    // type arguments say.
    ModuleValue(spec, arguments, _) ->
      TypeApplication("(module " + packageType(spec, arguments.map { Printer.typexpr(typexprNaming(it, variables), 0) }) + ")", [])
    Named(name, arguments, _) -> named(name, arguments, variables)
    Abstract(name, arguments) -> named(name, arguments, variables)
    TupleOf(parts) -> Product(parts.map { typexprNaming(it, variables) })
    FunctionOf(parameters, result, _) ->
      (if (parameters.isEmpty()) [TypeApplication("unit", [])] else parameters.map { typexprNaming(it, variables) }).reversed().fold(typexprNaming(result, variables)) { r, p -> Arrow(p, r) }
    // What OCaml can work out for itself.
    _ -> TypeVar("_")
  }

  @Lowering private named(name: String, arguments: List<Type>, variables: List<(TypeVariable, String)>): Typexpr = {
    given = ocamlArguments(name, arguments).map { typexprNaming(it, variables) }
    when (declarationOf(name)) {
      // OCaml's own type, as its OCaml is written, each type parameter P, written 'p, replaced.
      Some(DeclaredExternal(_, parameters, ocaml)) -> TypeApplication("(" + externalText(ocaml, parameters, given) + ")", [])
      _ -> builtinOrDeclared(name, given)
    }
  }

  private externalText(ocaml: String, parameters: List<String>, given: List<Typexpr>): String =
    parameters.zip(given).fold(ocaml) { text, entry ->
      (p, t) = entry
      text.replace(parameter(p), "(" + Printer.typexpr(t, 0) + ")")
    }

  @Lowering private builtinOrDeclared(name: String, given: List<Typexpr>): Typexpr = {
    when (name) {
      "Int" -> TypeApplication("int", [])
      "Float" -> TypeApplication("float", [])
      "Double" -> TypeApplication("float", [])
      "String" -> TypeApplication("string", [])
      "Boolean" -> TypeApplication("bool", [])
      "Unit" -> TypeApplication("unit", [])
      "Nothing" -> TypeApplication("fk_nothing", [])
      "Char" -> TypeApplication("int", [])
      "Byte" -> TypeApplication("char", [])
      "List" -> TypeApplication("list", given)
      "Option" -> TypeApplication("option", given)
      "Result" -> TypeApplication("result", given)
      "Lazy" -> TypeApplication("Lazy.t", given)
      else -> TypeApplication(typeReference(name), given)
    }
  }

  // A declared type, by its full name, written from the module it's used in: Geometry.shape.
  @Lowering typeReference(full: String): String = {
    parts = full.split(".")
    (Naming.relative(parts.dropLast(1)).map { Naming.moduleName(it) } + [Naming.snake(parts.lastOrNone().getOrElse(full))]).joinToString(".")
  }

  // A spec's module type, by its full name, written from the module it's used in: Formats.Format.
  // A value of the spec, Format with type t = point: its own types, if it has any, as given.
  @Lowering packageType(spec: String, given: List<String>): String =
    typeModuleReference(spec) + ownTypes(spec).zip(given).mapIndexed { i, entry ->
      (t, typeGiven) = entry
      (if (i == 0) " with" else " and") + " type " + t + " = " + typeGiven
    }.joinToString("")

  // The spec's own types, as OCaml names them.
  @Lowering ownTypes(spec: String): List<String> = specOf(spec).map { d -> d.types.map { name, _ -> Naming.snake(name).removeSuffix("_") } }.getOrElse([])

  @Lowering typeModuleReference(full: String): String = {
    parts = full.split(".")
    (Naming.relative(parts.dropLast(1)) + [parts.lastOrNone().getOrElse(full)]).map { Naming.moduleName(it) }.joinToString(".")
  }

  // The OCaml name a declared type has where it's declared: shape.
  ownName(full: String): String = Naming.snake(full.split(".").lastOrNone().getOrElse(full))

  // A type's arguments that OCaml has: not those for its effect parameters, nor effects.
  @Lowering ocamlArguments(name: String, arguments: List<Type>): List<Type> = when (declarationOf(name).map { Declarations.parameters(it) }) {
    Some(parameters) if parameters.size == arguments.size -> parameters.zip(arguments).filter { p, _ -> !p.startsWith("@") }.map { _, a -> a }
    _ -> arguments.filter { it !is Effects }
  }

  // A type parameter, as OCaml writes it: 'a for A.
  parameter(name: String): String = "'" + name.lowercase()

  // A type's type parameters that OCaml has: not those that stand for effects, as @E does.
  ocamlParameters(names: List<String>): List<String> = names.filter { !it.startsWith("@") }
}
