import fckt.collections.Maps.*
import fckt.effects.Fail
import fckt.checker.CheckedProgram
import fckt.checker.core.*
import fckt.checker.inference.*
import fckt.checker.symbols.*
import fckt.checker.sources.*
import fckt.ocaml.*
import fckt.parser.Declaration
import fckt.parser.Definition

// A checked program, as OCaml: its own code, to be linked with the core and the standard library as
// fckt's compiler compiles them on their own, as fckt_core.ml and fckt_std.ml; or, whole, with the
// core's, the standard library's and every other project's code too, a program on its own. What it
// can't lower yet, it fails saying.
module Programs {
  @Fail ocaml(program: CheckedProgram, whole: Boolean = false): List<Item> =
    Lowering(
      toStringOf = name -> program.toStrings.get(name),
      declarationOf = name -> program.types.find { Declarations.declaredAt(it).name == name },
      isShared = name -> sharing(program).contains(name),
      inside = ~[],
    ) { items(program, whole) }

  @Fail @Lowering private items(program: CheckedProgram, whole: Boolean): List<Item> = {
    isOwn = (s: Symbol) -> whole || ownedByProgram(s)
    bodies = program.functions.filter { f -> isOwn(f.function) }.mapNotNull { f -> f.body.map { b -> (f.function, f.scheme.template, b) } }
    groups = program.groups.mapNotNull { g ->
      functions = g.functions.mapNotNull { f -> bodies.find { s, _, _ -> s.name == f.name } }
      if (functions.isEmpty()) None else Some((g, functions))
    }
    standard = if (whole) [] else aliases(program)
    functors = functorsOf(program, whole)
    // A functor's own code isn't lowered: each module it makes is a copy of it, with the modules given.
    lowered = (s: Symbol) -> isOwn(s) && functors.none { f -> s.path.size >= f.size && s.path.take(f.size) == f }
    own = OwnCode(
      groups.mapNotNull { g, functions ->
        kept = functions.filter { f, _, _ -> lowered(f) }
        if (kept.isEmpty()) None else Some((g, kept))
      },
      program.types.filter { t -> lowered(Declarations.declaredAt(t)) },
      program.effects.filter { e -> lowered(e.effect) },
      program.specs.filter { s -> lowered(s.spec) },
      modulesOf(program, whole).filter { m -> functors.none { f -> m.size >= f.size && m.take(f.size) == f } } + (if (standard.isEmpty()) [] else [["fckt"]]),
      standard.map { (["fckt"], it) },
    )
    main = program.functions.find { f -> isOwn(f.function) && f.function.path.isEmpty() && Naming.ownName(f.function) == "main" }.map { f ->
      takesArguments = Signatures.parametersOf(f.function).map { it.isNotEmpty() }.getOrElse(false)
      LetItem(false, [Binding(ConstantPat(UnitConstant), [], None, HandledEffects.runningMain(f.function, takesArguments, program.defaultHandlers))])
    }
    [VerbatimItem(Helpers.items)] + Structures.items([], own) + main.toList()
  }

  // The types with cases that share them: one that has another's case, and the other.
  private sharing(program: CheckedProgram): List<String> = program.types.flatMap { t ->
    when (t) {
      DeclaredCases(caseType, _, cases) -> cases.filter { c -> c.case.owner.name != caseType.name }.flatMap { c -> [caseType.name, c.case.owner.name] }
      else -> []
    }
  }.distinct()

  // Whether the declaration is the program's own: in its own project, not one it uses.
  private ownedByProgram(s: Symbol): Boolean = s.file.source.project == ProgramProject

  // The path of each module and package the program's own project declares, those in them among them.
  private modulesOf(program: CheckedProgram, whole: Boolean): List<List<String>> =
    program.workspace.files.filter { f -> whole || f.source.project == ProgramProject }.flatMap { f ->
      packages = (1..f.package.size).map { n -> f.package.take(n) }
      packages + modulesIn(f.declarations, f.package)
    }.distinct()

  // The path of each functor the program's own project declares.
  private functorsOf(program: CheckedProgram, whole: Boolean): List<List<String>> =
    program.workspace.files.filter { f -> whole || f.source.project == ProgramProject }.flatMap { f -> functorsIn(f.declarations, f.package) }

  private functorsIn(declarations: List<Declaration>, path: List<String>): List<List<String>> = declarations.flatMap { d ->
    when (d.definition) {
      ModuleDefinition(_, _, [_, *_], _, _) -> [path + [d.name]]
      ModuleDefinition(inner, _, [], None, _) -> functorsIn(inner, path + [d.name])
      else -> []
    }
  }

  private modulesIn(declarations: List<Declaration>, path: List<String>): List<List<String>> = declarations.flatMap { d ->
    when (d.definition) {
      ModuleDefinition(inner, _, _, None, _) -> [path + [d.name]] + modulesIn(inner, path + [d.name])
      else -> []
    }
  }

  // The standard library's packages and the core, by the names the program's code writes them by,
  // in fckt's module: Fckt.Io is Fckt_std.Fckt.Io, and Fckt.Lang Fckt_core.Fckt.Lang.
  private aliases(program: CheckedProgram): List<Item> =
    program.workspace.files.filter { f -> f.source.project != ProgramProject }.mapNotNull { f ->
      when (f.package) {
        ["fckt", p, *_] -> Some(p)
        else -> None
      }
    }.distinct().map { p ->
      unit = if (p == "lang") "Fckt_core" else "Fckt_std"
      ModuleItem(Naming.moduleName(p), ModulePath("$unit.Fckt.${Naming.moduleName(p)}"))
    }
}
