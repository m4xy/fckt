import fckt.collections.Maps.*
import fckt.effects.Fail
import fckt.checker.CheckedProgram
import fckt.checker.core.*
import fckt.checker.inference.*
import fckt.checker.symbols.*
import fckt.ocaml.*
import fckt.parser.Declaration
import fckt.parser.Definition

// A checked program, as OCaml: its own code, to be linked with the core and the standard library as
// fckt's compiler compiles them on their own, as fckt_core.ml and fckt_std.ml. What it can't lower
// yet, it fails saying.
module Programs {
  @Fail ocaml(program: CheckedProgram): List<Item> =
    Lowering(toStringOf = name -> program.toStrings.get(name), inside = ~[]) { items(program) }

  @Fail @Lowering private items(program: CheckedProgram): List<Item> = {
    bodies = program.functions.filter { f -> isOwn(f.function) }.mapNotNull { f -> f.body.map { b -> (f.function, b) } }
    groups = program.groups.mapNotNull { g ->
      functions = g.functions.mapNotNull { f -> bodies.find { s, _ -> s.name == f.name } }
      if (functions.isEmpty()) None else Some((g, functions))
    }
    own = OwnCode(groups, program.types.filter { t -> isOwn(Structures.declaredAt(t)) }, modulesOf(program))
    main = program.functions.find { f -> isOwn(f.function) && f.function.path.isEmpty() && Naming.ownName(f.function) == "main" }.map { f ->
      takesArguments = Signatures.parametersOf(f.function).map { it.isNotEmpty() }.getOrElse(false)
      LetItem(false, [Binding(ConstantPat(UnitConstant), [], None, HandledEffects.runningMain(f.function, takesArguments, program.defaultHandlers))])
    }
    [VerbatimItem(Helpers.items), aliases(program)] + Structures.items([], own) + main.toList()
  }

  // Whether the declaration is the program's own: in the file it was given, not one it uses.
  private isOwn(s: Symbol): Boolean = s.file.source.path.isNone()

  // The path of each module the program's own file declares, those in it among them.
  private modulesOf(program: CheckedProgram): List<List<String>> =
    program.workspace.files.filter { f -> f.source.path.isNone() }.flatMap { f -> modulesIn(f.declarations, []) }

  private modulesIn(declarations: List<Declaration>, path: List<String>): List<List<String>> = declarations.flatMap { d ->
    when (d.definition) {
      ModuleDefinition(inner, _, _, None, _) -> [path + [d.name]] + modulesIn(inner, path + [d.name])
      else -> []
    }
  }

  // The standard library's packages and the core, by the names the program's code writes them by:
  // Fckt.Io is Fckt_std.Fckt.Io, and Fckt.Lang Fckt_core.Fckt.Lang.
  private aliases(program: CheckedProgram): Item = {
    packages = program.workspace.files.mapNotNull { f ->
      when (f.package) {
        ["fckt", p, *_] -> Some(p)
        else -> None
      }
    }.distinct()
    ModuleItem("Fckt", Structure(packages.map { p ->
      unit = if (p == "lang") "Fckt_core" else "Fckt_std"
      ModuleItem(Naming.moduleName(p), ModulePath("$unit.Fckt.${Naming.moduleName(p)}"))
    }))
  }
}
