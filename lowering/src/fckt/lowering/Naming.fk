import fckt.checker.symbols.Symbol

// fckt's names as OCaml's, as fckt's own compiler makes them, so that what it writes and what this
// writes can be linked together.
module Naming {
  // OCaml's reserved words, with effect, which OCaml 5.3 made one for its effect handlers.
  private keywords: List<String> = [
    "and", "as", "assert", "asr", "begin", "class", "constraint", "do", "done", "downto", "effect", "else", "end",
    "exception", "external", "false", "for", "fun", "function", "functor", "if", "in", "include", "inherit",
    "initializer", "land", "lazy", "let", "lor", "lsl", "lsr", "lxor", "match", "method", "mod", "module",
    "mutable", "new", "nonrec", "object", "of", "open", "or", "private", "rec", "sig", "struct", "then", "to",
    "true", "try", "type", "val", "virtual", "when", "while", "with",
  ]

  // A value's name in OCaml: orderId is order_id, List$second list_second, HTTPCode http_code; an
  // OCaml keyword gets _ after it.
  snake(name: String): String = escaped(
    if (name.contains("$")) name.split("$").map { snake(it).removeSuffix("_") }.joinToString("_")
    else underscored(name.toList(), None, "")
  )

  private escaped(name: String): String = if (keywords.contains(name)) "${name}_" else name

  // An _ before each capital that starts a word: after a lower-case letter or a digit, or the last of
  // a run of capitals before a lower-case letter.
  private underscored(chars: List<Char>, previous: Option<Char>, done: String): String = when (chars) {
    [] -> done
    [c, *rest] -> {
      startsWord = c.isUpperCase() && when (previous) {
        Some(p) -> p.isLowerCase() || p.isDigit() || (p.isUpperCase() && rest.firstOrNone().map { it.isLowerCase() }.getOrElse(false))
        None -> false
      }
      underscored(rest, Some(c), done + (if (startsWord) "_" else "") + c.lowercase().toString())
    }
  }

  // A module's name in OCaml, which must be capitalised: a package's folder, geometry, is Geometry.
  moduleName(name: String): String = when (name.toList()) {
    [] -> name
    [first, *rest] -> first.uppercase().toString() + rest.map { it.toString() }.joinToString("")
  }

  // The declaration as written from the top of the program: its modules, then its own name, made
  // OCaml's by own: Fckt.Lang.Lists.list_sorted for fckt.lang.Lists.List$sorted.
  reference(s: Symbol, own: (String) -> String): String = (s.path.map { moduleName(it) } + [own(ownName(s))]).joinToString(".")

  // A function's or value's name, written from the top of the program.
  valueReference(s: Symbol): String = reference(s) { snake(it) }

  // The declaration's own name, without the modules it's in: List$sorted.
  ownName(s: Symbol): String = if (s.path.isEmpty()) s.name else s.name.drop(s.path.joinToString(".").length + 1)
}
