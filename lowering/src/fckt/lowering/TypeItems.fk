import fckt.effects.Fail
import fckt.checker.core.*
import fckt.checker.symbols.*
import fckt.checker.types.*
import fckt.ocaml.*

// The types a program declares, as OCaml's, all in one group so each can name the others; and,
// beside them, a function showing each as text, as toString does: Point(x=1, y=2), Circle(r=1.0).
module TypeItems {
  // The type definitions, if there are any.
  @Lowering definitions(types: List<TypeDeclaration>): List<Item> =
    if (types.isEmpty()) [] else [TypeItem(types.map { definition(it) })]

  // The show functions, if there are any: not for a type with its own toString, which shows it.
  @Fail @Lowering shows(types: List<TypeDeclaration>): List<Item> = {
    bindings = types.filter { t -> toStringOf(Declarations.declaredAt(t).name).isNone() }.mapNotNull { showBinding(it) }
    if (bindings.isEmpty()) [] else [LetItem(true, bindings)]
  }

  @Lowering private definition(d: TypeDeclaration): TypeDefinition = when (d) {
    DeclaredRecord(record, parameters, fields) ->
      TypeDefinition(OcamlTypes.ownName(record.name), OcamlTypes.ocamlParameters(parameters).map { OcamlTypes.parameter(it) }, RecordType(fields.map { field(it) }))
    DeclaredCases(caseType, parameters, cases) if isShared(caseType.name) ->
      TypeDefinition(OcamlTypes.ownName(caseType.name), OcamlTypes.ocamlParameters(parameters).map { OcamlTypes.parameter(it) },
        PolymorphicVariantType(cases.map { c -> Tag(Constructors.tagName(c.case), c.fields.map { OcamlTypes.typexpr(it.t) }) }))
    DeclaredCases(caseType, parameters, cases) ->
      TypeDefinition(OcamlTypes.ownName(caseType.name), OcamlTypes.ocamlParameters(parameters).map { OcamlTypes.parameter(it) }, VariantType(cases.map { c ->
        ConstructorDeclaration(c.case.definition.name, if (c.fields.isEmpty()) Bare else InlineRecord(c.fields.map { field(it) }))
      }))
    DeclaredAlias(alias, parameters, target) ->
      TypeDefinition(OcamlTypes.ownName(alias.name), OcamlTypes.ocamlParameters(parameters).map { OcamlTypes.parameter(it) }, AliasType(OcamlTypes.typexpr(target)))
    DeclaredExternal(external, parameters, ocaml) ->
      TypeDefinition(OcamlTypes.ownName(external.name), OcamlTypes.ocamlParameters(parameters).map { OcamlTypes.parameter(it) }, AliasType(TypeApplication("($ocaml)", [])))
  }

  @Lowering private field(f: DeclaredField): FieldDeclaration = FieldDeclaration(Naming.snake(f.name), OcamlTypes.typexpr(f.t), f.variable)

  // show_point show_a (v : 'a point): what the value is, as text, given how to show each of its type
  // parameters.
  @Fail @Lowering private showBinding(d: TypeDeclaration): Option<Binding> = when (d) {
    DeclaredRecord(record, parameters, fields) ->
      Some(showFunction(record.name, parameters, fieldsText(Naming.ownName(record), fields, Identifier("v"))))
    // Tags carry their fields as a tuple; each is bound to show it.
    DeclaredCases(caseType, parameters, cases) if isShared(caseType.name) ->
      Some(showFunction(caseType.name, parameters, Match(Identifier("v"), cases.map { c ->
        name = c.case.definition.name
        names = c.fields.mapIndexed { i, _ -> "x$i" }
        payload = when (names) {
          [] -> None
          [one] -> Some(VariablePat(one))
          _ -> Some(TuplePat(names.map { VariablePat(it) }))
        }
        shown = if (c.fields.isEmpty()) ConstantExpr(StringConstant(name)) else Shows.joined([ConstantExpr(StringConstant("$name("))] + c.fields.mapIndexed { i, f ->
          [ConstantExpr(StringConstant((if (i > 0) ", " else "") + f.name + "=")), Application(Shows.show(f.t), [Identifier("x$i")])]
        }.flatMap { it } + [ConstantExpr(StringConstant(")"))])
        Case(ConstructorPat(Constructors.tag(c.case), payload), None, shown)
      })))
    DeclaredCases(caseType, parameters, cases) ->
      Some(showFunction(caseType.name, parameters, Match(Identifier("v"), cases.map { c ->
        name = c.case.definition.name
        if (c.fields.isEmpty()) Case(ConstructorPat(name, None), None, ConstantExpr(StringConstant(name)))
        else Case(ConstructorPat(name, Some(VariablePat("r"))), None, fieldsText(name, c.fields, Identifier("r")))
      })))
    DeclaredAlias(alias, parameters, target) -> Some(showFunction(alias.name, parameters, Application(Shows.show(target), [Identifier("v")])))
    DeclaredExternal(external, parameters, _) ->
      Some(showFunction(external.name, parameters, ConstantExpr(StringConstant("<${Naming.ownName(external)}>"))))
  }

  private showFunction(full: String, parameters: List<String>, body: Expr): Binding = {
    own = OcamlTypes.ocamlParameters(parameters)
    t = TypeApplication(OcamlTypes.ownName(full), own.map { TypeVar(OcamlTypes.parameter(it)) })
    Binding(VariablePat(Shows.showName(full)), own.map { VariablePat("show_" + it.lowercase()) } + [TypedPat(VariablePat("v"), t)], None, body)
  }

  // Name(a=..., b=...), each field shown as its type is.
  @Fail @Lowering private fieldsText(label: String, fields: List<DeclaredField>, record: Expr): Expr =
    Shows.joined([ConstantExpr(StringConstant("$label("))] + fields.mapIndexed { i, f ->
      [ConstantExpr(StringConstant((if (i > 0) ", " else "") + f.name + "=")), Application(Shows.show(f.t), [FieldAccess(record, Naming.snake(f.name))])]
    }.flatMap { it } + [ConstantExpr(StringConstant(")"))])
}
