import fckt.checker.core.*
import fckt.checker.inference.FunctionGroup
import fckt.checker.symbols.Symbol

// The program's own code, to lower: its function groups, each after those it uses, with each
// function's code; the types it declares; and the path of each module it declares.
type OwnCode(groups: List<(FunctionGroup, List<(Symbol, CoreFunction)>)>, types: List<TypeDeclaration>, modules: List<List<String>>)
