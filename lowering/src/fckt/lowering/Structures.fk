import fckt.effects.Fail
import fckt.checker.core.*
import fckt.checker.inference.FunctionGroup
import fckt.checker.symbols.*
import fckt.checker.types.*
import fckt.ocaml.*

// The program's own code, a module at a time: at each path, what's declared there, its types, which
// OCaml defines together where they name each other, with their show functions, its handled effects,
// its function groups and the modules in it, each after what it uses, as OCaml must have them. fckt
// has no modules, packages or types that use each other, but for types in one module, so there's
// always such an order.
module Structures {
  @Fail @Lowering items(path: List<String>, own: OwnCode): List<Item> = {
    besides = own.besides.filter { p, _ -> p == path }.map { _, item -> item }
    besides + ordered(partsAt(path, own), own).flatMap { partItems(it, own) }
  }

  @Fail @Lowering private partItems(part: Part, own: OwnCode): List<Item> = when (part) {
    TypesPart(types) -> TypeItems.definitions(types) + TypeItems.shows(types)
    EffectPart(effect) -> HandledEffects.declarations(effect)
    SpecPart(spec) -> [Specs.moduleType(spec)]
    GroupPart(group) -> {
      bindings = own.groups.find { g, _ -> g == group }.map { _, functions -> functions.map { f, t, body -> binding(f, t, body) } }.getOrElse([])
      if (bindings.isEmpty()) [] else [LetItem(group.recursive, bindings)]
    }
    ModulePart(path) -> {
      name = path.lastOrNone().getOrElse("")
      inner = Lowering(
        toStringOf = typeName -> toStringOf(typeName),
        declarationOf = typeName -> declarationOf(typeName),
        isShared = typeName -> isShared(typeName),
        specOf = specName -> specOf(specName),
        effectOf = effectName -> effectOf(effectName),
        inside = ~path,
      ) {
        items(path, own)
      }
      [ModuleItem(Naming.moduleName(name), Structure(inner))]
    }
  }

  // A function, with its parameters, each annotated with its type, and its result's, or a value, as
  // let binds it.
  @Fail @Lowering private binding(function: Symbol, t: Type, body: CoreFunction): Binding = {
    name = VariablePat(Naming.snake(Naming.ownName(function)))
    value = Expressions.expression(body.body)
    when (t) {
      FunctionOf(parameterTypes, result, _) if Signatures.isFunction(function) -> {
        parameters = if (body.parameters.isEmpty()) [ConstantPat(UnitConstant)]
          else body.parameters.zip(
            parameterTypes,
          ).map { p, pt -> TypedPat(VariablePat(Naming.snake(p)), OcamlTypes.typexpr(pt)) }
        Binding(name, parameters, Some(OcamlTypes.typexpr(result)), value)
      }
      _ -> Binding(name, [], None, value)
    }
  }

  // ---- What's at a path ----

  // The types at the path, those that name each other together, in the order they're declared; its
  // effects; the modules in it with no functions; then its groups, and the other modules in it, each
  // where its first function's group is.
  private partsAt(path: List<String>, own: OwnCode): List<Part> = {
    // An external type is its OCaml wherever it's written, so it isn't declared.
    types = own.types.filter { t -> Declarations.declaredAt(t).path == path && t !is DeclaredExternal }
    effects = own.effects.filter { it.effect.path == path }.map { EffectPart(it) }
    specs = own.specs.filter { it.spec.path == path }.map { SpecPart(it) }
    fromGroups = own.groups.mapNotNull { g, _ ->
      groupPath = g.functions.firstOrNone().map { it.path }.getOrElse([])
      if (groupPath == path) Some(GroupPart(g))
      else if (groupPath.size > path.size && groupPath.take(path.size) == path) Some(
        ModulePart(groupPath.take(path.size + 1)),
      )
      else None
    }.distinct()
    others = own.modules.filter { m -> m.size == path.size + 1 && m.take(path.size) == path }.map { ModulePart(it) }
    // A module with no functions uses none of them, so it can go before them all, as the standard
    // library's aliases must, which code made in lowering may use.
    typeGroups(
      types,
    ).map { TypesPart(it) } + specs + effects + others.filter { !fromGroups.contains(it) } + fromGroups
  }

  // The types, each with those it names that name it back, in the order they're declared.
  private typeGroups(types: List<TypeDeclaration>): List<List<TypeDeclaration>> = {
    names = types.map { Declarations.declaredAt(it).name }
    // The types each names directly, by their places.
    named = types.map { t -> declaredTypeNames(t).map { n -> names.indexOf(n) }.filter { it >= 0 } }
    reaching = (0..<types.size).map { i -> reachable([i], [], named) }
    reaches = (from: Int, to: Int) -> reaching.getOrNone(
      from,
    ).map { it.contains(to) }.getOrElse(false)
    (groups, _) = (0..<types.size).fold(([], [])) { acc, i ->
      (found, placed) = acc
      if (placed.contains(i)) acc
      else {
        group = (0..<types.size).filter { j -> j == i || (reaches(i, j) && reaches(j, i)) }
        (found + [group], placed + group)
      }
    }
    groups.map { group -> group.mapNotNull { types.getOrNone(it) } }
  }

  // Every index reachable from those to visit, through what each names.
  private reachable(
    toVisit: List<Int>,
    seen: List<Int>,
    named: List<List<Int>>,
  ): List<Int> = when (toVisit) {
    [] -> seen
    [i, *rest] -> if (seen.contains(i)) reachable(rest, seen, named) else reachable(
      rest + named.getOrNone(i).getOrElse([]),
      seen + [i],
      named,
    )
  }

  // ---- Ordering ----

  // The parts, each after those it uses, otherwise in the order they're given.
  private ordered(parts: List<Part>, own: OwnCode): List<Part> =
    placing(parts.map { p -> Using(p, referencesOf(p, own), typeNamesOf(p, own).distinct()) }, [])

  // A part, with the declarations it uses, and the full names of the types it names.
  private type Using(part: Part, references: List<Symbol>, typeNames: List<String>)

  private placing(left: List<Using>, placed: List<Part>): List<Part> = when (left) {
    [] -> placed
    [first, *_] -> {
      ready = left.find { u -> left.none { other -> other.part != u.part && uses(u, other.part) } }.getOrElse(first)
      placing(left.filter { it.part != ready.part }, placed + [ready.part])
    }
  }

  // Whether the part uses the other: a function, an effect or a type in it.
  private uses(u: Using, other: Part): Boolean =
    u.references.any { s -> isIn(s, other) } || u.typeNames.any { name -> typeIsIn(name, other) }

  private isIn(s: Symbol, part: Part): Boolean = when (part) {
    TypesPart(types) -> types.any { Declarations.declaredAt(it).name == s.name }
    EffectPart(effect) -> effect.effect.name == s.name
    SpecPart(spec) -> spec.spec.name == s.name
    GroupPart(group) -> group.functions.any { it.name == s.name }
    // What's in the module, or the module itself, as a handler or a value.
    ModulePart(path) -> within(s.path, path) || within(s.name.split("."), path)
  }

  private typeIsIn(name: String, part: Part): Boolean = when (part) {
    TypesPart(types) -> types.any { Declarations.declaredAt(it).name == name }
    SpecPart(spec) -> spec.spec.name == name
    ModulePart(path) -> within(name.split(".").dropLast(1), path)
    else -> false
  }

  // The declarations the part's code uses.
  private referencesOf(
    part: Part,
    own: OwnCode,
  ): List<Symbol> = functionsOf(part, own).flatMap { _, _, body -> Cores.references(body.body) }

  // The types the part names: its functions' types, its types' fields', and its effects' operations'.
  private typeNamesOf(part: Part, own: OwnCode): List<String> =
    functionsOf(part, own).flatMap { _, t, _ -> typeNames(t) } + when (part) {
      TypesPart(types) -> types.flatMap { declaredTypeNames(it) }
      EffectPart(effect) -> effectTypeNames(effect)
      SpecPart(spec) -> spec.values.flatMap { _, t -> typeNames(t) }
      GroupPart(_) -> []
      ModulePart(path) -> own.types.filter { t -> within(Declarations.declaredAt(t).path, path) }.flatMap { declaredTypeNames(it) } +
        own.effects.filter { e -> within(e.effect.path, path) }.flatMap { effectTypeNames(it) }
    }

  // The functions in the part, with their types and code.
  private functionsOf(
    part: Part,
    own: OwnCode,
  ): List<(Symbol, Type, CoreFunction)> = own.groups.filter { g, _ ->
    when (part) {
      GroupPart(group) -> g == group
      ModulePart(path) -> g.functions.any { f -> within(f.path, path) }
      else -> false
    }
  }.flatMap { _, functions -> functions }

  private within(
    inner: List<String>,
    outer: List<String>,
  ): Boolean = inner.size >= outer.size && inner.take(outer.size) == outer

  // The full names of the declared types a type names.
  private typeNames(t: Type): List<String> = when (t) {
    Named(name, arguments, _) -> [name] + arguments.flatMap { typeNames(it) }
    Abstract(name, arguments) -> [name] + arguments.flatMap { typeNames(it) }
    TupleOf(parts) -> parts.flatMap { typeNames(it) }
    FunctionOf(parameters, result, _) -> parameters.flatMap { typeNames(it) } + typeNames(result)
    // A module as a value of a spec names the spec.
    ModuleValue(spec, arguments, _) -> [spec] + arguments.flatMap { typeNames(it) }
    _ -> []
  }

  private declaredTypeNames(t: TypeDeclaration): List<String> = when (t) {
    DeclaredRecord(_, _, fields) -> fields.flatMap { typeNames(it.t) }
    DeclaredCases(_, _, cases) -> cases.flatMap { c -> [c.case.owner.name] + c.fields.flatMap { typeNames(it.t) } }
    DeclaredAlias(_, _, target) -> typeNames(target)
    DeclaredExternal(_, _, _) -> []
  }

  private effectTypeNames(e: DeclaredEffect): List<String> =
    e.operations.flatMap { op -> op.parameters.getOrElse([]).flatMap { typeNames(it) } + typeNames(op.result) }
}
