// Result as a monad, for any type of error, E: Results { x by parse(s); y by check(x); y } stops at
// the first Error.
module Results<E> : Monad {
  type M<A> = Result<A, E>

  pure<A>(x: A): Result<A, E> = Ok(x)

  bind<A, B>(m: Result<A, E>, f: (A) -> Result<B, E>): Result<B, E> = when (m) {
    Ok(x) -> f(x)
    Error(e) -> Error(e)
  }

  mapError<A, F>(m: Result<A, E>, f: (E) -> F): Result<A, F> = when (m) {
    Ok(x) -> Ok(x)
    Error(e) -> Error(f(e))
  }

  toOption<A>(m: Result<A, E>): Option<A> = when (m) {
    Ok(x) -> Some(x)
    Error(_) -> None
  }
}
