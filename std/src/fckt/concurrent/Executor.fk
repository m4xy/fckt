import fckt.effects.Fail

// What runs tasks: a handler of Concurrent, which decides which task goes on when one gives way.
// What waits for tasks takes one, so it runs them as whichever it's given does: InTurn, one at a
// time in the order they're ready, or one of a program's own, as a test's that says the order.
spec Executor {
  // What block gives, once it and every task it launched, and they launched, have ended. When no
  // task is ready, but some are parked, idle waits for something to wake them, and says the wakers
  // of what came; where it can wait for nothing, none would ever go on, which fails.
  @Fail runWith<A, @E>(idle: @E () -> List<Waker>, block: @Concurrent<@E> @E () -> A): A

  // The same, its tasks waking only each other.
  @Fail run<A, @E>(block: @Concurrent<@E> @E () -> A): A = runWith(() -> [], block)
}
