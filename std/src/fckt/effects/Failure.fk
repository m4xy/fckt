// Failing, and catching it.
module Failure {
  // Ok with what block gives, or Error with why it failed.
  attempt<A>(
    block: @Fail () -> A,
  ): Result<A, String> = Fail(fail = (reason, _) -> Error(reason)) { Ok(block()) }

  // How main handles @Fail: stops the program, with the reason on standard error.
  module Crash : Fail {
    private external stop(reason: String): Nothing = "(fun r -> prerr_endline r; exit 1) reason"
    fail(reason: String): Nothing = stop(reason)
  }
}
