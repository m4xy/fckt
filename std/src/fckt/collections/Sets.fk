import fckt.collections.Maps.*

// Kotlin's sets: items, each once. Imported into every file. A set never changes: plus and minus
// make another. Its items are in order, smallest first, as a map's keys are, and two sets with the
// same items are equal.
module Sets {
  // The items as a map's keys.
  opaque type Set<A>(items: Map<A, Unit>)

  // A set with nothing in it; with the list's items.
  emptySet<A>(): Set<A> = Set(emptyMap())
  setOf<A>(items: List<A>): Set<A> = Set(items.map { (it, Unit) }.toMap())
  List<A>.toSet(): Set<A> = setOf(this)

  Set<A>.size: Int = this.items.size
  Set<A>.isEmpty(): Boolean = this.items.isEmpty()
  Set<A>.isNotEmpty(): Boolean = this.items.isNotEmpty()
  Set<A>.contains(item: A): Boolean = this.items.containsKey(item)

  // It with item, or without it.
  operator Set<A>.plus(item: A): Set<A> = Set(this.items.put(item, Unit))
  operator Set<A>.minus(item: A): Set<A> = Set(this.items.remove(item))
  // The items in either, in both, or in it but not other: through the trees, not an item at a time.
  Set<A>.union(other: Set<A>): Set<A> = Set(this.items.putAll(other.items))
  Set<A>.intersect(other: Set<A>): Set<A> = Set(this.items.intersectKeys(other.items))
  Set<A>.subtract(other: Set<A>): Set<A> = Set(this.items.subtractKeys(other.items))

  // Its items, in order.
  Set<A>.toList(): List<A> = this.items.keys
  Set<A>.forEach(f: (A) -> Unit): Unit = this.items.forEach { a, _ -> f(a) }
  Set<A>.any(f: (A) -> Boolean): Boolean = this.items.any { a, _ -> f(a) }
  Set<A>.all(f: (A) -> Boolean): Boolean = this.items.all { a, _ -> f(a) }
  Set<A>.count(f: (A) -> Boolean): Int = this.items.count { a, _ -> f(a) }
  Set<A>.filter(f: (A) -> Boolean): Set<A> = Set(this.items.filterKeys(f))
  // What f makes of each item, in order: a list, as Kotlin's is, as two items may make the same.
  Set<A>.map<B>(f: (A) -> B): List<B> = this.toList().map(f)

  // As Kotlin shows a set: [a, b].
  Set<A>.toString(showA: (A) -> String): String = "[" + this.toList().map(showA).joinToString(", ") + "]"
}
