import fckt.text.Bytes
import fckt.text.Encodings.*
import fckt.effects.Fail
import fckt.effects.Failure.attempt

// Reading and writing a little at a time, through @Reader and @Writer: files, and what other
// programs print.
module Channels {
  // Writes text and a line's end.
  @Writer writeLine(text: String): Unit = write("$text\n")

  // Each line that's left, in order.
  @Reader forEachLine(f: (String) -> Unit): Unit = when (nextLine()) {
    Some(line) -> {
      f(line)
      forEachLine(f)
    }
    None -> Unit
  }

  // What's left, as text: see Encodings' decodeToString.
  @Reader remainingText(): String = nextBytes(-1).decodeToString()

  // The lines that are left.
  @Reader remainingLines(): List<String> = when (nextLine()) {
    Some(line) -> [line, *remainingLines()]
    None -> []
  }

  // The program's standard input, output and error. Reading what's piped in to its end:
  // readingFrom(standardInput) { forEachLine { line -> ... } }.
  external standardInput: InputHandle = "stdin"
  external standardOutput: OutputHandle = "stdout"
  external standardError: OutputHandle = "stderr"

  // Writes a line to the program's standard error, where it tells what went wrong, apart from what it
  // prints.
  @Channel printError(text: String): Unit = writeTo(standardError, "$text\n".encodeToBytes())

  // Runs body reading input, and leaves it open.
  @Channel readingFrom<A>(input: InputHandle, body: @Reader () -> A): A =
    Reader(nextLine = ~readLineFrom(input), nextBytes = count -> readFrom(input, count)) { body() }

  // Runs body reading input, and closes it after, even if body fails.
  @Channel @Fail readingAll<A>(input: InputHandle, body: @Reader () -> A): A = {
    result = attempt { readingFrom(input, body) }
    closeInput(input)
    when (result) {
      Ok(value) -> value
      Error(reason) -> fail(reason)
    }
  }

  // Runs body writing to output, and closes it after, even if body fails.
  @Channel @Fail writingAll<A>(output: OutputHandle, body: @Writer () -> A): A = {
    result = attempt { Writer(write = text -> writeTo(output, text.encodeToBytes()), writeBytes = bytes -> writeTo(output, bytes)) { body() } }
    closeOutput(output)
    when (result) {
      Ok(value) -> value
      Error(reason) -> fail(reason)
    }
  }

  // The files and standard streams the program itself has open, which main uses.
  module Local : Channel {
    private external inputLine(input: InputHandle): Option<String> = "In_channel.input_line input"
    private external inputBytes(input: InputHandle, count: Int): Bytes =
      "(fun c n -> if n < 0 then In_channel.input_all c else match In_channel.really_input_string c n with Some s -> s | None -> In_channel.input_all c) input count"
    private external outputBytes(output: OutputHandle, bytes: Bytes): Unit = "Out_channel.output_string output bytes"
    private external closeIn(input: InputHandle): Unit = "In_channel.close input"
    private external closeOut(output: OutputHandle): Unit = "Out_channel.close output"
    readLineFrom(input: InputHandle): Option<String> = inputLine(input)
    readFrom(input: InputHandle, count: Int): Bytes = inputBytes(input, count)
    writeTo(output: OutputHandle, bytes: Bytes): Unit = outputBytes(output, bytes)
    closeInput(input: InputHandle): Unit = closeIn(input)
    closeOutput(output: OutputHandle): Unit = closeOut(output)
  }
}
