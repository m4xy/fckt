import fckt.concurrent.*
import fckt.effects.Fail
import fckt.time.*
import fckt.time.Times.*

// Tasks that wait for the system: Polls.running runs a block's tasks, and while none is ready,
// waits, with select, for what they wait for, whichever comes first: a descriptor to be ready to
// read or write, or a time to pass. A task waits with awaitReadable, awaitWritable or sleep, so the
// others go on meanwhile.
module Polls {
  // What a task waits for.
  private type Wait {
    Readable(descriptor: Descriptor),
    Writable(descriptor: Descriptor),
    Past(time: Instant),
  }

  // What block gives, once it and the tasks it launched have ended, each waiting as Polling says,
  // and run as executor runs them.
  @Fail @Clock running<A, @E>(
    executor: Executor = InTurn,
    block: @Concurrent<@Polling @Clock @E> @Polling @Clock @E () -> A,
  ): A = {
    var waiting: List<(Wait, Waker)> = []
    Polling(
      whenReadable = (d, waker) -> { waiting = waiting + [(Readable(d), waker)] },
      whenWritable = (d, waker) -> { waiting = waiting + [(Writable(d), waker)] },
      whenPast = (time, waker) -> { waiting = waiting + [(Past(time), waker)] },
      waitForAny = () -> {
        came = ready(waiting)
        // A waker that's come wakes its task once: what else it waited for, it no longer does.
        wokenIds = came.map { it.id }
        waiting = waiting.filter { _, waker -> !wokenIds.contains(waker.id) }
        came
      },
    ) {
      executor.run(idle = () -> waitForAny(), block = block)
    }
  }

  // The wakers of what's come, once something has: none, if nothing's awaited.
  @Clock private ready(waiting: List<(Wait, Waker)>): List<Waker> = if (waiting.isEmpty()) [] else {
    reads = waiting.flatMap { wait, _ -> when (wait) { Readable(d) -> [d]; else -> [] } }
    writes = waiting.flatMap { wait, _ -> when (wait) { Writable(d) -> [d]; else -> [] } }
    times = waiting.flatMap { wait, _ -> when (wait) { Past(t) -> [t.millis]; else -> [] } }
    // Until the soonest time, or, with none, as long as it takes.
    timeout = when (times.minOrNone()) {
      Some(soonest) -> max(soonest - now().millis, 0).toFloat() / 1000.0
      None -> -1.0
    }
    (readable, writable) = select(reads, writes, timeout)
    after = now().millis
    waiting.flatMap { wait, waker ->
      came = when (wait) {
        Readable(d) -> readable.contains(d)
        Writable(d) -> writable.contains(d)
        Past(t) -> t.millis <= after
      }
      if (came) [waker] else []
    }.distinct()
  }

  // Which of reads and writes are ready, waiting at most timeout seconds for one to be, or for ever
  // if it's below 0; a signal ending the wait early is nothing ready.
  private external select(
    reads: List<Descriptor>,
    writes: List<Descriptor>,
    timeout: Float,
  ): (List<Descriptor>, List<Descriptor>) =
    "(fun rs ws t -> try let (r, w, _) = Unix.select rs ws [] t in (r, w) with Unix.Unix_error (Unix.EINTR, _, _) -> ([], [])) reads writes timeout"

  // Waits until the descriptor has something to read, or has ended, while other tasks go on.
  @Concurrent<@Polling @E> @Polling awaitReadable<@E>(
    descriptor: Descriptor,
  ): Unit = park { whenReadable(descriptor, it) }

  // Waits until the descriptor can take something written, while other tasks go on.
  @Concurrent<@Polling @E> @Polling awaitWritable<@E>(
    descriptor: Descriptor,
  ): Unit = park { whenWritable(descriptor, it) }

  // Waits until the descriptor has something to read, or has ended, for at most duration, while
  // other tasks go on: whether it has, rather than the time running out.
  @Concurrent<@Polling @Clock @E> @Polling @Clock awaitReadableFor<@E>(
    descriptor: Descriptor,
    duration: Duration,
  ): Boolean =
    awaitFor(duration) { whenReadable(descriptor, it) }

  // Waits until the descriptor can take something written, for at most duration, while other
  // tasks go on: whether it can, rather than the time running out.
  @Concurrent<@Polling @Clock @E> @Polling @Clock awaitWritableFor<@E>(
    descriptor: Descriptor,
    duration: Duration,
  ): Boolean =
    awaitFor(duration) { whenWritable(descriptor, it) }

  // Waits for what register says, or for duration to pass, whichever comes first: whether it was
  // what register says.
  @Concurrent<@Polling @Clock @E> @Polling @Clock private awaitFor<@E>(
    duration: Duration,
    register: @Polling (Waker) -> Unit,
  ): Boolean = {
    until = now() + duration
    park {
      register(it)
      whenPast(until, it)
    }
    now().millis < until.millis
  }

  // Waits for duration, while other tasks go on.
  @Concurrent<@Polling @E> @Polling @Clock sleep<@E>(duration: Duration): Unit = {
    until = now() + duration
    park { whenPast(until, it) }
  }
}
