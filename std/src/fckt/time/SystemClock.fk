// The time the system says, which main handles @Clock with. It's the wall clock, which can jump
// when the system's is set: fine for how long a test took, not for timing to the millisecond.
module SystemClock : Clock {
  private external currentMillis(u: Unit): Int = "(fun _ -> int_of_float (Unix.gettimeofday () *. 1000.)) u"
  now(): Instant = Instant(currentMillis(Unit))
}
