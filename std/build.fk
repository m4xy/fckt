// fckt:std, the standard library: a library of its own, beside the compiler, whose core it builds
// on. fckt's distribution has its source, which kiln compiles once and gives every project; this
// build checks it on its own.
import uk.m4xy.kiln.fckt.*

project = Project(name = "std", group = "fckt", version = "0.1.0")

// It's the standard library, so it doesn't have itself.
module WithoutStd : FcktConfiguration {
  layout(): FcktLayout = FcktLayout(standardLibrary = false)
}

plugins = [Fckt(WithoutStd)]
