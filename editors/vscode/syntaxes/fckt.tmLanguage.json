{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "fckt",
  "scopeName": "source.fckt",
  "fileTypes": [
    "fk"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#import"
        },
        {
          "include": "#raw-strings"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#annotations"
        },
        {
          "include": "#effect-declaration"
        },
        {
          "include": "#spec-declaration"
        },
        {
          "include": "#module-declaration"
        },
        {
          "include": "#cased-type-declaration"
        },
        {
          "include": "#type-declaration"
        },
        {
          "include": "#function-declaration"
        },
        {
          "include": "#destructuring"
        },
        {
          "include": "#monadic-binding"
        },
        {
          "include": "#binding"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#type-arguments"
        },
        {
          "include": "#builtin-types"
        },
        {
          "include": "#option"
        },
        {
          "include": "#types"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#lambda-parameter-list"
        },
        {
          "include": "#lambda-parameter"
        },
        {
          "include": "#parameter-name"
        },
        {
          "include": "#named-argument"
        },
        {
          "include": "#builtin-functions"
        },
        {
          "include": "#method-call"
        },
        {
          "include": "#property"
        },
        {
          "include": "#call"
        },
        {
          "include": "#wildcard"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#braces"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "annotations": {
      "name": "storage.type.annotation.fckt",
      "match": "@[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fckt",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fckt",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "raw-strings": {
      "name": "string.quoted.triple.fckt",
      "begin": "\"\"\"",
      "end": "\"\"\"(?!\")",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.fckt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.fckt"
        }
      },
      "patterns": [
        {
          "include": "#templates"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.fckt",
      "match": "'(?:[^'\\\\]|\\\\[ntr\\\\\\\"'$]|\\\\u[0-9a-fA-F]{4}|\\\\u\\{[0-9a-fA-F]+\\})'"
    },
    "strings": {
      "name": "string.quoted.double.fckt",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.fckt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.fckt"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.fckt",
          "match": "\\\\[ntr\\\\\"$]|\\\\u[0-9a-fA-F]{4}|\\\\u\\{[0-9a-fA-F]+\\}"
        },
        {
          "name": "invalid.illegal.escape.fckt",
          "match": "\\\\."
        },
        {
          "include": "#templates"
        }
      ]
    },
    "templates": {
      "patterns": [
        {
          "name": "meta.template.expression.fckt",
          "contentName": "meta.embedded.line.fckt",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.fckt"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.fckt"
            }
          },
          "patterns": [
            {
              "include": "#code"
            }
          ]
        },
        {
          "name": "meta.template.expression.fckt",
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.template-expression.begin.fckt"
            },
            "2": {
              "name": "variable.other.fckt"
            }
          }
        }
      ]
    },
    "import": {
      "match": "^\\s*(import)\\s+([A-Za-z_][A-Za-z0-9_.]*?)(\\.\\*)?(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*$",
      "captures": {
        "1": {
          "name": "keyword.other.import.fckt"
        },
        "2": {
          "name": "entity.name.namespace.fckt"
        },
        "3": {
          "name": "keyword.operator.wildcard.fckt"
        },
        "4": {
          "name": "keyword.other.import.fckt"
        },
        "5": {
          "name": "entity.name.type.fckt"
        }
      }
    },
    "effect-declaration": {
      "patterns": [
        {
          "begin": "\\b(effect)\\s+([A-Z][A-Za-z0-9_]*)\\s*(?:<[^<>]*>)?\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.fckt"
            },
            "2": {
              "name": "storage.type.annotation.fckt"
            },
            "3": {
              "name": "punctuation.section.braces.fckt"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.braces.fckt"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "match": "^\\s*([a-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^<>]*>)?\\s*[(:])",
              "captures": {
                "1": {
                  "name": "entity.name.function.fckt"
                }
              }
            },
            {
              "include": "#code"
            }
          ]
        },
        {
          "match": "\\b(effect)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.fckt"
            },
            "2": {
              "name": "storage.type.annotation.fckt"
            }
          }
        }
      ]
    },
    "spec-declaration": {
      "begin": "\\b(spec)\\s+([A-Z][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.fckt"
        },
        "2": {
          "name": "entity.name.type.interface.fckt string.other.interface.fckt"
        },
        "3": {
          "name": "punctuation.section.braces.fckt"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.fckt"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#type-declaration"
        },
        {
          "match": "^\\s*([a-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^<>]*>)?\\s*[(:])",
          "captures": {
            "1": {
              "name": "entity.name.function.fckt"
            }
          }
        },
        {
          "include": "#code"
        }
      ]
    },
    "module-declaration": {
      "begin": "\\b(module)\\s+([A-Z][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.fckt"
        },
        "2": {
          "name": "entity.name.type.fckt"
        }
      },
      "end": "(?=\\{)|$",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(:)\\s*([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.fckt"
            },
            "2": {
              "name": "punctuation.separator.colon.fckt"
            },
            "3": {
              "name": "entity.name.type.interface.fckt string.other.interface.fckt"
            }
          }
        },
        {
          "match": "(:)\\s*([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.colon.fckt"
            },
            "2": {
              "name": "entity.name.type.interface.fckt string.other.interface.fckt"
            }
          }
        },
        {
          "include": "#code"
        }
      ]
    },
    "cased-type-declaration": {
      "begin": "\\b(type)\\s+([A-Z][A-Za-z0-9_]*)(?=\\s*(?:<[^{}()]*>)?\\s*\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.fckt"
        },
        "2": {
          "name": "entity.name.type.fckt"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#type-arguments"
        },
        {
          "include": "#punctuation"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "begin": "\\(",
              "end": "\\)",
              "patterns": [
                {
                  "include": "#code"
                }
              ]
            },
            {
              "match": "(\\*)\\s*([A-Z][A-Za-z0-9_]*)",
              "captures": {
                "1": {
                  "name": "keyword.operator.spread.fckt"
                },
                "2": {
                  "name": "entity.name.type.fckt"
                }
              }
            },
            {
              "include": "#type-arguments"
            },
            {
              "match": "\\b([A-Z][A-Za-z0-9_]*)(\\.)([A-Z][A-Za-z0-9_]*)\\b",
              "captures": {
                "1": {
                  "name": "entity.name.type.fckt"
                },
                "2": {
                  "name": "punctuation.accessor.fckt"
                },
                "3": {
                  "name": "entity.name.type.variant.fckt"
                }
              }
            },
            {
              "name": "entity.name.type.variant.fckt",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "type-declaration": {
      "match": "\\b(type)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.fckt"
        },
        "2": {
          "name": "entity.name.type.fckt"
        }
      }
    },
    "function-declaration": {
      "match": "^\\s*(?:(private)\\s+)?([a-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^<>]*>)?\\s*\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\)\\s*(?::[^=]*)?=(?![=>]))",
      "captures": {
        "1": {
          "name": "storage.modifier.fckt"
        },
        "2": {
          "name": "entity.name.function.fckt"
        }
      }
    },
    "destructuring": {
      "begin": "^\\s*\\((?=[^()]*\\)\\s*=(?![=>]))",
      "end": "\\)",
      "patterns": [
        {
          "include": "#wildcard"
        },
        {
          "name": "variable.other.definition.fckt",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "monadic-binding": {
      "patterns": [
        {
          "match": "^\\s*([a-z_][A-Za-z0-9_]*)\\s+(by)\b",
          "captures": {
            "1": {
              "name": "variable.other.definition.fckt"
            },
            "2": {
              "name": "keyword.other.by.fckt"
            }
          }
        },
        {
          "match": "(?<=\\))\\s+(by)\b",
          "captures": {
            "1": {
              "name": "keyword.other.by.fckt"
            }
          }
        }
      ]
    },
    "binding": {
      "match": "^\\s*(?:(private)\\s+)?([a-z_][A-Za-z0-9_]*)(?=\\s*(?::[^=]*)?=(?![=>]))",
      "captures": {
        "1": {
          "name": "storage.modifier.fckt"
        },
        "2": {
          "name": "variable.other.definition.fckt"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fckt",
          "match": "\\b(when|if|else|is)\\b"
        },
        {
          "name": "keyword.declaration.fckt",
          "match": "\\b(type|module)\\b"
        },
        {
          "name": "storage.modifier.fckt",
          "match": "^\\s*(?:private\\s+)?external\\b"
        },
        {
          "name": "variable.language.this.fckt",
          "match": "\\bthis\\b"
        },
        {
          "match": "(?<=[A-Za-z0-9_)])\\s+(by)(?=\\s)",
          "captures": {
            "1": {
              "name": "keyword.other.by.fckt"
            }
          }
        },
        {
          "name": "storage.modifier.fckt",
          "match": "\\bprivate\\b"
        },
        {
          "name": "storage.modifier.fckt",
          "match": "\\bopaque(?=\\s+type\\b)"
        },
        {
          "name": "storage.modifier.fckt",
          "match": "^\\s*internal(?=\\s+[A-Za-z@])"
        },
        {
          "name": "storage.modifier.fckt",
          "match": "\\bannotation(?=\\s+type\\b)"
        }
      ]
    },
    "constants": {
      "name": "constant.language.boolean.fckt",
      "match": "\\b(true|false)\\b"
    },
    "builtin-types": {
      "name": "entity.name.type.builtin.fckt",
      "match": "\\b(Int|Float|Double|String|Boolean|Unit|Char|Byte|Nothing|List|Option|Result|Lazy)\\b"
    },
    "option": {
      "name": "entity.name.type.variant.fckt",
      "match": "\\b(Some|None)\\b"
    },
    "types": {
      "name": "entity.name.type.fckt",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "type-arguments": {
      "begin": "<(?=[A-Z][A-Za-z0-9_\\s,.:<>]*>)",
      "end": ">",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.begin.fckt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.end.fckt"
        }
      },
      "patterns": [
        {
          "include": "#type-arguments"
        },
        {
          "include": "#builtin-types"
        },
        {
          "include": "#types"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.fckt",
          "match": "\\b\\d[\\d_]*(?:\\.\\d+(?:[eE][+-]?\\d+)?|[eE][+-]?\\d+)\\b"
        },
        {
          "name": "constant.numeric.integer.fckt",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "lambda-parameter-list": {
      "begin": "\\((?=[^()]*\\)\\s*->)",
      "end": "\\)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#builtin-types"
        },
        {
          "include": "#option"
        },
        {
          "include": "#types"
        },
        {
          "include": "#wildcard"
        },
        {
          "name": "variable.parameter.fckt",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "lambda-parameter": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=->)",
      "captures": {
        "1": {
          "name": "variable.parameter.fckt"
        }
      }
    },
    "parameter-name": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=:)",
      "captures": {
        "1": {
          "name": "variable.parameter.fckt"
        }
      }
    },
    "named-argument": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?==(?![=>]))",
      "captures": {
        "1": {
          "name": "variable.parameter.named-argument.fckt"
        }
      }
    },
    "builtin-functions": {
      "match": "\\b(print|println|max|min|abs|identity|error)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.fckt"
        }
      }
    },
    "method-call": {
      "match": "(\\.)\\s*([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "punctuation.accessor.fckt"
        },
        "2": {
          "name": "entity.name.function.member.fckt"
        }
      }
    },
    "property": {
      "match": "(\\.)\\s*([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.fckt"
        },
        "2": {
          "name": "variable.other.property.fckt"
        }
      }
    },
    "call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.fckt"
        }
      }
    },
    "wildcard": {
      "name": "variable.language.wildcard.fckt",
      "match": "\\b_\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.fckt",
          "match": "->"
        },
        {
          "match": "(?<=[\\[,])\\s*(\\*)",
          "captures": {
            "1": {
              "name": "keyword.operator.spread.fckt"
            }
          }
        },
        {
          "name": "keyword.operator.pipe.fckt",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.thunk.fckt",
          "match": "~"
        },
        {
          "name": "keyword.operator.comparison.fckt",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.fckt",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.fckt",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.fckt",
          "match": "[+\\-*/%]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.fckt",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.fckt",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.statement.fckt",
          "match": ";"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.fckt",
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
    }
  }
}
