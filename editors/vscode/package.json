{
  "name": "fckt",
  "displayName": "fckt",
  "description": "fckt for VS Code: highlighting, and fckt's language server, which says what's wrong as you type and formats code",
  "version": "0.1.0",
  "publisher": "m4xy",
  "repository": {
    "type": "git",
    "url": "https://github.com/m4xy/fckt"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fckt",
        "aliases": [
          "fckt"
        ],
        "extensions": [
          ".fk",
          ".fki"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fckt",
        "scopeName": "source.fckt",
        "path": "./syntaxes/fckt.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "fckt",
      "properties": {
        "fckt.path": {
          "type": "string",
          "default": "fckt",
          "description": "The fckt to run as the language server: fckt --language-server."
        }
      }
    }
  },
  "scripts": {
    "tokens": "node scripts/tokenize.js",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:fckt"
  ],
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
