import fckt.collections.Maps.*
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.FileSystem
import fckt.io.Path
import fckt.checker.*
import fckt.checker.diagnostics.*
import fckt.checker.sources.*
import fckt.checker.resolution.*
import fckt.parser.Position

// Writes to the first argument what fckt.checker makes of each type's name written in what each
// other argument says to check, as fckt's own checker is given it:
//
//   case <file>                  the file, as a program of its own, as a conformance case is
//   package <root> <own|other> <p> <uses>
//                                "import p.*", with the folder root as the program's own or
//                                another project's, for each of p's files; uses is the folders,
//                                separated by commas, of the other projects it uses, or -
//
// Each is checked with the core and the standard library beside it. For each file, "# file", then
// a line for each name that means a declared type or a spec, "line:column Name full.name", in
// order; then, after the last, a line for each error, "error file line:column message".
main(args: List<String>) = when (args) {
  [] -> Unit
  [out, *commands] -> path(out).writeText(written(commands, core() + standard()))
}

@FileSystem written(commands: List<String>, beside: List<(List<String>, List<SourceText>)>): String = when (commands) {
  ["case", file, *rest] -> {
    (files, errors) = Checker.typeNames(SourceText(None, ProgramProject, path(file).readText()), SourceTree(merged(beside)))
    own = files.filter { f -> f.file.source.path == None }
    "# $file\n" + own.map { f -> lines(f.types) }.joinToString("") + problems(errors) + written(rest, beside)
  }
  ["package", root, kind, pkg, uses, *rest] -> {
    project = if (kind == "own") ProgramProject else OtherProject(path(root).canonical().value)
    used = uses.split(",").filter { it != "-" }.flatMap { u -> packagesIn(path(u), [], OtherProject(path(u).canonical().value), "$u/") }
    // The standard library is beside every program already.
    tree = SourceTree(merged((if (root == "std/src") beside else beside + packagesIn(path(root), [], project, "$root/")) + used))
    (files, errors) = Checker.typeNames(SourceText(None, ProgramProject, "import $pkg.*\n"), tree)
    inPackage = files.filter { f -> f.file.package == pkg.split(".") && f.file.source.path.getOrElse("").startsWith("$root/") }
    inPackage.map { f -> "# ${f.file.source.path.getOrElse("")}\n" + lines(f.types) }.joinToString("") +
      (if (errors.isEmpty()) "" else "# $pkg\n" + problems(errors)) + written(rest, beside)
  }
  else -> ""
}

@FileSystem core(): List<(List<String>, List<SourceText>)> = packagesIn(path("src/main/resources/std"), [], CoreProject, "core:")

@FileSystem standard(): List<(List<String>, List<SourceText>)> =
  packagesIn(path("std/src"), [], OtherProject(path("std/src").canonical().value), "std/src/")

lines(resolved: List<ResolvedType>): String =
  resolved.sortedBy { r -> (r.written.at.line, r.written.at.column) }.mapNotNull { described(it) }.map { "$it\n" }.joinToString("")

problems(errors: List<Diagnostic>): String = errors.map { e -> "error ${e.file.getOrElse("-")} ${at(e.at)} ${e.message}\n" }.joinToString("")

// What a name means, if it's a declared type or a spec.
described(r: ResolvedType): Option<String> = when (r.meaning) {
  DeclaredType(symbol) -> Some("${at(r.written.at)} ${r.written.name} ${symbol.name}")
  SpecModuleType(spec) -> Some("${at(r.written.at)} ${r.written.name} module ${spec.name}")
  else -> None
}

at(p: Position): String = "${p.line}:${p.column}"

// Each package under the folder, its own path given, with its files, named as positions name them:
// the prefix, then the file's path under the folder.
@FileSystem packagesIn(folder: Path, pkg: List<String>, project: Project, prefix: String): List<(List<String>, List<SourceText>)> = {
  entries = folder.listFiles().sortedBy { it.name }
  files = entries.filter { it.extension == "fk" && !it.isDirectory() }.map { f ->
    SourceText(Some(prefix + (pkg + [f.name]).joinToString("/")), project, f.readText())
  }
  inner = entries.filter { it.isDirectory() && isPackageName(it.name) }.flatMap { d -> packagesIn(d, pkg + [d.name], project, prefix) }
  [(pkg, files), *inner]
}

// A folder named as a value is, which is a package: geometry, not Geometry or my-shapes.
isPackageName(name: String): Boolean = when (name.toList()) {
  [first, *rest] -> (first.isLowerCase() || first == '_') && rest.all { it.isLetterOrDigit() || it == '_' }
  [] -> false
}

// The packages, those of the same path together, in order.
merged(packages: List<(List<String>, List<SourceText>)>): Map<List<String>, List<SourceText>> =
  packages.fold(emptyMap()) { m, entry ->
    (pkg, files) = entry
    m.put(pkg, m.getOrDefault(pkg, []) + files)
  }
