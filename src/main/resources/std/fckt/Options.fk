// Option as a monad: Options { x by half(n); y by half(x); y } stops at the first None.
module Options {
  type M<A> = Option<A>

  pure<A>(x: A): Option<A> = Some(x)

  bind<A, B>(m: Option<A>, f: (A) -> Option<B>): Option<B> = when (m) {
    Some(x) -> f(x)
    None -> None
  }

  map<A, B>(m: Option<A>, f: (A) -> B): Option<B> = when (m) {
    Some(x) -> Some(f(x))
    None -> None
  }

  product<A, B>(ma: Option<A>, mb: Option<B>): Option<(A, B)> = when (ma, mb) {
    (Some(a), Some(b)) -> Some((a, b))
    else -> None
  }
}
