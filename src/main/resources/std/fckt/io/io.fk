// Files, folders and other programs: import fckt.io.*. Each is an effect, so main does them for
// real, and a test can answer them itself, with files in memory or programs that don't run.

// A file or a program's output, open to read a line or some characters at a time: see reading.
external type InputHandle = "in_channel"

// A file open to write to: see writing.
external type OutputHandle = "out_channel"

// What a program ended with: the code it exited with, 0 if it worked, and what it gave.
type Exit<A>(code: Int, value: A)

// Reads and writes files and folders. A path is relative to the folder the program runs in. What
// can't be done, such as reading a file that isn't there, fails with why: readFile and the others
// below fail where they're called, and the operations give a Result, for a handler to answer.
@Fail @HandledBy(LocalFiles) effect FileSystem {
  tryReadFile(path: String): Result<String, String>
  tryWriteFile(path: String, text: String, append: Boolean): Result<Unit, String>
  exists(path: String): Boolean
  isDirectory(path: String): Boolean
  tryListFiles(path: String): Result<List<String>, String>
  tryMakeDirs(path: String): Result<Unit, String>
  tryDelete(path: String): Result<Unit, String>
  tryOpenForReading(path: String): Result<InputHandle, String>
  tryOpenForWriting(path: String, append: Boolean): Result<OutputHandle, String>
  // The next line, without its end, or None at the end.
  readLineFrom(input: InputHandle): Option<String>
  // Up to count characters, or "" at the end; all that's left if count is below 0.
  readFrom(input: InputHandle, count: Int): String
  writeTo(output: OutputHandle, text: String): Unit
  closeInput(input: InputHandle): Unit
  closeOutput(output: OutputHandle): Unit
}

// Runs other programs, and reads the environment.
@Fail @HandledBy(LocalProcesses) effect Process {
  // Starts command with args, without a shell, with what it prints, and its errors, to read.
  tryStart(command: String, args: List<String>): Result<InputHandle, String>
  // Waits for the program started with output to end, and gives its exit code.
  waitFor(output: InputHandle): Int
  env(name: String): Option<String>
}

@FileSystem readFile(path: String): String = orFail(tryReadFile(path))
@FileSystem writeFile(path: String, text: String): Unit = orFail(tryWriteFile(path, text, false))
@FileSystem appendFile(path: String, text: String): Unit = orFail(tryWriteFile(path, text, true))
// The names of what's in a folder, in order.
@FileSystem listFiles(path: String): List<String> = orFail(tryListFiles(path))
// Makes a folder, and those it's in, if they aren't there.
@FileSystem makeDirs(path: String): Unit = orFail(tryMakeDirs(path))
// Deletes a file, or a folder and everything in it, if it's there.
@FileSystem delete(path: String): Unit = orFail(tryDelete(path))

private @Fail orFail<A>(result: Result<A, String>): A = when (result) {
  Ok(value) -> value
  Error(reason) -> fail(reason)
}

// What reading reads from, a line or some characters at a time.
effect Reader {
  nextLine(): Option<String>
  nextChars(count: Int): String
}

// What writing writes to.
effect Writer {
  write(text: String): Unit
}

// Writes text and a line's end.
@Writer writeLine(text: String) = write("$text\n")

// Each line that's left, in order.
@Reader forEachLine(f: (String) -> Unit): Unit = when (nextLine()) {
  Some(line) -> {
    f(line)
    forEachLine(f)
  }
  None -> Unit
}

// The lines that are left.
@Reader remainingLines(): List<String> = when (nextLine()) {
  Some(line) -> [line, *remainingLines()]
  None -> []
}

// Runs body with the file at path to read, a line or some characters at a time, and closes it
// after, even if body fails. Only body can read it, so nothing reads it once it's closed.
@FileSystem reading<A>(path: String, body: @Reader () -> A): A = {
  input = orFail(tryOpenForReading(path))
  readAll(input, body)
}

// Runs body with the file at path to write to, from the start or, with append, after what's
// there, and closes it after, even if body fails.
@FileSystem writing<A>(path: String, append: Boolean = false, body: @Writer () -> A): A = {
  output = orFail(tryOpenForWriting(path, append))
  result = attempt { Writer(write = text -> writeTo(output, text)) { body() } }
  closeOutput(output)
  when (result) {
    Ok(value) -> value
    Error(reason) -> fail(reason)
  }
}

// Runs command with args, and body as it prints, a line at a time: so what it prints can be shown
// as it happens. Its errors come in with what it prints.
@Process @FileSystem streaming<A>(command: String, args: List<String>, body: @Reader () -> A): Exit<A> = {
  output = orFail(tryStart(command, args))
  result = attempt { readThrough(output, body) }
  code = waitFor(output)
  when (result) {
    Ok(value) -> Exit(code, value)
    Error(reason) -> fail(reason)
  }
}

// Runs command with args to the end: its exit code, and everything it printed.
@Process @FileSystem run(command: String, args: List<String>): Exit<String> =
  streaming(command, args) { nextChars(-1) }

// The lines of the file at path.
@FileSystem readLines(path: String): List<String> = reading(path) { remainingLines() }

private @FileSystem readThrough<A>(input: InputHandle, body: @Reader () -> A): A =
  Reader(nextLine = ~readLineFrom(input), nextChars = count -> readFrom(input, count)) { body() }

private @FileSystem readAll<A>(input: InputHandle, body: @Reader () -> A): A = {
  result = attempt { readThrough(input, body) }
  closeInput(input)
  when (result) {
    Ok(value) -> value
    Error(reason) -> fail(reason)
  }
}

// The files and folders of the machine the program runs on, which main uses.
module LocalFiles : FileSystem {
  tryReadFile(path: String) = read(path)
  tryWriteFile(path: String, text: String, append: Boolean) = write(path, text, append)
  exists(path: String) = fileExists(path)
  isDirectory(path: String) = directory(path)
  tryListFiles(path: String) = list(path)
  tryMakeDirs(path: String) = mkdirs(path)
  tryDelete(path: String) = remove(path)
  tryOpenForReading(path: String) = openIn(path)
  tryOpenForWriting(path: String, append: Boolean) = openOut(path, append)
  readLineFrom(input: InputHandle) = inputLine(input)
  readFrom(input: InputHandle, count: Int) = inputChars(input, count)
  writeTo(output: OutputHandle, text: String) = outputString(output, text)
  closeInput(input: InputHandle) = closeIn(input)
  closeOutput(output: OutputHandle) = closeOut(output)

  private external read(path: String): Result<String, String> =
    "(fun p -> try Ok (In_channel.with_open_bin p In_channel.input_all) with Sys_error e -> Error e) path"
  private external write(path: String, text: String, append: Boolean): Result<Unit, String> =
    "(fun p t a -> try Ok (Out_channel.with_open_gen (Open_wronly :: Open_creat :: Open_binary :: (if a then [Open_append] else [Open_trunc])) 0o644 p (fun c -> Out_channel.output_string c t)) with Sys_error e -> Error e) path text append"
  private external fileExists(path: String): Boolean = "Sys.file_exists path"
  private external directory(path: String): Boolean = "(fun p -> Sys.file_exists p && Sys.is_directory p) path"
  private external list(path: String): Result<List<String>, String> =
    "(fun p -> try Ok (List.sort compare (Array.to_list (Sys.readdir p))) with Sys_error e -> Error e) path"
  private external mkdirs(path: String): Result<Unit, String> =
    "(let rec mk p = if not (Sys.file_exists p) then (let d = Filename.dirname p in if d <> p then mk d; Sys.mkdir p 0o755) in fun p -> try Ok (mk p) with Sys_error e -> Error e) path"
  private external remove(path: String): Result<Unit, String> =
    "(let rec rm p = if Sys.is_directory p then (Array.iter (fun n -> rm (Filename.concat p n)) (Sys.readdir p); Sys.rmdir p) else Sys.remove p in fun p -> try Ok (if Sys.file_exists p then rm p) with Sys_error e -> Error e) path"
  private external openIn(path: String): Result<InputHandle, String> =
    "(fun p -> try Ok (open_in_bin p) with Sys_error e -> Error e) path"
  private external openOut(path: String, append: Boolean): Result<OutputHandle, String> =
    "(fun p a -> try Ok (open_out_gen (Open_wronly :: Open_creat :: Open_binary :: (if a then [Open_append] else [Open_trunc])) 0o644 p) with Sys_error e -> Error e) path append"
  private external inputLine(input: InputHandle): Option<String> = "In_channel.input_line input"
  private external inputChars(input: InputHandle, count: Int): String =
    "(fun c n -> if n < 0 then In_channel.input_all c else match In_channel.really_input_string c n with Some s -> s | None -> In_channel.input_all c) input count"
  private external outputString(output: OutputHandle, text: String): Unit = "Out_channel.output_string output text"
  private external closeIn(input: InputHandle): Unit = "In_channel.close input"
  private external closeOut(output: OutputHandle): Unit = "Out_channel.close output"
}

// The programs of the machine the program runs on, which main uses.
module LocalProcesses : Process {
  tryStart(command: String, args: List<String>) = open(command, args)
  waitFor(output: InputHandle) = close(output)
  env(name: String) = getenv(name)

  private external open(command: String, args: List<String>): Result<InputHandle, String> =
    "(fun c a -> try Ok (Unix.open_process_in (Filename.quote_command c a ^ \" 2>&1\")) with Unix.Unix_error (e, _, _) -> Error (Unix.error_message e)) command args"
  private external close(output: InputHandle): Int =
    "(fun c -> match Unix.close_process_in c with Unix.WEXITED n -> n | Unix.WSIGNALED n | Unix.WSTOPPED n -> 128 + n) output"
  private external getenv(name: String): Option<String> = "Sys.getenv_opt name"
}
