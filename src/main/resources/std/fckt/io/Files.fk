import fckt.io.Channels.*

// Reading and writing files and folders, through @FileSystem.
module Files {
  @FileSystem readFile(path: String): String = orFail(tryReadFile(path))
  @FileSystem writeFile(path: String, text: String): Unit = orFail(tryWriteFile(path, text, false))
  @FileSystem appendFile(path: String, text: String): Unit = orFail(tryWriteFile(path, text, true))
  // The names of what's in a folder, in order.
  @FileSystem listFiles(path: String): List<String> = orFail(tryListFiles(path))
  // Makes a folder, and those it's in, if they aren't there.
  @FileSystem makeDirs(path: String): Unit = orFail(tryMakeDirs(path))
  // Deletes a file, or a folder and everything in it, if it's there.
  @FileSystem delete(path: String): Unit = orFail(tryDelete(path))

  // Runs body with the file at path to read, a line or some characters at a time, and closes it
  // after, even if body fails. Only body can read it, so nothing reads it once it's closed.
  @FileSystem reading<A>(path: String, body: @Reader () -> A): A = readingAll(orFail(tryOpenForReading(path)), body)

  // Runs body with the file at path to write to, from the start or, with append, after what's
  // there, and closes it after, even if body fails.
  @FileSystem writing<A>(path: String, append: Boolean = false, body: @Writer () -> A): A =
    writingAll(orFail(tryOpenForWriting(path, append)), body)

  // The lines of the file at path.
  @FileSystem readLines(path: String): List<String> = reading(path) { remainingLines() }

  private @Fail orFail<A>(result: Result<A, String>): A = when (result) {
    Ok(value) -> value
    Error(reason) -> fail(reason)
  }

  // The files and folders of the machine the program runs on, which main uses.
  module Local : FileSystem {
    tryReadFile(path: String) = read(path)
    tryWriteFile(path: String, text: String, append: Boolean) = write(path, text, append)
    exists(path: String) = fileExists(path)
    isDirectory(path: String) = directory(path)
    tryListFiles(path: String) = list(path)
    tryMakeDirs(path: String) = mkdirs(path)
    tryDelete(path: String) = remove(path)
    tryOpenForReading(path: String) = openIn(path)
    tryOpenForWriting(path: String, append: Boolean) = openOut(path, append)

    private external read(path: String): Result<String, String> =
      "(fun p -> try Ok (In_channel.with_open_bin p In_channel.input_all) with Sys_error e -> Error e) path"
    private external write(path: String, text: String, append: Boolean): Result<Unit, String> =
      "(fun p t a -> try Ok (Out_channel.with_open_gen (Open_wronly :: Open_creat :: Open_binary :: (if a then [Open_append] else [Open_trunc])) 0o644 p (fun c -> Out_channel.output_string c t)) with Sys_error e -> Error e) path text append"
    private external fileExists(path: String): Boolean = "Sys.file_exists path"
    private external directory(path: String): Boolean = "(fun p -> Sys.file_exists p && Sys.is_directory p) path"
    private external list(path: String): Result<List<String>, String> =
      "(fun p -> try Ok (List.sort compare (Array.to_list (Sys.readdir p))) with Sys_error e -> Error e) path"
    private external mkdirs(path: String): Result<Unit, String> =
      "(let rec mk p = if not (Sys.file_exists p) then (let d = Filename.dirname p in if d <> p then mk d; Sys.mkdir p 0o755) in fun p -> try Ok (mk p) with Sys_error e -> Error e) path"
    private external remove(path: String): Result<Unit, String> =
      "(let rec rm p = if Sys.is_directory p then (Array.iter (fun n -> rm (Filename.concat p n)) (Sys.readdir p); Sys.rmdir p) else Sys.remove p in fun p -> try Ok (if Sys.file_exists p then rm p) with Sys_error e -> Error e) path"
    private external openIn(path: String): Result<InputHandle, String> =
      "(fun p -> try Ok (open_in_bin p) with Sys_error e -> Error e) path"
    private external openOut(path: String, append: Boolean): Result<OutputHandle, String> =
      "(fun p a -> try Ok (open_out_gen (Open_wronly :: Open_creat :: Open_binary :: (if a then [Open_append] else [Open_trunc])) 0o644 p) with Sys_error e -> Error e) path append"
  }
}
