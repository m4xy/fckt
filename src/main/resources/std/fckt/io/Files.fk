import fckt.io.Channels.*
import fckt.io.Paths.*
import fckt.text.Bytes
import fckt.text.Encodings.*
import fckt.time.Instant

// Reading and writing files and folders, through @FileSystem: path.readText(),
// path.writeText(text), dir.listFiles() and the rest.
module Files {
  // The file's text, as UTF-8: bytes that aren't are replaced by U+FFFD.
  @FileSystem Path.readText(): String = this.readBytes().decodeToString()
  @FileSystem Path.readBytes(): Bytes = orFail(tryReadBytes(this))
  // The file's lines, without their ends.
  @FileSystem Path.readLines(): List<String> = this.reading { remainingLines() }

  // Writes the file, from the start, making it if it isn't there.
  @FileSystem Path.writeText(text: String): Unit = this.writeBytes(text.encodeToBytes())
  @FileSystem Path.writeBytes(bytes: Bytes): Unit = orFail(tryWriteBytes(this, bytes, false))
  // Writes after what's in the file, making it if it isn't there.
  @FileSystem Path.appendText(text: String): Unit = this.appendBytes(text.encodeToBytes())
  @FileSystem Path.appendBytes(bytes: Bytes): Unit = orFail(tryWriteBytes(this, bytes, true))

  @FileSystem Path.exists(): Boolean = exists(this)
  @FileSystem Path.isDirectory(): Boolean = isDirectory(this)
  // What's in the folder, in order of name.
  @FileSystem Path.listFiles(): List<Path> = orFail(tryListFiles(this))
  // Makes the folder, and those it's in, if they aren't there.
  @FileSystem Path.makeDirs(): Unit = orFail(tryMakeDirs(this))
  // Deletes the file, or the folder and everything in it, if it's there.
  @FileSystem Path.delete(): Unit = orFail(tryDelete(this))
  // Copies the file to target, a little at a time.
  @FileSystem Path.copyTo(target: Path): Unit = orFail(tryCopy(this, target))

  // When the file was last changed.
  @FileSystem Path.lastModified(): Instant = orFail(tryLastModified(this))
  // Where the file really is: its path from the root, with links followed. An installed program is
  // often a link to where it is.
  @FileSystem Path.canonical(): Path = orFail(tryCanonical(this))
  // Makes folder the one relative paths are from.
  @FileSystem changeDirectory(folder: Path): Unit = orFail(tryChangeDirectory(folder))

  // Copies the folder and everything in it to target, which it makes; or the file, as copyTo.
  @FileSystem Path.copyRecursively(target: Path): Unit = if (this.isDirectory()) {
    target.makeDirs()
    this.listFiles().forEach { it.copyRecursively(target.resolve(it.name)) }
  } else {
    this.copyTo(target)
  }

  // Runs body with the file to read, a line or some bytes at a time, and closes it after, even if
  // body fails. Only body can read it, so nothing reads it once it's closed.
  @FileSystem Path.reading<A>(body: @Reader () -> A): A = readingAll(orFail(tryOpenForReading(this)), body)

  // Runs body with the file to write to, from the start, and closes it after, even if body fails.
  @FileSystem Path.writing<A>(body: @Writer () -> A): A = writingAll(orFail(tryOpenForWriting(this, false)), body)

  // Runs body with the file to write to, after what's in it.
  @FileSystem Path.appending<A>(body: @Writer () -> A): A = writingAll(orFail(tryOpenForWriting(this, true)), body)

  private @Fail orFail<A>(result: Result<A, String>): A = when (result) {
    Ok(value) -> value
    Error(reason) -> fail(reason)
  }

  // The files and folders of the machine the program runs on, which main uses.
  module Local : FileSystem {
    tryReadBytes(path: Path) = read(path.value)
    tryWriteBytes(path: Path, bytes: Bytes, append: Boolean) = write(path.value, bytes, append)
    tryCopy(source: Path, target: Path) = copy(source.value, target.value)
    exists(path: Path) = fileExists(path.value)
    isDirectory(path: Path) = directory(path.value)
    tryListFiles(path: Path) = list(path.value).map { names -> names.map { path.resolve(it) } }
    tryMakeDirs(path: Path) = mkdirs(path.value)
    tryDelete(path: Path) = remove(path.value)
    tryOpenForReading(path: Path) = openIn(path.value)
    tryOpenForWriting(path: Path, append: Boolean) = openOut(path.value, append)
    tryLastModified(path: Path) = modified(path.value).map { Instant(it) }
    tryCanonical(path: Path) = realPath(path.value).map { it.toPath() }
    workingDirectory() = currentDirectory(Unit).toPath()
    tryChangeDirectory(path: Path) = changeTo(path.value)

    private external read(path: String): Result<Bytes, String> =
      "(fun p -> try Ok (In_channel.with_open_bin p In_channel.input_all) with Sys_error e -> Error e) path"
    private external write(path: String, bytes: Bytes, append: Boolean): Result<Unit, String> =
      "(fun p t a -> try Ok (Out_channel.with_open_gen (Open_wronly :: Open_creat :: Open_binary :: (if a then [Open_append] else [Open_trunc])) 0o644 p (fun c -> Out_channel.output_string c t)) with Sys_error e -> Error e) path bytes append"
    // As cp does, with what may be done with it: a program stays one.
    private external copy(source: String, target: String): Result<Unit, String> =
      "(fun a b -> try Ok (In_channel.with_open_bin a (fun ic -> Out_channel.with_open_bin b (fun oc -> let buf = Bytes.create 65536 in let rec go () = let n = In_channel.input ic buf 0 65536 in if n > 0 then (Out_channel.output oc buf 0 n; go ()) in go ())); Unix.chmod b (Unix.stat a).Unix.st_perm) with Sys_error e | Unix.Unix_error (_, _, e) -> Error e) source target"
    private external fileExists(path: String): Boolean = "Sys.file_exists path"
    private external directory(path: String): Boolean = "(fun p -> Sys.file_exists p && Sys.is_directory p) path"
    private external list(path: String): Result<List<String>, String> =
      "(fun p -> try Ok (List.sort compare (Array.to_list (Sys.readdir p))) with Sys_error e -> Error e) path"
    private external mkdirs(path: String): Result<Unit, String> =
      "(let rec mk p = if not (Sys.file_exists p) then (let d = Filename.dirname p in if d <> p then mk d; Sys.mkdir p 0o755) in fun p -> try Ok (mk p) with Sys_error e -> Error e) path"
    private external remove(path: String): Result<Unit, String> =
      "(let rec rm p = if Sys.is_directory p then (Array.iter (fun n -> rm (Filename.concat p n)) (Sys.readdir p); Sys.rmdir p) else Sys.remove p in fun p -> try Ok (if Sys.file_exists p then rm p) with Sys_error e -> Error e) path"
    private external openIn(path: String): Result<InputHandle, String> =
      "(fun p -> try Ok (open_in_bin p) with Sys_error e -> Error e) path"
    private external openOut(path: String, append: Boolean): Result<OutputHandle, String> =
      "(fun p a -> try Ok (open_out_gen (Open_wronly :: Open_creat :: Open_binary :: (if a then [Open_append] else [Open_trunc])) 0o644 p) with Sys_error e -> Error e) path append"
    private external modified(path: String): Result<Int, String> =
      "(fun p -> try Ok (int_of_float ((Unix.stat p).Unix.st_mtime *. 1000.)) with Unix.Unix_error (e, _, _) -> Error (p ^ \": \" ^ Unix.error_message e)) path"
    private external realPath(path: String): Result<String, String> =
      "(fun p -> try Ok (Unix.realpath p) with Unix.Unix_error (e, _, _) -> Error (p ^ \": \" ^ Unix.error_message e)) path"
    private external currentDirectory(u: Unit): String = "(fun _ -> Sys.getcwd ()) u"
    private external changeTo(path: String): Result<Unit, String> = "(fun p -> try Ok (Sys.chdir p) with Sys_error e -> Error e) path"
  }
}
