// Methods on Result. Imported into every file; Result as a monad is fckt.monads.Results.
module Results {
  external Result<A, E>.map<B>(f: (A) -> B): Result<B, E> = "Result.map f this"
  external Result<A, E>.mapError<F>(f: (E) -> F): Result<A, F> = "Result.map_error f this"
  external Result<A, E>.flatMap<B>(f: (A) -> Result<B, E>): Result<B, E> = "Result.bind this f"
  external Result<A, E>.getOrElse(default: A): A = "Result.value this ~default"
  external Result<A, E>.isOk(): Boolean = "Result.is_ok this"
  external Result<A, E>.isError(): Boolean = "Result.is_error this"
  external Result<A, E>.toOption(): Option<A> = "Result.to_option this"
}
