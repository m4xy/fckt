import fckt.io.Path
import fckt.io.Paths.*

// What a project is: its name and version, and where its code is. A build.fk at the project's
// root makes one, project = Project(name = "shop"), and fckt build, test or run builds it.
type Project(
  name: String,
  version: String = "0.1.0",
  // The program's file, with its main.
  main: Path = path("src/main.fk"),
  // The folders its packages are in.
  sources: List<Path> = [path("src")],
  // The folder of its tests: each file there with a main is a test, which fails if it does.
  tests: Path = path("test"),
  // Where what's built goes: the program is output/bin/name.
  output: Path = path("build"),
)
