import fckt.collections.Stream
import fckt.values.Lazies.*

// Values worked out one at a time, as they're asked for.
module Generators {
  // What block yields, as a Stream: block runs up to each yield as the stream is read that far.
  // sequence { yield(1); yield(2) } is 1, then 2.
  sequence<A>(block: @Yielding<A> () -> Unit): Stream<A> = Yielding(yield = (a, resume) -> Next(a, lazy(~resume(Unit)))) {
    block()
    End
  }
}
