// What strings and characters have: their methods. Imported into every file. A String is UTF-8, and its
// length, indices and characters count characters, Unicode code points, not bytes: "ü".length is 1.
// Counting them reads the string from the start, so s[i] takes longer the further in i is.
module Strings {
  // How many characters it has.
  external String.length: Int =
    "(fun s -> let rec go i n = if i >= String.length s then n else go (i + Uchar.utf_decode_length (String.get_utf_8_uchar s i)) (n + 1) in go 0 0) this"
  external String.isEmpty(): Boolean = "String.equal \"\" this"
  String.isBlank(): Boolean = this.trim().isEmpty()
  // Upper or lower case, of the letters A to Z.
  external String.uppercase(): String = "String.uppercase_ascii this"
  external String.lowercase(): String = "String.lowercase_ascii this"
  external String.trim(): String = "String.trim this"
  external String.startsWith(prefix: String): Boolean = "String.starts_with ~prefix this"
  external String.endsWith(suffix: String): Boolean = "String.ends_with ~suffix this"
  external String.toInt(): Int = "int_of_string this"
  external String.toIntOrNone(): Option<Int> = "int_of_string_opt this"
  external String.toFloat(): Float = "float_of_string this"
  external String.toDouble(): Float = "float_of_string this"

  // Its characters, in order.
  external String.toList(): List<Char> =
    "(fun s -> let rec go i acc = if i >= String.length s then List.rev acc else let d = String.get_utf_8_uchar s i in go (i + Uchar.utf_decode_length d) (Uchar.to_int (Uchar.utf_decode_uchar d) :: acc) in go 0 []) this"
  // The character at index, or None if the string has none there.
  external String.getOrNone(index: Int): Option<Char> =
    "(fun s n -> let rec at i n = if n <= 0 || i >= String.length s then i else at (i + Uchar.utf_decode_length (String.get_utf_8_uchar s i)) (n - 1) in let i = at 0 n in if n < 0 || i >= String.length s then None else Some (Uchar.to_int (Uchar.utf_decode_uchar (String.get_utf_8_uchar s i)))) this index"
  // The characters from start up to, not including, endIndex.
  String.substring(start: Int, endIndex: Int): String = this.drop(start).take(endIndex - start)
  // The first n characters, or all of them if there are fewer; and the rest.
  external String.take(n: Int): String =
    "(fun s n -> let rec at i n = if n <= 0 || i >= String.length s then i else at (i + Uchar.utf_decode_length (String.get_utf_8_uchar s i)) (n - 1) in String.sub s 0 (at 0 n)) this n"
  external String.drop(n: Int): String =
    "(fun s n -> let rec at i n = if n <= 0 || i >= String.length s then i else at (i + Uchar.utf_decode_length (String.get_utf_8_uchar s i)) (n - 1) in let i = at 0 n in String.sub s i (String.length s - i)) this n"
  String.dropLast(n: Int): String = this.take(this.length - n)
  String.removePrefix(prefix: String): String = if (this.startsWith(prefix)) this.drop(prefix.length) else this
  String.removeSuffix(suffix: String): String = if (this.endsWith(suffix)) this.dropLast(suffix.length) else this

  // Where text first or last is, as a character's index, or -1 if it isn't.
  external String.indexOf(text: String): Int =
    "(fun s t -> let n = String.length s and m = String.length t in let rec find i = if i + m > n then -1 else if String.sub s i m = t then i else find (i + 1) in let rec count i k = if i >= k then 0 else 1 + count (i + Uchar.utf_decode_length (String.get_utf_8_uchar s i)) k in let i = find 0 in if i < 0 then -1 else count 0 i) this text"
  external String.lastIndexOf(text: String): Int =
    "(fun s t -> let n = String.length s and m = String.length t in let rec find i = if i < 0 then -1 else if String.sub s i m = t then i else find (i - 1) in let rec count i k = if i >= k then 0 else 1 + count (i + Uchar.utf_decode_length (String.get_utf_8_uchar s i)) k in let i = find (n - m) in if i < 0 then -1 else count 0 i) this text"
  String.contains(text: String): Boolean = this.indexOf(text) >= 0
  // The pieces between each separator.
  external String.split(separator: String): List<String> =
    "(fun s t -> let n = String.length s and m = String.length t in if m = 0 then [s] else let rec go start i acc = if i + m > n then List.rev (String.sub s start (n - start) :: acc) else if String.sub s i m = t then go (i + m) (i + m) (String.sub s start (i - start) :: acc) else go start (i + 1) acc in go 0 0 []) this separator"
  // What's before or after the last delimiter, or all of it if there's none.
  String.substringBeforeLast(delimiter: String): String = {
    i = this.lastIndexOf(delimiter)
    if (i < 0) this else this.take(i)
  }
  String.substringAfterLast(delimiter: String): String = {
    i = this.lastIndexOf(delimiter)
    if (i < 0) this else this.drop(i + delimiter.length)
  }
  // What's before or after the first delimiter, or all of it if there's none.
  String.substringBefore(delimiter: String): String = {
    i = this.indexOf(delimiter)
    if (i < 0) this else this.take(i)
  }
  String.substringAfter(delimiter: String): String = {
    i = this.indexOf(delimiter)
    if (i < 0) this else this.drop(i + delimiter.length)
  }

  String.isNotEmpty(): Boolean = !this.isEmpty()
  String.isNotBlank(): Boolean = !this.isBlank()
  // It with each old replaced by new, from the start; an empty old replaces nothing.
  String.replace(old: String, new: String): String = this.split(old).joinToString(new)
  // Its lines, split at "\n" or "\r\n".
  String.lines(): List<String> = this.split("\n").map { it.removeSuffix("\r") }
  // It n times over.
  String.repeat(n: Int): String = if (n <= 0) "" else this + this.repeat(n - 1)
  // Its characters backwards.
  String.reversed(): String = this.toList().reversed().map { it.toString() }.joinToString("")
  // Without the whitespace at its start, or its end.
  String.trimStart(): String = this.drop(this.toList().takeWhile { it.isWhitespace() }.size)
  String.trimEnd(): String = this.dropLast(this.toList().reversed().takeWhile { it.isWhitespace() }.size)
  // It at least length characters long, with padding before it, or after it.
  String.padStart(length: Int, padding: Char = ' '): String = padding.toString().repeat(length - this.length) + this
  String.padEnd(length: Int, padding: Char = ' '): String = this + padding.toString().repeat(length - this.length)

  // The character's code point: 'a'.code is 97.
  external Char.code: Int = "Fun.id this"
  // The character with that code point.
  external Int.toChar(): Char = "(fun n -> Uchar.to_int (Uchar.of_int n)) this"
  Char.isDigit(): Boolean = this >= '0' && this <= '9'
  // The characters from this to last, by code point, last among them: 'a'..'e' is [a, b, c, d, e].
  operator Char.rangeTo(last: Char): List<Char> = (this.code..last.code).map { it.toChar() }
  // Whether it's a letter: A to Z, a to z, or a letter of another alphabet or script, Latin's
  // accented ones, Greek, Cyrillic, Hebrew, Arabic, Devanagari, Thai, Georgian, Hangul, kana and CJK
  // among them. Not punctuation, symbols, digits or spaces, such as an em dash or a currency sign.
  Char.isLetter(): Boolean =
    (this >= 'a' && this <= 'z') || (this >= 'A' && this <= 'Z') || (this.code > 127 && letters.any { from, to -> this.code >= from && this.code <= to })
  Char.isLetterOrDigit(): Boolean = this.isLetter() || this.isDigit()
  Char.isWhitespace(): Boolean = this == ' ' || this == '\t' || this == '\n' || this == '\r' || this.code == 160 || this.code == 8232 || this.code == 8233
  // Upper or lower case, of the letters A to Z.
  Char.uppercase(): Char = if (this >= 'a' && this <= 'z') (this.code - 32).toChar() else this
  Char.lowercase(): Char = if (this >= 'A' && this <= 'Z') (this.code + 32).toChar() else this
  // Whether it's one of the letters A to Z, or a to z.
  Char.isUpperCase(): Boolean = this >= 'A' && this <= 'Z'
  Char.isLowerCase(): Boolean = this >= 'a' && this <= 'z'

  // The letters past U+007F, as ranges of code points, first and last.
  private letters: List<(Int, Int)> = [
    (170, 170), (181, 181), (186, 186), (192, 214), (216, 246), (248, 705), (710, 721), (736, 740),
    (748, 748), (750, 750), (880, 884), (886, 887), (890, 893), (895, 895), (902, 902), (904, 906),
    (908, 908), (910, 929), (931, 1013), (1015, 1153), (1162, 1327), (1329, 1366), (1376, 1416), (1488, 1514),
    (1519, 1522), (1568, 1610), (1646, 1647), (1649, 1747), (1749, 1749), (1765, 1766), (1774, 1775), (1786, 1788),
    (1791, 1791), (2308, 2361), (2365, 2365), (2384, 2384), (2392, 2401), (2417, 2432), (3585, 3632), (3634, 3635),
    (3648, 3654), (4256, 4293), (4304, 4346), (4348, 4351), (4352, 4607), (7680, 7957), (7960, 7965), (7968, 8005),
    (8008, 8013), (8016, 8023), (8025, 8025), (8027, 8027), (8029, 8029), (8031, 8061), (8064, 8116), (8118, 8124),
    (8126, 8126), (8130, 8132), (8134, 8140), (8144, 8147), (8150, 8155), (8160, 8172), (8178, 8180), (8182, 8188),
    (8305, 8305), (8319, 8319), (8336, 8348), (11264, 11492), (12353, 12438), (12445, 12447), (12449, 12538), (12540, 12543),
    (12549, 12591), (12593, 12686), (13312, 19903), (19968, 40959), (40960, 42124), (44032, 55203), (63744, 64255), (64256, 64262),
    (65313, 65338), (65345, 65370), (65382, 65500), (131072, 195103),
  ]
}
