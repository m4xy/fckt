// Numbers. Imported into every file.
module Maths {
  // The byte with the number's low eight bits: 0 to 255, so 256.toByte() is 0 and -1.toByte() is 255.
  external Int.toByte(): Byte = "(fun n -> Char.unsafe_chr (n land 255)) this"
  // The byte as a number, 0 to 255.
  external Byte.toInt(): Int = "Char.code this"
  external Int.toFloat(): Float = "float_of_int this"
  external Int.toDouble(): Float = "float_of_int this"
  external Int.coerceAtLeast(minimumValue: Int): Int = "max this minimumValue"
  external Int.coerceAtMost(maximumValue: Int): Int = "min this maximumValue"
  external Float.toInt(): Int = "int_of_float this"

  // The whole numbers from this to last, last among them: 1..3 is [1, 2, 3], and 3..1 is [].
  operator Int.rangeTo(last: Int): List<Int> = this.rangeUntil(last + 1)
  // The whole numbers from this up to end, but not end: 0..<3 is [0, 1, 2], so 0..<xs.size is xs' indexes.
  operator external Int.rangeUntil(end: Int): List<Int> = "(fun from e -> List.init (max 0 (e - from)) (fun i -> from + i)) this end"
  // The whole numbers from this down to last, last among them: 3.downTo(1) is [3, 2, 1].
  Int.downTo(last: Int): List<Int> = (last..this).reversed()

  external max<A>(a: A, b: A): A = "max a b"
  external min<A>(a: A, b: A): A = "min a b"
  external abs(x: Int): Int = "abs x"
  external sin(x: Float): Float = "sin x"
  external cos(x: Float): Float = "cos x"
  external tan(x: Float): Float = "tan x"
  external asin(x: Float): Float = "asin x"
  external acos(x: Float): Float = "acos x"
  external atan(x: Float): Float = "atan x"
  external atan2(y: Float, x: Float): Float = "atan2 y x"
  external sqrt(x: Float): Float = "sqrt x"
  external exp(x: Float): Float = "exp x"
  external log(x: Float): Float = "log x"
  external floor(x: Float): Float = "floor x"
  external ceil(x: Float): Float = "ceil x"
}
