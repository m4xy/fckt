// What lists have: their methods. Imported into every file.
module Lists {
  external List<A>.size: Int = "List.length this"
  external List<A>.isEmpty(): Boolean = "List.is_empty this"
  external List<A>.map<B>(f: (A) -> B): List<B> = "List.map f this"
  external List<A>.filter(f: (A) -> Boolean): List<A> = "List.filter f this"
  external List<A>.flatMap<B>(f: (A) -> List<B>): List<B> = "List.concat_map f this"
  external List<A>.fold<B>(initial: B, f: (B, A) -> B): B = "List.fold_left f initial this"
  external List<A>.forEach(f: (A) -> Unit): Unit = "List.iter f this"
  external List<A>.any(f: (A) -> Boolean): Boolean = "List.exists f this"
  external List<A>.all(f: (A) -> Boolean): Boolean = "List.for_all f this"
  external List<A>.find(f: (A) -> Boolean): Option<A> = "List.find_opt f this"
  external List<A>.contains(x: A): Boolean = "List.mem x this"
  external List<A>.reversed(): List<A> = "List.rev this"
  external List<A>.plus(other: List<A>): List<A> = "List.append this other"
  external List<A>.firstOrNone(): Option<A> = "List.nth_opt this 0"
  external List<Int>.sum(): Int = "List.fold_left ( + ) 0 this"
  external List<Float>.sum(): Float = "List.fold_left ( +. ) 0. this"

  external List<A>.take(n: Int): List<A> = "List.take n this"
  external List<A>.drop(n: Int): List<A> = "List.drop n this"
  external List<A>.mapIndexed<B>(f: (Int, A) -> B): List<B> = "List.mapi f this"
  external List<A>.sortedWith(comparison: (A, A) -> Int): List<A> = "List.stable_sort comparison this"
  List<A>.lastOrNone(): Option<A> = this.reversed().firstOrNone()
  List<A>.getOrNone(index: Int): Option<A> = if (index < 0) None else this.drop(index).firstOrNone()
  // Its one item, if it has exactly one.
  List<A>.singleOrNone(): Option<A> = when (this) {
    [a] -> Some(a)
    else -> None
  }
  List<A>.count(f: (A) -> Boolean): Int = this.filter(f).size
  List<A>.withIndex(): List<(Int, A)> = this.mapIndexed { i, a -> (i, a) }

  // The items before the first that doesn't pass, and those from it on.
  List<A>.takeWhile(f: (A) -> Boolean): List<A> = when (this) {
    [a, *rest] -> if (f(a)) [a, *rest.takeWhile(f)] else []
    [] -> []
  }
  List<A>.dropWhile(f: (A) -> Boolean): List<A> = when (this) {
    [a, *rest] -> if (f(a)) rest.dropWhile(f) else this
    [] -> []
  }

  // Where x first is, or -1 if it isn't.
  List<A>.indexOf(x: A): Int = when (this) {
    [a, *rest] -> if (a == x) 0 else {
      i = rest.indexOf(x)
      if (i < 0) -1 else i + 1
    }
    [] -> -1
  }

  // Pairs of items in the same place, as long as the shorter list.
  List<A>.zip<B>(other: List<B>): List<(A, B)> = when (this, other) {
    ([a, *xs], [b, *ys]) -> [(a, b), *xs.zip(ys)]
    else -> []
  }


  // Each item once, where it first appears.
  List<A>.distinct(): List<A> = this.distinctBy { it }

  // Each item whose key no item before it has, where it appears: sorted by key, then by where each
  // was, so that items with the same key are together with the first of them first; the first of
  // each kept; then put back in the order they were. Only keys are compared, so items needn't be.
  List<A>.distinctBy<K>(key: (A) -> K): List<A> = {
    byKey = this.withIndex().map { i, a -> (key(a), i, a) }.sortedWith { x, y ->
      (k, i, _) = x
      (l, j, _) = y
      compareValues((k, i), (l, j))
    }
    firsts = byKey.fold([]) { kept, entry ->
      (k, _, _) = entry
      when (kept) {
        [(l, _, _), *_] -> if (k == l) kept else [entry, *kept]
        [] -> [entry]
      }
    }
    firsts.sortedWith { x, y ->
      (_, i, _) = x
      (_, j, _) = y
      compareValues(i, j)
    }.map { _, _, a -> a }
  }

  // Smallest first, comparing values as they're built: numbers by size, text by its bytes, and
  // tuples and records field by field, in order. Values of a type with cases are in an order of
  // their own, which is the same each time, but isn't the order the cases are declared in.
  List<A>.sorted(): List<A> = this.sortedWith(compareValues)
  List<A>.sortedBy<K>(key: (A) -> K): List<A> = this.sortedWith { a, b -> compareValues(key(a), key(b)) }
  List<A>.sortedDescending(): List<A> = this.sorted().reversed()

  // Below 0 if a comes first, 0 if they're equal, above 0 if b does.
  external compareValues<A>(a: A, b: A): Int = "compare a b"

  List<A>.isNotEmpty(): Boolean = !this.isEmpty()
  // Whether no item passes.
  List<A>.none(f: (A) -> Boolean): Boolean = !this.any(f)
  List<A>.filterNot(f: (A) -> Boolean): List<A> = this.filter { !f(it) }
  // What f gives for each item, where it gives something.
  List<A>.mapNotNull<B>(f: (A) -> Option<B>): List<B> = this.flatMap { a ->
    when (f(a)) {
      Some(b) -> [b]
      None -> []
    }
  }
  List<List<A>>.flatten(): List<A> = this.flatMap { it }
  external List<A>.forEachIndexed(f: (Int, A) -> Unit): Unit = "List.iteri f this"
  List<A>.sumOf(f: (A) -> Int): Int = this.map(f).sum()

  // The last n items, or all of them if there are fewer; and all but those.
  List<A>.takeLast(n: Int): List<A> = this.drop(this.size - n)
  List<A>.dropLast(n: Int): List<A> = this.take(this.size - n)

  // Where the first item that passes is, or -1 if none does.
  List<A>.indexOfFirst(f: (A) -> Boolean): Int = when (this) {
    [a, *rest] -> if (f(a)) 0 else {
      i = rest.indexOfFirst(f)
      if (i < 0) -1 else i + 1
    }
    [] -> -1
  }

  // The items that pass, and those that don't, each in order.
  List<A>.partition(f: (A) -> Boolean): (List<A>, List<A>) = (this.filter(f), this.filterNot(f))

  // The items in lists of size, the last maybe shorter.
  List<A>.chunked(size: Int): List<List<A>> = if (this.isEmpty() || size <= 0) [] else [this.take(size), *this.drop(size).chunked(size)]

  // Each item with the one after it.
  List<A>.zipWithNext(): List<(A, A)> = this.zip(this.drop(1))

  // The firsts of the pairs, and the seconds.
  external List<(A, B)>.unzip(): (List<A>, List<B>) = "List.split this"

  // The smallest or largest item, or the one with the smallest or largest key, if there are any;
  // the first, of those that tie.
  List<A>.minOrNone(): Option<A> = this.minByOrNone { it }
  List<A>.maxOrNone(): Option<A> = this.maxByOrNone { it }
  List<A>.minByOrNone<K>(key: (A) -> K): Option<A> = this.bestBy(key) { a, b -> compareValues(a, b) < 0 }
  List<A>.maxByOrNone<K>(key: (A) -> K): Option<A> = this.bestBy(key) { a, b -> compareValues(a, b) > 0 }

  // The item whose key beats every other's, in one pass: the first, of those that tie.
  private List<A>.bestBy<K>(key: (A) -> K, beats: (K, K) -> Boolean): Option<A> = when (this) {
    [] -> None
    [a, *rest] -> Some(rest.fold((a, key(a))) { best, b ->
      (_, bestKey) = best
      k = key(b)
      if (beats(k, bestKey)) (b, k) else best
    }).map { best, _ -> best }
  }
  List<A>.sortedByDescending<K>(key: (A) -> K): List<A> = this.sortedWith { a, b -> compareValues(key(b), key(a)) }

  // [(key, value), ...].lookup(key): the value of the first pair with that key.
  external List<(K, V)>.lookup(key: K): Option<V> = "List.assoc_opt key this"
}
