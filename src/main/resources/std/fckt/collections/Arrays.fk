import fckt.collections.Array

// Making and using arrays. Changing one is @Mutating on the array, so an array made and changed
// inside a function leaves it pure.
module Arrays {
  external arrayOf<A>(size: Int, value: A): Array<A> = "Array.make size value"
  external List<A>.toArray(): Array<A> = "Array.of_list this"
  external Array<A>.size: Int = "Array.length this"
  external Array<A>.get(index: Int): A = "Array.get this index"
  @Mutating external Array<A>.set(index: Int, value: A): Unit = "Array.set this index value"
  external Array<A>.toList(): List<A> = "Array.to_list this"
}
