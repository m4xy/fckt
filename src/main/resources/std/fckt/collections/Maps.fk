// Kotlin's maps: keys, each with a value. Imported into every file. A map never changes: put and
// remove make another, sharing what they can, as kotlinx.collections.immutable's do. Its keys are in
// order, smallest first, by OCaml's ordering of values, the one sorted() uses.
module Maps {
  // A tree of the keys in order, each node's priority, the hash of its key, above its children's,
  // so the same entries make the same tree however they were put in: two maps with the same
  // entries are equal. size counts a node's entries.
  opaque type Map<K, V> {
    MapTip,
    MapNode(left: Map<K, V>, key: K, value: V, right: Map<K, V>, size: Int, priority: Int),
  }

  private external hashOf<K>(key: K): Int = "Hashtbl.hash key"

  private node<K, V>(left: Map<K, V>, key: K, value: V, right: Map<K, V>): Map<K, V> =
    MapNode(left, key, value, right, left.size + 1 + right.size, hashOf(key))

  // Whether a node with key a and priority p goes above one with key b and priority q: the higher
  // priority does, or of two the same, the smaller key.
  private above<K>(p: Int, a: K, q: Int, b: K): Boolean = p > q || (p == q && compareValues(a, b) < 0)

  // A map with nothing in it; with the entries in the list, the last of any with the same key.
  emptyMap<K, V>(): Map<K, V> = MapTip
  mapOf<K, V>(entries: List<(K, V)>): Map<K, V> = entries.fold(emptyMap()) { m, entry ->
    (k, v) = entry
    m.put(k, v)
  }
  List<(K, V)>.toMap(): Map<K, V> = mapOf(this)

  // How many entries it has.
  Map<K, V>.size: Int = when (this) {
    MapTip -> 0
    MapNode(_, _, _, _, n, _) -> n
  }
  Map<K, V>.isEmpty(): Boolean = this.size == 0
  Map<K, V>.isNotEmpty(): Boolean = this.size > 0

  // The value of key, if it has one: m[key].
  Map<K, V>.get(key: K): Option<V> = when (this) {
    MapTip -> None
    MapNode(l, k, v, r, _, _) -> {
      c = compareValues(key, k)
      if (c < 0) l.get(key) else if (c > 0) r.get(key) else Some(v)
    }
  }
  Map<K, V>.getOrElse(key: K, default: () -> V): V = when (this.get(key)) {
    Some(v) -> v
    None -> default()
  }
  Map<K, V>.getOrDefault(key: K, default: V): V = this.getOrElse(key) { default }
  Map<K, V>.containsKey(key: K): Boolean = this.get(key) != None

  // It with key's value value, in place of any it had.
  Map<K, V>.put(key: K, value: V): Map<K, V> = when (this) {
    MapTip -> node(MapTip, key, value, MapTip)
    MapNode(l, k, v, r, _, p) -> {
      c = compareValues(key, k)
      if (c == 0) {
        node(l, k, value, r)
      } else if (c < 0) {
        // The new node rises above this one if it should: a right rotation, or a left one.
        put = l.put(key, value)
        when (put) {
          MapNode(ll, lk, lv, lr, _, lp) -> if (above(lp, lk, p, k)) node(ll, lk, lv, node(lr, k, v, r)) else node(put, k, v, r)
          MapTip -> this
        }
      } else {
        put = r.put(key, value)
        when (put) {
          MapNode(rl, rk, rv, rr, _, rp) -> if (above(rp, rk, p, k)) node(node(l, k, v, rl), rk, rv, rr) else node(l, k, v, put)
          MapTip -> this
        }
      }
    }
  }
  // It with each of other's entries put in, in place of its own for the same key. Whichever root
  // goes above stays the root, and the other map is split around its key: so it's in the time of
  // the smaller map's size, times the log of the larger's.
  Map<K, V>.putAll(other: Map<K, V>): Map<K, V> = when (this, other) {
    (MapTip, _) -> other
    (_, MapTip) -> this
    (MapNode(l, k, v, r, _, p), MapNode(ol, ok, ov, orr, _, op)) ->
      if (above(p, k, op, ok)) {
        (below, found, beyond) = other.split(k)
        node(l.putAll(below), k, found.getOrElse(v), r.putAll(beyond))
      } else {
        (below, _, beyond) = this.split(ok)
        node(below.putAll(ol), ok, ov, beyond.putAll(orr))
      }
  }
  // Its entries whose keys other has, or doesn't, whatever other's values are.
  Map<K, V>.intersectKeys<W>(other: Map<K, W>): Map<K, V> = when (this, other) {
    (MapTip, _) -> MapTip
    (_, MapTip) -> MapTip
    (MapNode(l, k, v, r, _, _), _) -> {
      (below, found, beyond) = other.split(k)
      left = l.intersectKeys(below)
      right = r.intersectKeys(beyond)
      if (found.isSome()) node(left, k, v, right) else joined(left, right)
    }
  }
  Map<K, V>.subtractKeys<W>(other: Map<K, W>): Map<K, V> = when (this, other) {
    (MapTip, _) -> MapTip
    (_, MapTip) -> this
    (_, MapNode(ol, ok, _, orr, _, _)) -> {
      (below, _, beyond) = this.split(ok)
      joined(below.subtractKeys(ol), beyond.subtractKeys(orr))
    }
  }

  // The entries below key, its value if it has one, and the entries above it.
  private Map<K, V>.split(key: K): (Map<K, V>, Option<V>, Map<K, V>) = when (this) {
    MapTip -> (MapTip, None, MapTip)
    MapNode(l, k, v, r, _, _) -> {
      c = compareValues(key, k)
      if (c == 0) {
        (l, Some(v), r)
      } else if (c < 0) {
        (below, found, beyond) = l.split(key)
        (below, found, node(beyond, k, v, r))
      } else {
        (below, found, beyond) = r.split(key)
        (node(l, k, v, below), found, beyond)
      }
    }
  }
  // It without key, and its value.
  Map<K, V>.remove(key: K): Map<K, V> = when (this) {
    MapTip -> this
    MapNode(l, k, v, r, _, _) -> {
      c = compareValues(key, k)
      if (c < 0) node(l.remove(key), k, v, r) else if (c > 0) node(l, k, v, r.remove(key)) else joined(l, r)
    }
  }

  // The entries of left, then right, whose keys are all larger.
  private joined<K, V>(left: Map<K, V>, right: Map<K, V>): Map<K, V> = when (left, right) {
    (MapTip, _) -> right
    (_, MapTip) -> left
    (MapNode(ll, lk, lv, lr, _, lp), MapNode(rl, rk, rv, rr, _, rp)) ->
      if (above(lp, lk, rp, rk)) node(ll, lk, lv, joined(lr, right)) else node(joined(left, rl), rk, rv, rr)
  }

  // Its entries, keys and values, in the keys' order.
  Map<K, V>.entries: List<(K, V)> = this.foldRight([]) { k, v, rest -> [(k, v), *rest] }
  Map<K, V>.keys: List<K> = this.foldRight([]) { k, _, rest -> [k, *rest] }
  Map<K, V>.values: List<V> = this.foldRight([]) { _, v, rest -> [v, *rest] }
  Map<K, V>.toList(): List<(K, V)> = this.entries

  private Map<K, V>.foldRight<R>(initial: R, f: (K, V, R) -> R): R = when (this) {
    MapTip -> initial
    MapNode(l, k, v, r, _, _) -> l.foldRight(f(k, v, r.foldRight(initial, f)), f)
  }

  // Of its entries, in the keys' order, through the tree: any stops at the first that passes.
  Map<K, V>.forEach(f: (K, V) -> Unit): Unit = when (this) {
    MapTip -> Unit
    MapNode(l, k, v, r, _, _) -> {
      l.forEach(f)
      f(k, v)
      r.forEach(f)
    }
  }
  Map<K, V>.any(f: (K, V) -> Boolean): Boolean = when (this) {
    MapTip -> false
    MapNode(l, k, v, r, _, _) -> l.any(f) || f(k, v) || r.any(f)
  }
  Map<K, V>.all(f: (K, V) -> Boolean): Boolean = !this.any { k, v -> !f(k, v) }
  Map<K, V>.count(f: (K, V) -> Boolean): Int = when (this) {
    MapTip -> 0
    MapNode(l, k, v, r, _, _) -> {
      before = l.count(f)
      here = if (f(k, v)) 1 else 0
      before + here + r.count(f)
    }
  }
  // The entries that pass: those kept keep their places, and where one isn't, its sides are joined.
  Map<K, V>.filter(f: (K, V) -> Boolean): Map<K, V> = when (this) {
    MapTip -> MapTip
    MapNode(l, k, v, r, _, _) -> {
      left = l.filter(f)
      keep = f(k, v)
      right = r.filter(f)
      if (keep) node(left, k, v, right) else joined(left, right)
    }
  }
  Map<K, V>.filterKeys(f: (K) -> Boolean): Map<K, V> = this.filter { k, _ -> f(k) }
  Map<K, V>.filterValues(f: (V) -> Boolean): Map<K, V> = this.filter { _, v -> f(v) }
  // Each value made into another, for the same key.
  Map<K, V>.mapValues<W>(f: (K, V) -> W): Map<K, W> = when (this) {
    MapTip -> MapTip
    MapNode(l, k, v, r, n, p) -> MapNode(l.mapValues(f), k, f(k, v), r.mapValues(f), n, p)
  }
  // Each key made into another; of keys that become the same, the last's value.
  Map<K, V>.mapKeys<J>(f: (K, V) -> J): Map<J, V> = this.entries.map { k, v -> (f(k, v), v) }.toMap()
  // What f makes of each entry, in the keys' order.
  Map<K, V>.map<R>(f: (K, V) -> R): List<R> = this.entries.map { k, v -> f(k, v) }

  // As Kotlin shows a map: {a=1, b=2}.
  Map<K, V>.toString(showKey: (K) -> String, showValue: (V) -> String): String =
    "{" + this.map { k, v -> showKey(k) + "=" + showValue(v) }.joinToString(", ") + "}"

  // The items by key, each key's in order.
  List<A>.groupBy<K>(key: (A) -> K): Map<K, List<A>> =
    this.reversed().fold(emptyMap()) { m, a -> m.put(key(a), [a, *m.getOrElse(key(a)) { [] }]) }
  // Each item by its key, or with its value; of items with the same key, the last.
  List<A>.associateBy<K>(key: (A) -> K): Map<K, A> = this.map { (key(it), it) }.toMap()
  List<A>.associateWith<V>(value: (A) -> V): Map<A, V> = this.map { (it, value(it)) }.toMap()
  List<A>.associate<K, V>(entry: (A) -> (K, V)): Map<K, V> = this.map(entry).toMap()
}
